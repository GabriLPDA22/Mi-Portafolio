---
/**
 * Layout raíz: metadatos SEO por idioma (con hreflang), fuentes autoalojadas, cabecera,
 * banner de cookies y un único script ligero (sin frameworks en el cliente).
 */
import { Font } from 'astro:assets';
import '@/styles/globals.css';
import Header from '@/components/Header.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import GameLayer from '@/components/GameLayer.astro';
import { UMAMI_DOMAINS, UMAMI_WEBSITE_ID } from '@/lib/analytics';
import { localePath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  /** Ruta sin prefijo de idioma ("/", "/privacidad"…). */
  path?: string;
  /** Título de la página; se completa con " | Gabriel Saiz" salvo en la portada. */
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const siteUrl = 'https://gabrielcodes.dev';
const meta = {
  es: {
    // Lo que buscan las empresas: rol + tecnologías + ciudad (≤ 60 caracteres el título, ≤ 155 la descripción)
    title: 'Gabriel Saiz | Desarrollador Full-Stack .NET y Vue en Zaragoza',
    ogTitle: 'Gabriel Saiz — Desarrollador Full-Stack .NET y Vue',
    description:
      'Desarrollador full-stack en Zaragoza: backend C# y .NET, webs con Vue y Astro y apps React Native en App Store. Disponible en Zaragoza o en remoto.',
    ogLocale: 'es_ES',
    ogAlt: 'Gabriel Saiz — Desarrollador full-stack',
    siteName: 'Gabriel Saiz — Portfolio',
  },
  en: {
    title: 'Gabriel Saiz | Full-Stack Developer (.NET, Vue) – Spain & Remote',
    ogTitle: 'Gabriel Saiz — Full-Stack Developer (.NET, Vue)',
    description:
      'Full-stack developer in Zaragoza, Spain: C# and .NET backend, Vue and Astro websites and React Native apps on the App Store. Available on-site or remote.',
    ogLocale: 'en_GB',
    ogAlt: 'Gabriel Saiz — Full-stack developer',
    siteName: 'Gabriel Saiz — Portfolio',
  },
};

const { locale, path = '/', title, description, noindex = false, jsonLd } = Astro.props;
const m = meta[locale];
const fullTitle = title ? `${title} | Gabriel Saiz` : m.title;
const desc = description ?? m.description;
// Título para redes: el de la página si tiene uno propio (legales, 404); si no, el de la portada
const socialTitle = title ? fullTitle : m.ogTitle;
const url = (l: Locale) => {
  const p = localePath(l, path);
  return p === '/' ? siteUrl : `${siteUrl}${p}`;
};
const canonical = url(locale);
// Imagen al compartir (LinkedIn, WhatsApp, Slack…): una por idioma, generada con scripts/og-image.mjs
const ogImage = `${siteUrl}/img/og-image${locale === 'en' ? '-en' : ''}.jpg`;
const keywords = [
  'desarrollador full stack Zaragoza',
  'desarrollador .NET Zaragoza',
  'programador .NET',
  'desarrollador C#',
  'programador C# Zaragoza',
  'desarrollador Vue',
  'desarrollador Astro',
  'desarrollador React Native',
  'desarrollador web Zaragoza',
  'desarrollador full stack remoto',
  'full stack developer Spain',
  '.NET developer remote',
  'Gabriel Saiz',
].join(',');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Gabriel Saiz" />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <>
          <meta name="robots" content="index, follow" />
          <meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1" />
        </>
      )
    }
    <link rel="canonical" href={canonical} />
    {
      // La 404 no tiene versión en inglés (/en/404 no existe)
      path !== '/404' && (
        <>
          <link rel="alternate" hreflang="es" href={url('es')} />
          <link rel="alternate" hreflang="en" href={url('en')} />
          <link rel="alternate" hreflang="x-default" href={url('es')} />
        </>
      )
    }
    <meta name="google-site-verification" content="tl7fbd-SUdovbuPNFSkybxDcu_TQs9maMuc0x9ar04c" />
    <meta name="theme-color" content="#0c0c0f" />
    <meta name="color-scheme" content="dark" />

    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-tiny" />

    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={m.ogLocale} />
    <meta property="og:locale:alternate" content={meta[locale === 'es' ? 'en' : 'es'].ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={m.siteName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={m.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    {UMAMI_WEBSITE_ID && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_WEBSITE_ID} data-domains={UMAMI_DOMAINS} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body class="min-h-screen max-w-[100vw] overflow-x-clip antialiased">
    <!-- Primer elemento con Tab: salta la navegación (solo visible al recibir el foco) -->
    <a
      href="#main-content"
      class="sr-only text-[14px] font-semibold focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-xl focus:bg-violet-light focus:px-4 focus:py-2 focus:text-bg"
    >
      {locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <Header locale={locale} path={path} />
    <slot />
    <CookieBanner locale={locale} />
    <GameLayer locale={locale} />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
