---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import { site, absoluteUrl } from '@/config/site';
import { normalizePath } from '@/lib/url';
import { buildGraph, breadcrumbSchema, webPageSchema, type Crumb } from '@/lib/schema';

interface Props {
  /** Etiqueta <title> completa. Objetivo: 50–60 caracteres con la keyword principal al inicio. */
  title: string;
  /** Meta description única. Objetivo: 140–160 caracteres con propuesta de valor + CTA. */
  description: string;
  /** Imagen Open Graph (ruta absoluta desde /public). 1200×630. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** Migas de pan sin incluir "Inicio" (se añade automáticamente). */
  breadcrumbs?: Crumb[];
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  /** Nodos JSON-LD específicos de la página (Service, FAQPage…). */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = site.ogImage,
  imageAlt = 'GabrielCodes — Diseño web profesional para negocios en Zaragoza',
  noindex = false,
  breadcrumbs = [],
  pageType = 'WebPage',
  schema = [],
} = Astro.props;

const path = normalizePath(Astro.url.pathname);
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(image);

const crumbs: Crumb[] = [{ name: 'Inicio', path: '/' }, ...breadcrumbs];
const graph = noindex
  ? null
  : buildGraph([
      webPageSchema({ path, title, description, type: pageType }),
      ...(breadcrumbs.length ? [breadcrumbSchema(crumbs)] : []),
      ...schema,
    ]);
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

    <Font cssVariable="--font-inter" preload />

    <meta name="theme-color" content="#09090B" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="author" content={site.founder.name} />
    <meta name="geo.region" content="ES-Z" />
    <meta name="geo.placename" content="Zaragoza" />
    <meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
    <meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {graph && <script is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />}
    <slot name="head" />
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-accent-ink"
      >Saltar al contenido</a
    >
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <CookieConsent />
  </body>
</html>
