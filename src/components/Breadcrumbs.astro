---
import type { Crumb } from '@/lib/schema';
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const all = [{ name: 'Inicio', path: '/' }, ...items];
---

<nav aria-label="Migas de pan" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      all.map((c, i) => (
        <li class="inline-flex items-center gap-2">
          {i > 0 && <span aria-hidden="true" class="text-white/25">/</span>}
          {i === all.length - 1 ? (
            <span aria-current="page" class="text-soft">{c.name}</span>
          ) : (
            <a href={c.path} class="hover:text-fg">
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
