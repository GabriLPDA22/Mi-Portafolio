---
import Icon from './Icon.astro';
import { getT, localePath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getT(locale).cookies;
---

<!-- Oculto por defecto: el script lo muestra solo si no hay preferencia guardada. -->
<div
  data-cookie-banner
  hidden
  role="region"
  aria-label={locale === 'es' ? 'Aviso de cookies' : 'Cookie notice'}
  class="glass fixed inset-x-3 bottom-3 z-[45] translate-y-6 rounded-3xl border border-white/10 p-4 opacity-0 shadow-[0_20px_60px_-20px_rgba(0,0,0,.9)] transition-all duration-500 ease-[cubic-bezier(.16,1,.3,1)] sm:inset-x-auto sm:bottom-6 sm:left-6 sm:max-w-md sm:p-5 [&.is-in]:translate-y-0 [&.is-in]:opacity-100"
>
  <div class="flex items-start gap-3">
    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-acid/10 text-acid"><Icon name="Cookie" class="h-4 w-4" /></span>
    <div class="min-w-0">
      <p class="text-[13px] leading-relaxed text-ink/75">{c.message}</p>
      <p class="mt-1.5 text-[12px] text-ink/50">
        {c.moreInfo}{' '}
        <a href={localePath(locale, '/privacidad')} class="text-acid underline underline-offset-2 hover:text-acid-light">{c.privacyPolicy}</a>
      </p>
    </div>
  </div>
  <div class="mt-4 flex items-center justify-end gap-2">
    <button type="button" data-consent="rejected" class="rounded-full px-4 py-2 text-[13px] font-medium text-ink/65 transition-colors hover:text-ink">
      {c.reject}
    </button>
    <button type="button" data-consent="accepted" class="rounded-full bg-ink px-5 py-2 text-[13px] font-semibold text-noir transition-colors hover:bg-acid">
      {c.accept}
    </button>
  </div>
</div>
