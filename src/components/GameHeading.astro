---
/**
 * Cabecera de sección estilo videojuego: chip HUD "NIVEL 0X · …", título con contorno y
 * sombra dorada que entra letra a letra, y entradilla opcional.
 */
import SplitTitle from './SplitTitle.astro';

interface Props {
  level: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  /** Desplazamiento con el scroll (mismas variables que antes). */
  scrub?: Record<string, number>;
  class?: string;
}
const { level, eyebrow, title, subtitle, align = 'left', scrub, class: className = '' } = Astro.props;
const center = align === 'center';
---

<div
  class:list={['section-head-gsap mb-12 lg:mb-16', center ? 'text-center' : 'text-left', className]}
  data-scrub={scrub ? JSON.stringify(scrub) : undefined}
>
  <p class:list={['hud-chip', center && 'mx-auto']} data-reveal data-reveal-margin="-60px" style="--ry:12px">
    <span class="text-ink/70">{level}</span> · {eyebrow}
  </p>
  <h2 class:list={['game-title mt-5 text-[clamp(2.3rem,7vw,4.6rem)]', center ? '-rotate-1' : '-rotate-[1.5deg] origin-left']}>
    <SplitTitle text={title} class="pb-[0.2em] pr-[0.12em]" />
  </h2>
  {
    subtitle && (
      <p
        class:list={['mt-4 max-w-[36rem] text-[15px] leading-relaxed text-ink/70 xl:text-xl', center && 'mx-auto']}
        data-reveal
        data-reveal-margin="-60px"
        style="--ry:20px;--d:.15s"
      >
        {subtitle}
      </p>
    )
  }
  <slot />
</div>
