---
/**
 * Consentimiento de cookies (RGPD/LSSI). Google Analytics no se descarga hasta que el
 * usuario acepta: cumple la normativa y evita cargar JS de terceros en la primera visita,
 * lo que protege LCP e INP.
 */
import { site } from '@/config/site';
---

<div
  id="cookie-banner"
  class="fixed inset-x-3 bottom-3 z-50 hidden sm:inset-x-auto sm:left-6 sm:bottom-6 sm:max-w-md"
  role="dialog"
  aria-live="polite"
  aria-label="Preferencias de cookies"
  data-ga-id={site.analytics.gaId}
>
  <div class="card bg-ink-2/95 p-5 shadow-2xl shadow-black/70 backdrop-blur-xl">
    <p class="text-sm leading-relaxed text-soft">
      Usamos cookies analíticas para saber qué páginas son útiles y mejorar la web. Solo se activan si aceptas.
      <a href="/politica-cookies" class="text-accent underline underline-offset-4">Leer la política de cookies</a>.
    </p>
    <div class="mt-4 flex gap-2">
      <button type="button" class="h-10 flex-1 cursor-pointer rounded-full bg-accent px-4 text-sm font-semibold text-accent-ink hover:bg-white" data-consent="granted">
        Aceptar
      </button>
      <button type="button" class="h-10 flex-1 cursor-pointer rounded-full border border-line-strong px-4 text-sm font-semibold text-fg hover:bg-white/5" data-consent="denied">
        Rechazar
      </button>
    </div>
  </div>
</div>

<script>
  const KEY = 'gc-cookie-consent';
  const banner = document.getElementById('cookie-banner');
  const gaId = banner?.dataset.gaId;

  const read = (): string | null => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };

  const save = (value: string) => {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      /* navegación privada o almacenamiento bloqueado: se pregunta en la próxima visita */
    }
  };

  let gaLoaded = false;
  const loadAnalytics = () => {
    if (gaLoaded || !gaId) return;
    gaLoaded = true;
    const w = window as unknown as { dataLayer: unknown[]; gtag: (...args: unknown[]) => void };
    w.dataLayer = w.dataLayer || [];
    w.gtag = function gtag() {
      // gtag necesita el objeto `arguments` original
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer.push(arguments);
    };
    w.gtag('js', new Date());
    w.gtag('config', gaId, { anonymize_ip: true });
    const s = document.createElement('script');
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
    document.head.appendChild(s);
  };

  const show = () => banner?.classList.remove('hidden');
  const hide = () => banner?.classList.add('hidden');

  const consent = read();
  if (consent === 'granted') loadAnalytics();
  else if (consent === null) show();

  banner?.addEventListener('click', (e) => {
    const value = (e.target as HTMLElement).closest<HTMLElement>('[data-consent]')?.dataset.consent;
    if (!value) return;
    save(value);
    hide();
    if (value === 'granted') loadAnalytics();
  });

  document.querySelectorAll('[data-cookie-settings]').forEach((el) => el.addEventListener('click', show));

  // Medición de conversiones: clics en CTAs y WhatsApp (solo si GA está cargado).
  document.addEventListener('click', (e) => {
    const cta = (e.target as HTMLElement).closest<HTMLElement>('[data-cta]');
    const w = window as unknown as { gtag?: (...args: unknown[]) => void };
    if (cta && w.gtag) w.gtag('event', 'cta_click', { cta_id: cta.dataset.cta, link_url: cta.getAttribute('href') });
  });
</script>
