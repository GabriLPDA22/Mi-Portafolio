---
/**
 * Formulario de presupuesto procesado por Netlify Forms: Netlify detecta el formulario
 * en el HTML estático durante el despliegue, así que no hace falta backend ni JS para enviarlo.
 * Antispam: campo honeypot + reCAPTCHA opcional desde el panel de Netlify.
 */
import Icon from '@/components/ui/Icon.astro';
import { projectTypes, budgetRanges, sectors } from '@/data/services';

const field =
  'mt-2 block w-full rounded-xl border border-line-strong bg-ink px-4 py-3 text-base text-fg placeholder:text-white/35 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30';
const label = 'text-sm font-medium text-soft';
---

<form
  name="presupuesto"
  method="POST"
  action="/gracias"
  data-netlify="true"
  netlify-honeypot="empresa-web"
  class="grid gap-5 sm:grid-cols-2"
  data-budget-form
>
  <input type="hidden" name="form-name" value="presupuesto" />
  <p class="hidden" aria-hidden="true">
    <label>No rellenes este campo: <input name="empresa-web" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div>
    <label for="f-nombre" class={label}>Nombre <span class="text-accent" aria-hidden="true">*</span></label>
    <input id="f-nombre" name="nombre" type="text" required autocomplete="name" class={field} placeholder="Tu nombre" />
  </div>

  <div>
    <label for="f-empresa" class={label}>Empresa o negocio</label>
    <input id="f-empresa" name="empresa" type="text" autocomplete="organization" class={field} placeholder="Nombre de tu negocio" />
  </div>

  <div>
    <label for="f-email" class={label}>Email <span class="text-accent" aria-hidden="true">*</span></label>
    <input id="f-email" name="email" type="email" required autocomplete="email" inputmode="email" class={field} placeholder="tu@email.com" />
  </div>

  <div>
    <label for="f-telefono" class={label}>Teléfono <span class="font-normal text-muted">(opcional)</span></label>
    <input id="f-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" class={field} placeholder="600 000 000" />
  </div>

  <div>
    <label for="f-sector" class={label}>Sector</label>
    <select id="f-sector" name="sector" class:list={[field, 'select-chevron']}>
      <option value="">Selecciona tu sector</option>
      {sectors.map((s) => <option value={s}>{s}</option>)}
    </select>
  </div>

  <div>
    <label for="f-tipo" class={label}>Tipo de web <span class="text-accent" aria-hidden="true">*</span></label>
    <select id="f-tipo" name="tipo-de-web" required class:list={[field, 'select-chevron']}>
      <option value="">¿Qué necesitas?</option>
      {projectTypes.map((t) => <option value={t.value}>{t.label}</option>)}
    </select>
  </div>

  <div class="sm:col-span-2">
    <fieldset>
      <legend class={label}>Presupuesto aproximado</legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          budgetRanges.map((b, i) => (
            <label class="cursor-pointer">
              <input type="radio" name="presupuesto" value={b.value} class="peer sr-only" checked={i === budgetRanges.length - 1} />
              <span class="inline-flex rounded-full border border-line-strong px-4 py-2 text-sm text-soft transition-colors peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent peer-focus-visible:ring-2 peer-focus-visible:ring-accent hover:border-white/30">
                {b.label}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
  </div>

  <div class="sm:col-span-2">
    <label for="f-mensaje" class={label}>Cuéntanos tu proyecto</label>
    <textarea
      id="f-mensaje"
      name="mensaje"
      rows="5"
      class:list={[field, 'resize-y']}
      placeholder="¿A qué se dedica tu negocio? ¿Tienes web actualmente? ¿Qué te gustaría conseguir?"></textarea>
  </div>

  <div class="sm:col-span-2">
    <label class="flex items-start gap-3 text-sm leading-relaxed text-muted">
      <input type="checkbox" name="privacidad" value="acepto" required class="mt-1 size-4 shrink-0 accent-[#00E676]" />
      <span>
        He leído y acepto la <a href="/politica-privacidad" class="text-accent underline underline-offset-4">política de privacidad</a>. Usaremos tus datos solo para responder a tu solicitud.
      </span>
    </label>
  </div>

  <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
    <button
      type="submit"
      class="group inline-flex h-13 cursor-pointer items-center justify-center gap-2 rounded-full bg-accent px-8 text-base font-semibold text-accent-ink shadow-[0_8px_30px_-8px_rgb(0_230_118/0.55)] transition hover:bg-white disabled:cursor-wait disabled:opacity-70"
      data-cta="form-submit"
    >
      <span data-label>Solicitar presupuesto</span>
      <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
    </button>
    <p class="inline-flex items-center gap-2 text-sm text-muted">
      <Icon name="clock" class="size-4 text-accent" />
      Respuesta en menos de 24 h laborables
    </p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-budget-form]');
  if (form) {
    // Preselecciona el tipo de web cuando se llega desde una página de servicio (?servicio=landing-page).
    const servicio = new URLSearchParams(location.search).get('servicio');
    const select = form.querySelector<HTMLSelectElement>('select[name="tipo-de-web"]');
    if (servicio && select && [...select.options].some((o) => o.value === servicio)) select.value = servicio;

    // Evita envíos duplicados en conexiones lentas.
    form.addEventListener('submit', () => {
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const text = button?.querySelector('[data-label]');
      if (button && text) {
        button.disabled = true;
        text.textContent = 'Enviando…';
      }
    });
  }
</script>
