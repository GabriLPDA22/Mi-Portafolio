---
/**
 * Formulario de contacto enviado a Web3Forms, que reenvía cada mensaje por email.
 * Funciona sin JavaScript (POST nativo + redirección a /gracias). El email del remitente
 * llega como Reply-To. Antispam: casilla trampa `botcheck`.
 */
import Icon from '@/components/ui/Icon.astro';
import { site, absoluteUrl } from '@/config/site';

const field =
  'mt-2 block w-full rounded-2xl border border-line-strong bg-bg px-4 py-3.5 text-base text-fg placeholder:text-muted/70 transition-colors focus:border-accent focus:bg-card focus:outline-none focus:ring-4 focus:ring-accent/15';
const label = 'text-sm font-medium text-soft';
---

<form method="POST" action={site.forms.endpoint} accept-charset="UTF-8" class="grid gap-5 sm:grid-cols-2" data-contact-form>
  <input type="hidden" name="access_key" value={site.forms.web3formsKey} />
  <input type="hidden" name="subject" value="Nuevo mensaje desde gabrielcodes.dev" />
  <input type="hidden" name="from_name" value="Portfolio Gabriel Saiz" />
  <input type="hidden" name="redirect" value={absoluteUrl('/gracias')} />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div>
    <label for="f-nombre" class={label}>Nombre <span class="text-accent" aria-hidden="true">*</span></label>
    <input id="f-nombre" name="nombre" type="text" required autocomplete="name" class={field} placeholder="Tu nombre" />
  </div>

  <div>
    <label for="f-empresa" class={label}>Empresa</label>
    <input id="f-empresa" name="empresa" type="text" autocomplete="organization" class={field} placeholder="Nombre de la empresa" />
  </div>

  <div class="sm:col-span-2">
    <label for="f-email" class={label}>Email <span class="text-accent" aria-hidden="true">*</span></label>
    <input id="f-email" name="email" type="email" required autocomplete="email" inputmode="email" class={field} placeholder="tu@empresa.com" />
  </div>

  <div class="sm:col-span-2">
    <label for="f-mensaje" class={label}>Mensaje <span class="text-accent" aria-hidden="true">*</span></label>
    <textarea
      id="f-mensaje"
      name="mensaje"
      rows="5"
      required
      class:list={[field, 'resize-y']}
      placeholder="Cuéntame sobre el puesto, el equipo o el proyecto."></textarea>
  </div>

  <div class="sm:col-span-2">
    <label class="flex items-start gap-3 text-sm leading-relaxed text-muted">
      <input type="checkbox" name="privacidad" value="acepto" required class="mt-1 size-4 shrink-0 accent-[#2B3AFF]" />
      <span>
        Acepto la <a href="/politica-privacidad" class="text-accent underline underline-offset-4">política de privacidad</a>. Solo usaré tus datos para responderte.
      </span>
    </label>
  </div>

  <div class="sm:col-span-2">
    <button
      type="submit"
      class="group inline-flex h-13 w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-fg px-8 text-base font-semibold text-bg transition hover:bg-accent hover:text-accent-ink disabled:cursor-wait disabled:opacity-70 sm:w-auto"
      data-cta="form-submit"
    >
      <span data-label>Enviar mensaje</span>
      <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
    </button>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    // Web3Forms exige una URL absoluta de retorno: con JS se usa el dominio actual (útil en local).
    const redirect = form.querySelector<HTMLInputElement>('input[name="redirect"]');
    if (redirect) redirect.value = new URL('/gracias', location.origin).href;

    form.addEventListener('submit', () => {
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const text = button?.querySelector('[data-label]');
      if (button && text) {
        button.disabled = true;
        text.textContent = 'Enviando…';
      }
    });
  }
</script>
