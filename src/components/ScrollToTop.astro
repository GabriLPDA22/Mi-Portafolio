---
import Icon from './Icon.astro';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const label = Astro.props.locale === 'es' ? 'Volver arriba' : 'Back to top';
---

<button
  type="button"
  data-scroll-top
  aria-label={label}
  title={label}
  class="invisible fixed bottom-6 right-6 z-40 flex h-12 w-12 translate-y-5 scale-[0.8] items-center justify-center rounded-xl border-[3px] border-noir bg-acid text-noir opacity-0 shadow-[0_5px_0_#0a0706] transition-all duration-200 hover:bg-acid-light active:translate-y-1 active:shadow-[0_1px_0_#0a0706] sm:bottom-8 sm:right-8 [&.is-in]:visible [&.is-in]:translate-y-0 [&.is-in]:scale-100 [&.is-in]:opacity-100"
>
  <Icon name="ArrowUp" class="h-5 w-5" strokeWidth={3} />
</button>
