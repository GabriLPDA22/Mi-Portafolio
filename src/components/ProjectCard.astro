---
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import { getService } from '@/data/services';
import type { Project } from '@/data/projects';

interface Props {
  project: Project;
  /** Nivel de encabezado del nombre del proyecto según la jerarquía de la página. */
  headingLevel?: 'h2' | 'h3';
  detailed?: boolean;
}

const { project, headingLevel = 'h3', detailed = false } = Astro.props;
const Heading = headingLevel;
const service = getService(project.service);
---

<article class="reveal group card card-hover flex flex-col overflow-hidden">
  <div class="relative border-b border-line bg-ink-2 p-3 pb-0 sm:p-4 sm:pb-0">
    <div class="overflow-hidden rounded-t-xl border border-b-0 border-line-strong">
      <div class="flex items-center gap-1.5 bg-surface-2 px-3 py-2" aria-hidden="true">
        <span class="size-2 rounded-full bg-white/15"></span>
        <span class="size-2 rounded-full bg-white/15"></span>
        <span class="size-2 rounded-full bg-white/15"></span>
      </div>
      <Picture
        src={project.image}
        alt={project.imageAlt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 560px, (min-width: 640px) 50vw, 100vw"
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full object-cover object-top transition-transform duration-700 ease-(--ease-out-expo) group-hover:scale-[1.03]"
      />
    </div>
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full border border-line px-2.5 py-1 text-soft">{project.sector}</span>
      <span class="rounded-full border border-line px-2.5 py-1 text-soft">{service.name}</span>
      {
        project.kind === 'cliente' ? (
          <span class="rounded-full bg-accent/15 px-2.5 py-1 font-medium text-accent">Cliente · en producción</span>
        ) : (
          <span class="rounded-full bg-white/5 px-2.5 py-1 text-muted">Proyecto demostrativo</span>
        )
      }
    </div>
    <Heading class="mt-5 text-xl font-semibold text-fg">{project.name}</Heading>
    {
      detailed ? (
        <dl class="mt-4 grid gap-4 text-sm leading-relaxed">
          <div>
            <dt class="font-medium text-soft">El reto</dt>
            <dd class="mt-1 text-muted">{project.challenge}</dd>
          </div>
          <div>
            <dt class="font-medium text-soft">La solución</dt>
            <dd class="mt-1 text-muted">{project.solution}</dd>
          </div>
        </dl>
      ) : (
        <p class="mt-3 text-sm leading-relaxed text-muted">{project.solution}</p>
      )
    }
    <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs text-soft">
      {
        project.highlights.map((h) => (
          <li class="inline-flex items-center gap-1.5">
            <Icon name="check" class="size-3.5 text-accent" />
            {h}
          </li>
        ))
      }
    </ul>
    {
      project.url && (
        <a
          href={project.url}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-1.5 self-start text-sm font-medium text-accent hover:underline hover:underline-offset-4"
        >
          Ver web en directo<span class="sr-only"> de {project.name}</span>
          <Icon name="arrowUpRight" class="size-4" />
        </a>
      )
    }
  </div>
</article>
