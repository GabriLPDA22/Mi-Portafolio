---
/**
 * Piezas de la capa "videojuego" que viven en el layout: pantalla de carga (portada),
 * aviso de logro desbloqueado y cortinilla pixel de PRESS START.
 */
import PixelLoader from './PixelLoader.astro';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
  /** Mostrar la pantalla de carga (solo portada). */
  boot?: boolean;
}
const { locale, boot = false } = Astro.props;
const es = locale === 'es';

const achievements = es
  ? [
      { id: 'start', title: 'Partida iniciada', desc: 'Has pulsado START' },
      { id: 'explorer', title: 'Explorador', desc: 'Has visto los proyectos' },
      { id: 'cv', title: 'Reclutador pro', desc: 'CV descargado' },
      { id: 'friend', title: 'Amigo del monigote', desc: '5 saludos a Gabriel' },
      { id: 'boss', title: 'Jefe final', desc: 'Has llegado al contacto' },
      { id: 'konami', title: 'Modo arcade', desc: 'Has encontrado BUG RUN' },
      { id: 'bughunter', title: 'Cazabugs', desc: '300 puntos en BUG RUN' },
    ]
  : [
      { id: 'start', title: 'Game started', desc: 'You pressed START' },
      { id: 'explorer', title: 'Explorer', desc: 'You checked the projects' },
      { id: 'cv', title: 'Pro recruiter', desc: 'CV downloaded' },
      { id: 'friend', title: "Mascot's buddy", desc: '5 hellos to Gabriel' },
      { id: 'boss', title: 'Final boss', desc: 'You reached the contact form' },
      { id: 'konami', title: 'Arcade mode', desc: 'You found BUG RUN' },
      { id: 'bughunter', title: 'Bug hunter', desc: '300 points in BUG RUN' },
    ];
const arcade = es
  ? {
      title: 'BUG RUN',
      start: 'Salta para empezar',
      over: 'GAME OVER',
      retry: 'Salta para reintentar',
      score: 'Puntos',
      best: 'Récord',
      close: 'Salir',
      hint: 'Espacio, ↑ o toca para saltar los bugs',
      top: 'Ranking global',
      name: 'Tu nombre',
      save: 'Guardar',
      saved: '¡Guardado! Puesto #{rank}',
      failed: 'No se pudo guardar la puntuación',
      empty: 'Aún no hay puntuaciones. ¡Sé el primero!',
      invalid: 'De 3 a 12 letras o números, sin espacios',
      rude: 'Ese nombre no está permitido. Prueba con otro',
      pause: 'PAUSA',
      resume: 'Salta para continuar',
      tabPlay: 'Jugar',
      tabRank: 'Ranking',
      tabHelp: 'Cómo jugar',
      sound: 'Sonido',
      on: 'Sí',
      off: 'No',
      page: 'Pág. {page}/{pages}',
      prev: 'Página anterior',
      next: 'Página siguiente',
      players: '{n} puntuaciones',
      worldBest: 'Récord mundial',
      loading: 'Cargando…',
      offline: 'El ranking no está disponible ahora mismo. Puedes seguir jugando.',
      help: [
        {
          title: 'Controles',
          items: [
            '<kbd>Espacio</kbd>, <kbd>↑</kbd> o toca la pantalla para saltar',
            '<kbd>M</kbd> activa o silencia el sonido',
            '<kbd>Esc</kbd> sale del juego',
          ],
        },
        {
          title: 'Reglas',
          items: [
            'Salta los bugs: si te toca uno, se acaba la partida',
            'Cada vez vas más rápido y a partir de 150 puntos salen bugs en pareja',
            'Cada 100 puntos suena la moneda',
          ],
        },
        {
          title: 'Ranking',
          items: [
            'Al terminar, escribe tu nombre (3-12 letras o números) y guarda la puntuación',
            'Ranking global con todas las partidas guardadas, 10 por página',
            'Juego limpio: cada partida se valida en el servidor y los nombres ofensivos se rechazan',
          ],
        },
      ],
    }
  : {
      title: 'BUG RUN',
      start: 'Jump to start',
      over: 'GAME OVER',
      retry: 'Jump to retry',
      score: 'Score',
      best: 'Best',
      close: 'Quit',
      hint: 'Space, ↑ or tap to jump the bugs',
      top: 'Global ranking',
      name: 'Your name',
      save: 'Save',
      saved: 'Saved! Rank #{rank}',
      failed: 'Could not save your score',
      empty: 'No scores yet. Be the first!',
      invalid: '3 to 12 letters or numbers, no spaces',
      rude: 'That name is not allowed. Try another one',
      pause: 'PAUSED',
      resume: 'Jump to continue',
      tabPlay: 'Play',
      tabRank: 'Ranking',
      tabHelp: 'How to play',
      sound: 'Sound',
      on: 'On',
      off: 'Off',
      page: 'Page {page}/{pages}',
      prev: 'Previous page',
      next: 'Next page',
      players: '{n} scores',
      worldBest: 'World record',
      loading: 'Loading…',
      offline: 'The ranking is not available right now. You can keep playing.',
      help: [
        {
          title: 'Controls',
          items: [
            '<kbd>Space</kbd>, <kbd>↑</kbd> or tap the screen to jump',
            '<kbd>M</kbd> toggles sound',
            '<kbd>Esc</kbd> quits the game',
          ],
        },
        {
          title: 'Rules',
          items: [
            'Jump over the bugs: touch one and the run is over',
            'You keep speeding up, and from 150 points bugs come in pairs',
            'Every 100 points the coin chimes',
          ],
        },
        {
          title: 'Ranking',
          items: [
            'When the run ends, enter your name (3-12 letters or numbers) and save your score',
            'Global ranking with every saved run, 10 per page',
            'Fair play: every run is validated on the server and offensive names are rejected',
          ],
        },
      ],
    };
const data = { achievements, arcade, unlocked: es ? 'Logro desbloqueado' : 'Achievement unlocked' };
---

<script is:inline type="application/json" id="game-data" set:html={JSON.stringify(data)} />

{
  boot && (
    <div data-boot class="boot" aria-hidden="true">
      <PixelLoader label={es ? 'Cargando partida' : 'Loading game'} size="h-[168px] sm:h-[210px]" once readyLabel={es ? '¡Listo!' : 'Ready!'} />
      <p class="boot-skip font-pixel">{es ? 'Pulsa cualquier tecla para saltar' : 'Press any key to skip'}</p>
    </div>
  )
}

<!-- Aviso de logro (arriba a la derecha, estilo consola) -->
<div data-achievement hidden class="achievement" role="status" aria-live="polite">
  <span class="achievement-icon" aria-hidden="true">🏆</span>
  <span class="flex min-w-0 flex-col">
    <span class="font-pixel text-[10px] uppercase tracking-wider text-acid">
      {data.unlocked} · <span data-ach-count></span>
    </span>
    <span data-ach-title class="truncate text-[15px] font-black text-ink"></span>
    <span data-ach-desc class="truncate text-[12px] text-ink/70"></span>
  </span>
</div>

<!-- Cortinilla pixel de PRESS START -->
<div data-wipe hidden class="wipe" aria-hidden="true"></div>

<style>
  /* Pantalla de carga: solo con JS y en la primera visita (clase no-boot desde <head>) */
  .boot {
    display: none;
  }
  :global(html.js:not(.no-boot)) .boot {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    background: #120e0b;
    cursor: pointer;
    /* red de seguridad: si el JS fallase, se quita sola */
    animation: boot-auto-out 0.4s steps(4) 3.4s forwards;
  }
  .boot.is-leaving {
    animation: boot-out 0.4s steps(5) forwards !important;
  }
  .boot-skip {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 243, 230, 0.6);
  }
  @keyframes boot-out {
    to {
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
    }
  }
  @keyframes boot-auto-out {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  .achievement {
    position: fixed;
    top: 5.5rem;
    right: 1rem;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: min(22rem, calc(100vw - 2rem));
    border: 3px solid #0a0706;
    border-radius: 1rem;
    background: #221c17;
    padding: 0.7rem 1rem 0.7rem 0.8rem;
    box-shadow:
      inset 0 2px 0 rgba(255, 243, 230, 0.08),
      0 6px 0 #0a0706,
      0 0 0 2px rgba(240, 180, 41, 0.35);
    transform: translateX(120%);
    transition: transform 0.35s steps(6);
  }
  .achievement.is-in {
    transform: translateX(0);
  }
  .achievement-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex-shrink: 0;
    border: 3px solid #0a0706;
    border-radius: 0.7rem;
    background: #f0b429;
    font-size: 1.2rem;
  }

  /* Cortinilla: bloques que barren la pantalla a saltos (8 pasos) */
  .wipe {
    position: fixed;
    inset: 0;
    z-index: 90;
    pointer-events: none;
    background:
      repeating-linear-gradient(90deg, #f0b429 0 48px, #d4921f 48px 96px),
      #f0b429;
    clip-path: inset(0 100% 0 0);
  }
  .wipe.is-in {
    animation: wipe-in 0.42s steps(8) forwards;
  }
  .wipe.is-out {
    clip-path: inset(0 0 0 0);
    animation: wipe-out 0.42s steps(8) forwards;
  }
  @keyframes wipe-in {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes wipe-out {
    to {
      clip-path: inset(0 0 0 100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .achievement {
      transition: none;
    }
  }
</style>
