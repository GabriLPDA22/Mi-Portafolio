---
import Icon from '@/components/ui/Icon.astro';
import type { Tech } from '@/data/tech';

interface Props {
  tech: Tech;
  class?: string;
  /** Pinta el logo con su color de marca (si no, hereda currentColor). */
  branded?: boolean;
}

const { tech, class: className = 'size-5', branded = false } = Astro.props;
const style = branded ? `color:${tech.color}` : undefined;
---

{
  tech.path ? (
    <svg viewBox="0 0 24 24" class={className} style={style} fill="currentColor" aria-hidden="true" focusable="false">
      <path d={tech.path} />
    </svg>
  ) : (
    <span style={style} class="inline-flex">
      <Icon name={tech.fallback ?? 'code'} class={className} />
    </span>
  )
}
