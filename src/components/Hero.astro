---
/**
 * Portada como "pantalla de título" de videojuego: logo con contorno, etiqueta de clase,
 * monigote pixel art sobre su plataforma y botón START. Todo es HTML/CSS: se lee al instante.
 */
import Icon from './Icon.astro';
import Mascot from './Mascot.astro';
import SocialPills from './SocialPills.astro';
import { getT, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const [firstName, lastName] = t.hero.name.split(' ');
const es = locale === 'es';
const d = (order: number) => `--d:${(order * 0.4).toFixed(2)}s`;
// Frases del monigote al pulsarlo (van rotando)
const phrases = es
  ? ['¡Hola! Soy Gabriel', '¿Buscas full-stack? 👀', 'git push --force? Nunca', 'Café ☕ → código', 'Compila a la primera… a veces', 'Descarga mi CV ↓', 'Hecho con Astro ⚡', '¡Ey, que hace cosquillas!']
  : ["Hi! I'm Gabriel", 'Looking for a full-stack? 👀', 'git push --force? Never', 'Coffee ☕ → code', 'Compiles first try… sometimes', 'Grab my CV ↓', 'Built with Astro ⚡', 'Hey, that tickles!'];
---

<section class="relative isolate flex min-h-svh w-full flex-col overflow-hidden" data-scrub-scope>
  <!-- Luz de ventana (la de siempre) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 w-[min(58vw,42rem)] opacity-70 sm:opacity-90">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_40%,rgba(255,178,70,0.2),transparent_62%)]"></div>
    <div
      class="absolute inset-0"
      style="background-image:repeating-linear-gradient(90deg, transparent 0 18px, rgba(255,196,90,0.045) 18px 22px);mask-image:linear-gradient(90deg, transparent 0%, black 35%, black 100%);-webkit-mask-image:linear-gradient(90deg, transparent 0%, black 35%, black 100%)"
    >
    </div>
  </div>

  <div class="container-main relative flex flex-1 flex-col justify-center pb-14 pt-28 sm:pb-16 sm:pt-32">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-10">
      <!-- Columna izquierda: título -->
      <div class="order-2 flex flex-col gap-7 lg:order-1">
        <p class="intro-fade hud-chip self-start" style={d(0)}>
          <span class="pulse-dot h-2 w-2 bg-acid"></span>
          {es ? 'Player 1' : 'Player 1'} · {t.hero.availability}
        </p>

        <h1 class="intro-fade game-logo" style={d(0.3)}>
          <span class="block">{firstName}</span>
          <span class="block pl-[0.35em]">{lastName}</span>
          <span class="sr-only">. {t.hero.title}. {t.hero.subtitle}</span>
        </h1>

        <p class="intro-fade class-pill self-start" style={d(0.6)} aria-hidden="true">
          <span class="font-pixel text-[0.7em] opacity-70">{es ? 'CLASE' : 'CLASS'}</span>
          Full-Stack Dev
        </p>

        <p class="intro-scale max-w-md text-pretty text-[15px] leading-relaxed text-ink/75 sm:text-base xl:text-lg" style={d(0.9)}>
          {t.hero.subtitle}
        </p>

        <!-- Botonera tipo menú de juego -->
        <div class="intro-fade flex flex-col gap-3 sm:flex-row sm:items-stretch" style={d(1.1)}>
          <a href="#contacto" class="start-btn group">
            <span class="start-ready font-pixel">✓ {es ? 'Ready' : 'Ready'}</span>
            <Icon name="Play" class="h-7 w-7 fill-current" strokeWidth={2.5} />
            <span class="flex flex-col leading-none">
              <span class="text-[1.45rem] font-black uppercase tracking-tight">{es ? '¡Hablemos!' : "Let's talk!"}</span>
              <span class="mt-1 text-[11px] font-bold opacity-75">{es ? 'Respondo en menos de 24 h' : 'I reply within 24 h'}</span>
            </span>
          </a>
          <div class="flex gap-3">
            <a href="/cv/Gabriel-Saiz-CV.pdf" download="Gabriel-Saiz-CV.pdf" class="game-btn flex-1 sm:flex-none">
              <Icon name="FileDown" class="h-4 w-4" strokeWidth={2.4} />
              {t.hero.ctaCv}
            </a>
            <a href="#proyectos" class="game-btn game-btn-ghost flex-1 sm:flex-none">
              {t.hero.ctaSecondary}
              <Icon name="ArrowDown" class="h-4 w-4" strokeWidth={2.4} />
            </a>
          </div>
        </div>

        <div class="intro-fade" style={d(1.4)}>
          <p class="font-pixel text-[11px] uppercase tracking-wider text-ink/60">{t.hero.proof}</p>
        </div>
      </div>

      <!-- Columna derecha: el personaje en su plataforma -->
      <div class="intro-fade order-1 flex justify-center lg:order-2" style={d(0.2)}>
        <div class="relative flex flex-col items-center">
          <div class="speech font-pixel" aria-live="polite">
            <span data-speech>{phrases[0]}</span><span class="speech-caret" aria-hidden="true">_</span>
          </div>
          <div class="relative">
            <div aria-hidden="true" class="absolute left-1/2 top-[55%] -z-10 h-[120%] w-[140%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(240,180,41,0.28),transparent_62%)]"></div>
            <button
              type="button"
              data-mascot
              data-phrases={JSON.stringify(phrases)}
              class="mascot-btn block cursor-pointer rounded-lg"
              aria-label={es ? 'Saludar a Gabriel (pulsa para que hable)' : 'Say hi to Gabriel (click to make him talk)'}
            >
              <Mascot class="h-[168px] w-auto sm:h-[252px] lg:h-[336px]" />
            </button>
          </div>
          <!-- Plataforma pixel -->
          <svg viewBox="0 0 48 6" shape-rendering="crispEdges" class="-mt-[2px] w-[192px] sm:w-[288px] lg:w-[384px]" aria-hidden="true">
            <rect x="2" y="0" width="44" height="1" fill="#ffd06a"></rect>
            <rect x="1" y="1" width="46" height="1" fill="#f0b429"></rect>
            <rect x="0" y="2" width="48" height="2" fill="#6b4a2e"></rect>
            <rect x="1" y="4" width="46" height="1" fill="#4a3322"></rect>
            <rect x="3" y="5" width="42" height="1" fill="#2e2016"></rect>
            <rect x="6" y="2" width="2" height="1" fill="#8a6242"></rect>
            <rect x="18" y="3" width="3" height="1" fill="#8a6242"></rect>
            <rect x="33" y="2" width="2" height="1" fill="#8a6242"></rect>
            <rect x="40" y="3" width="2" height="1" fill="#8a6242"></rect>
          </svg>
        </div>
      </div>
    </div>

    <!-- Parte inferior: PRESS START + redes -->
    <div class="mt-12 flex flex-col items-center gap-6 lg:mt-14">
      <a href="#sobre-mi" data-press-start class="press-start font-pixel flex flex-col items-center gap-1.5">
        <span><span aria-hidden="true">▶</span> Press start</span>
        <span class="press-hint text-[10px] normal-case tracking-normal text-ink/60">{es ? 'clic o pulsa Enter' : 'click or press Enter'}</span>
      </a>
      <SocialPills introDelay={1.6} />
    </div>
  </div>
</section>

<style>
  /* Logo tipo carátula: relleno claro, contorno grueso y sombra dorada escalonada */
  .game-logo {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(3.3rem, 13vw, 7.6rem);
    line-height: 0.86;
    letter-spacing: -0.02em;
    color: #fff3e6;
    -webkit-text-stroke: 0.09em #120e0b;
    paint-order: stroke fill;
    text-shadow:
      0.04em 0.05em 0 #f0b429,
      0.08em 0.1em 0 #120e0b;
    transform: rotate(-2.5deg);
    transform-origin: left center;
  }

  .class-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7em;
    border: 3px solid #120e0b;
    border-radius: 999px;
    background: #f0b429;
    color: #120e0b;
    padding: 0.35em 1.1em 0.4em;
    font-weight: 900;
    font-size: clamp(1rem, 2.6vw, 1.35rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    box-shadow: 0 4px 0 #120e0b;
    transform: rotate(1.5deg);
    margin-top: -0.6rem;
  }

  

  /* Bocadillo de diálogo pixel */
  .speech {
    position: relative;
    margin-bottom: 1.6rem;
    background: #fff3e6;
    color: #120e0b;
    padding: 0.55rem 0.8rem;
    font-size: 11px;
    text-transform: uppercase;
    box-shadow:
      0 -3px 0 #120e0b,
      0 3px 0 #120e0b,
      -3px 0 0 #120e0b,
      3px 0 0 #120e0b,
      0 6px 0 rgba(0, 0, 0, 0.35);
  }

  .speech::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 9px;
    height: 6px;
    background: #fff3e6;
    box-shadow:
      3px 0 0 #120e0b,
      -3px 0 0 #120e0b,
      0 3px 0 #120e0b;
    transform: translateX(-50%);
  }

  .speech-caret {
    margin-left: 2px;
  }

  .press-start {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff3e6;
    text-shadow: 0 2px 0 #120e0b;
  }

  .mascot-btn:hover :global(.mascot) {
    filter: drop-shadow(0 0 0.35rem rgba(240, 180, 41, 0.45));
  }
  .press-start:hover {
    color: #f0b429;
  }

  @media (prefers-reduced-motion: no-preference) {
    .press-start > span:first-child,
    .speech-caret {
      animation: blink-8bit 1.1s steps(1) infinite;
    }
  }

  @keyframes blink-8bit {
    50% {
      opacity: 0;
    }
  }
</style>
