---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, whatsappUrl } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = '¿Hablamos de tu próxima web?',
  text = 'Cuéntanos qué necesitas y te enviamos un presupuesto cerrado en menos de 24 horas. Sin compromiso y sin tecnicismos.',
} = Astro.props;
---

<section class="section pt-0" aria-labelledby="cta-title">
  <div class="container-page">
    <div class="reveal relative overflow-hidden rounded-[2rem] border border-accent/25 bg-surface px-6 py-14 text-center sm:px-12 sm:py-20">
      <div class="grid-bg pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div
        class="pointer-events-none absolute -bottom-40 left-1/2 h-80 w-[40rem] -translate-x-1/2 rounded-full bg-accent/20 blur-[110px]"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        <h2 id="cta-title" class="heading-lg mx-auto max-w-2xl">{title}</h2>
        <p class="lead mx-auto mt-5 max-w-xl">{text}</p>
        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href="/contacto#presupuesto" size="lg" data-cta="cta-band">
            Solicitar presupuesto
            <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
          </Button>
          <Button href={whatsappUrl()} variant="secondary" size="lg" target="_blank" rel="noopener" data-cta="cta-band-whatsapp">
            <Icon name="messageCircle" class="size-4" />
            Escribir por WhatsApp
          </Button>
        </div>
        <p class="mt-6 text-sm text-muted">{site.contact.responseTime}</p>
      </div>
    </div>
  </div>
</section>
