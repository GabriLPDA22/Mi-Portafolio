---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { whatsappUrl } from '@/config/site';
import type { Crumb } from '@/lib/schema';

interface Props {
  eyebrow: string;
  breadcrumbs: Crumb[];
  lead: string;
  /** Precio orientativo visible junto a los CTA (p. ej. "300 – 600 €"). */
  price?: string;
  delivery?: string;
  ctaHref?: string;
  whatsappMessage?: string;
}

const { eyebrow, breadcrumbs, lead, price, delivery, ctaHref = '/contacto#presupuesto', whatsappMessage } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-[28rem] w-[48rem] -translate-x-1/2 rounded-full bg-accent/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>
  <div class="container-page relative pt-10 pb-16 sm:pt-14 sm:pb-24">
    <Breadcrumbs items={breadcrumbs} />
    <p class="eyebrow mt-10">
      <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1 class="heading-xl mt-5 max-w-4xl">
      <slot />
    </h1>
    <p class="lead mt-6 max-w-2xl">{lead}</p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
      <Button href={ctaHref} size="lg" data-cta="page-hero">
        Solicitar presupuesto
        <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
      </Button>
      <Button href={whatsappUrl(whatsappMessage)} variant="secondary" size="lg" target="_blank" rel="noopener" data-cta="page-hero-whatsapp">
        <Icon name="messageCircle" class="size-4" />
        Consultar por WhatsApp
      </Button>
    </div>

    {
      (price || delivery) && (
        <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4 text-sm">
          {price && (
            <div>
              <dt class="text-muted">Precio orientativo</dt>
              <dd class="mt-1 text-lg font-semibold text-fg">{price}</dd>
            </div>
          )}
          {delivery && (
            <div>
              <dt class="text-muted">Plazo de entrega</dt>
              <dd class="mt-1 text-lg font-semibold text-fg">{delivery}</dd>
            </div>
          )}
          <div>
            <dt class="text-muted">Presupuesto</dt>
            <dd class="mt-1 text-lg font-semibold text-fg">Cerrado y sin compromiso</dd>
          </div>
        </dl>
      )
    }
  </div>
</section>
