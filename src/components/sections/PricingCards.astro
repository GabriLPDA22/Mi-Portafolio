---
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { services, formatPrice, type ServiceId } from '@/data/services';
import { site } from '@/config/site';

interface Props {
  /** Servicio destacado visualmente. */
  featured?: ServiceId;
  showMaintenance?: boolean;
}

const { featured = 'diseno-web', showMaintenance = false } = Astro.props;
const list = services.filter((s) => showMaintenance || s.id !== 'mantenimiento-web');
---

<div class:list={['grid gap-5', list.length === 4 ? 'md:grid-cols-2 xl:grid-cols-4' : 'md:grid-cols-3']}>
  {
    list.map((s) => {
      const isFeatured = s.id === featured;
      return (
        <article
          class:list={[
            'reveal card relative flex flex-col p-7',
            isFeatured && 'border-accent/40 bg-surface shadow-(--shadow-glow)',
          ]}
        >
          {isFeatured && (
            <p class="absolute -top-3 left-7 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-ink">
              Recomendado
            </p>
          )}
          <h3 class="text-lg font-semibold text-fg">
            <a href={s.path} class="after:absolute after:inset-0 after:content-[''] hover:text-accent">
              {s.name}
            </a>
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.idealFor}</p>
          <p class="mt-6 text-3xl font-semibold tracking-tight text-fg">{formatPrice(s.price)}</p>
          <p class="mt-1 text-xs text-muted">Entrega: {s.delivery}</p>
          <ul class="mt-6 grid gap-3 text-sm text-soft">
            {s.includes.map((item) => (
              <li class="flex gap-3">
                <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
                {item}
              </li>
            ))}
          </ul>
          <div class="relative z-10 mt-auto pt-8">
            <Button
              href={`/contacto?servicio=${s.formValue}#presupuesto`}
              variant={isFeatured ? 'primary' : 'secondary'}
              class="w-full"
              data-cta={`pricing-${s.id}`}
            >
              Solicitar presupuesto
            </Button>
          </div>
        </article>
      );
    })
  }
</div>
<p class="mt-6 text-center text-sm text-muted">{site.pricing.note}</p>
