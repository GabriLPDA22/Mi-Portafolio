---
/**
 * FAQ accesible sin JavaScript (<details>/<summary>). El texto es idéntico al del
 * JSON-LD FAQPage, requisito de Google para datos estructurados válidos.
 */
import Icon from '@/components/ui/Icon.astro';
import type { Faq } from '@/data/faqs';

interface Props {
  faqs: Faq[];
  title?: string;
  intro?: string;
  id?: string;
}

const { faqs, title = 'Preguntas frecuentes', intro, id = 'faq' } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="container-page grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow">FAQ</p>
      <h2 id={`${id}-title`} class="heading-lg mt-4">{title}</h2>
      {intro && <p class="mt-5 text-muted">{intro}</p>}
      <p class="mt-5 text-sm text-muted">
        ¿No encuentras tu pregunta? <a href="/contacto" class="text-accent underline underline-offset-4">Escríbenos</a> y te
        respondemos en menos de 24 h.
      </p>
    </div>
    <div class="lg:col-span-8">
      <div class="divide-y divide-line border-y border-line">
        {
          faqs.map((f, i) => (
            <details class="group" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-left [&::-webkit-details-marker]:hidden">
                <h3 class="text-base font-medium text-fg sm:text-lg">{f.question}</h3>
                <span class="mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-full border border-line text-muted transition group-open:rotate-45 group-open:border-accent/50 group-open:text-accent">
                  <Icon name="x" class="size-3.5 rotate-45" />
                </span>
              </summary>
              <p class="-mt-1 max-w-2xl pb-6 leading-relaxed text-muted">{f.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
