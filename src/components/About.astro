---
/**
 * "Sobre mí" como ficha de personaje de RPG: retrato con placa de nombre, datos del jugador,
 * estadísticas reales (sacadas de la trayectoria, no inventadas) y rasgos.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import GameHeading from './GameHeading.astro';
import ScriptQuote from './ScriptQuote.astro';
import photo from '@/assets/img/Yo.webp';
import { gameLabels, getT, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const g = gameLabels[locale];
const es = locale === 'es';

const info = es
  ? [
      { k: 'Clase', v: 'Full-Stack Dev' },
      { k: 'Base', v: 'Zaragoza · Remoto' },
      { k: 'Especialidad', v: 'Móvil + backend' },
      { k: 'En producción desde', v: '2024' },
    ]
  : [
      { k: 'Class', v: 'Full-Stack Dev' },
      { k: 'Base', v: 'Zaragoza · Remote' },
      { k: 'Speciality', v: 'Mobile + backend' },
      { k: 'Shipping since', v: '2024' },
    ];

// Datos de la trayectoria: 4 apps con Deveco.it + la app social propia (ARCH);
// Huvegrym y Tarot Divinidad online; Deveco.it y GOLIVE como empresas.
const stats = es
  ? [
      { n: '5', label: 'Apps publicadas en stores' },
      { n: '2', label: 'Webs de clientes online' },
      { n: '2', label: 'Empresas en equipo' },
    ]
  : [
      { n: '5', label: 'Apps shipped to the stores' },
      { n: '2', label: 'Client websites live' },
      { n: '2', label: 'Companies worked with' },
    ];

const perks = ['Target', 'Code2', 'MessageSquare'];
const photoAlt = es
  ? 'Gabriel Saiz — Desarrollador Full-Stack especializado en React Native, Next.js y .NET'
  : 'Gabriel Saiz — Full-Stack Developer specialised in React Native, Next.js and .NET';
---

<section id="sobre-mi" class="cv-auto relative z-0 scroll-mt-24 py-20 sm:py-28">
  <div class="container-main">
    <GameHeading level={`${g.level} 01`} eyebrow={g.about} title={t.about.title} subtitle={t.about.subtitle} />

    <div
      data-reveal
      data-reveal-margin="-60px"
      style="--ry:28px;--ease:cubic-bezier(0.22,1,0.36,1)"
      class="game-panel relative grid gap-8 p-4 sm:p-6 lg:grid-cols-[minmax(0,21rem)_minmax(0,1fr)] lg:gap-10 lg:p-8"
    >
      <!-- Retrato -->
      <div class="flex flex-col gap-4">
        <div class="portrait relative">
          <span class="pixel-tag absolute -top-3 left-4 z-10 border-2 border-acid text-acid">P1</span>
          <div class="relative aspect-[4/5] overflow-hidden rounded-[0.9rem] border-[3px] border-noir">
            <Picture
              src={photo}
              alt={photoAlt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[360, 540, 720]}
              sizes="(max-width: 1024px) 90vw, 336px"
              loading="lazy"
              class="img-fill object-cover object-[center_14%]"
            />
            <div aria-hidden="true" class="portrait-scan pointer-events-none absolute inset-0"></div>
          </div>
          <div class="nameplate">
            <p class="game-title text-[1.7rem] leading-none sm:text-3xl">{t.hero.name}</p>
            <p class="font-pixel mt-1.5 flex items-center gap-2 text-[10px] uppercase tracking-wider text-acid">
              <span class="pulse-dot h-2 w-2 shrink-0 rounded-full bg-acid"></span>
              {t.hero.availability}
            </p>
          </div>
        </div>
        <ScriptQuote size="sm" class="px-1 text-center">{t.hero.vibeAlt}</ScriptQuote>
      </div>

      <!-- Ficha -->
      <div class="flex min-w-0 flex-col gap-7">
        <div>
          <p class="sheet-label">{es ? 'Datos del jugador' : 'Player data'}</p>
          <dl class="grid grid-cols-2 gap-2 sm:gap-3">
            {
              info.map((row) => (
                <div class="rounded-xl border-2 border-white/10 bg-noir/60 px-3 py-2.5 sm:px-4">
                  <dt class="font-pixel text-[9px] uppercase tracking-wider text-ink/55 sm:text-[10px]">{row.k}</dt>
                  <dd class="mt-1 text-[14px] font-bold leading-tight text-ink sm:text-base">{row.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div>
          <p class="sheet-label">{es ? 'Estadísticas' : 'Stats'}</p>
          <ul class="grid grid-cols-3 gap-2 sm:gap-3">
            {
              stats.map((s, i) => (
                <li class="stat" style={`--d:${(0.15 + i * 0.12).toFixed(2)}s`}>
                  <span class="game-title block text-[2.3rem] leading-none sm:text-5xl">{s.n}</span>
                  <span class="mt-2 block text-[11.5px] font-semibold leading-snug text-ink/70 sm:text-[13px]">{s.label}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="sheet-label">{es ? 'Rasgos' : 'Traits'}</p>
          <ul class="flex flex-col gap-2">
            {
              t.about.bullets.map((b, i) => (
                <li class="flex items-center gap-3 rounded-xl border-2 border-white/10 px-3 py-2.5 text-[14px] font-semibold text-ink/85 sm:text-[15px]">
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg border-2 border-noir bg-acid text-noir shadow-[0_2px_0_#0a0706]">
                    <Icon name={perks[i] ?? 'Star'} class="h-4 w-4" strokeWidth={2.2} />
                  </span>
                  {b}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a href="https://github.com/GabriLPDA22" target="_blank" rel="noopener noreferrer" class="game-btn">
            <Icon name="Github" class="h-4 w-4" strokeWidth={2} />
            {es ? 'Ver GitHub' : 'View GitHub'}
          </a>
          <a href="/cv/Gabriel-Saiz-CV.pdf" download="Gabriel-Saiz-CV.pdf" class="game-btn game-btn-ghost">
            <Icon name="Download" class="h-4 w-4" strokeWidth={2} />
            {t.hero.ctaCv}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sheet-label {
    margin-bottom: 0.75rem;
    font-family: var(--font-pixel);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 243, 230, 0.6);
  }
  .sheet-label::before {
    content: '▸ ';
    color: var(--color-acid);
  }
  .portrait {
    border-radius: 1.1rem;
    background: #120e0b;
    padding: 0.5rem 0.5rem 0;
    box-shadow:
      0 0 0 3px #0a0706,
      0 6px 0 3px #0a0706;
  }
  .nameplate {
    margin: -1.4rem 0.25rem 0;
    position: relative;
    border: 3px solid #0a0706;
    border-radius: 0.9rem;
    background: #221c17;
    padding: 0.7rem 0.9rem 0.8rem;
    box-shadow: inset 0 2px 0 rgba(255, 243, 230, 0.08);
    transform: translateY(0.75rem);
  }
  /* Líneas de monitor CRT sobre la foto */
  .portrait-scan {
    background: repeating-linear-gradient(0deg, rgba(10, 7, 6, 0.16) 0 2px, transparent 2px 4px);
    mix-blend-mode: multiply;
  }
  .stat {
    border: 3px solid #0a0706;
    border-radius: 0.9rem;
    background: #120e0b;
    padding: 0.8rem 0.7rem;
    box-shadow: 0 4px 0 #0a0706;
  }
</style>
