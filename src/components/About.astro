---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import ScriptQuote from './ScriptQuote.astro';
import SplitTitle from './SplitTitle.astro';
import photo from '@/assets/img/Yo.webp';
import { gameLabels, getT, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const g = gameLabels[locale];

const techGroups = {
  es: {
    front: { label: 'Apps móviles', items: 'React Native / Expo / Flutter / TypeScript' },
    styles: { label: 'Web', items: 'Next.js / Vue / WordPress' },
    back: { label: 'Backend', items: '.NET / PostgreSQL / SignalR / Symfony' },
    tools: { label: 'Despliegue e integraciones', items: 'AWS / Expo EAS / Codemagic / Stripe' },
  },
  en: {
    front: { label: 'Mobile apps', items: 'React Native / Expo / Flutter / TypeScript' },
    styles: { label: 'Web', items: 'Next.js / Vue / WordPress' },
    back: { label: 'Backend', items: '.NET / PostgreSQL / SignalR / Symfony' },
    tools: { label: 'Deployment & integrations', items: 'AWS / Expo EAS / Codemagic / Stripe' },
  },
}[locale];

const scrub = (vars: Record<string, number>) => JSON.stringify(vars);

const card = 'game-panel group relative z-[1] overflow-hidden p-6 xl:p-8';
const cardFill =
  'absolute inset-0 -z-[1] scale-x-0 bg-ink transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-x-100';
const cardTitle = 'relative z-10 text-xl font-medium text-ink/80 transition-colors duration-300 group-hover:text-noir xl:text-2xl';
const cardItems = 'relative z-10 mt-3 font-code text-sm text-ink/65 transition-colors duration-300 group-hover:text-noir/70 xl:text-base';
const photoAlt =
  locale === 'es'
    ? 'Gabriel Saiz — Desarrollador Full-Stack especializado en React Native, Next.js y .NET'
    : 'Gabriel Saiz — Full-Stack Developer specialised in React Native, Next.js and .NET';
---

<section
  id="sobre-mi"
  data-scrub-scope
  data-pin-cover
  class="relative z-0 scroll-mt-24 bg-noir py-28 xl:bg-transparent xl:py-40"
>
  <div class="container-main flex flex-col gap-12 xl:gap-24">
    <div class="flex w-full flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-20 2xl:w-[85%]">
      <div class="section-name-gsap" data-scrub={scrub({ x: -100, y: -100, mobileX: -40 })}>
        <p class="hud-chip" data-reveal style="--ry:12px"><span class="text-ink/70">{g.level} 01</span> · {g.about}</p>
        <h2 class="game-title mt-5 origin-left -rotate-[1.5deg] text-[clamp(2.3rem,7vw,4.6rem)]">
          <SplitTitle text={t.about.title} class="pb-[0.2em] pr-[0.12em]" />
        </h2>
      </div>
      <p
        class="description-gsap max-w-xl whitespace-pre-line text-base leading-relaxed text-ink/65 xl:text-xl"
        data-scrub={scrub({ x: 100, y: -100, mobileX: 40 })}
      >
        {t.about.subtitle}
      </p>
    </div>

    <div class="flex flex-col-reverse items-center gap-10 xl:flex-row xl:justify-between">
      <div class="flex w-full flex-col gap-6 xl:w-1/2 xl:gap-8">
        <div class="front-gsap" data-scrub={scrub({ scale: 0.9, rotate: 5, x: 100, mobileX: 40 })}>
          <div class={card}>
            <p class="pixel-tag relative z-10 mb-3 w-fit group-hover:bg-noir">{g.slot} 1</p>
            <p class={cardTitle}>{techGroups.front.label}</p>
            <p class={cardItems}>{techGroups.front.items}</p>
            <div class:list={[cardFill, 'origin-left']}></div>
          </div>
        </div>

        <div class="flex items-center justify-between gap-4">
          <div class="styles-gsap w-1/2" data-scrub={scrub({ scale: 0.9, rotate: -5, x: -100, mobileX: -40 })}>
            <div class={card}>
              <p class="pixel-tag relative z-10 mb-3 w-fit group-hover:bg-noir">{g.slot} 2</p>
            <p class={cardTitle}>{techGroups.styles.label}</p>
              <p class={cardItems}>{techGroups.styles.items}</p>
              <div class:list={[cardFill, 'origin-right']}></div>
            </div>
          </div>
          <div class="github-gsap flex w-1/2 justify-center" data-scrub={scrub({ rotate: 5, x: 100, mobileX: 30 })}>
            <a
              href="https://github.com/GabriLPDA22"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex cursor-pointer"
              aria-label={locale === 'es' ? 'Ver perfil de GitHub' : 'View GitHub profile'}
            >
              <span
                class="flex h-12 w-12 items-center justify-center rounded-full border border-white/20 bg-noir-soft transition-colors duration-300 group-hover:bg-ink group-hover:[&_svg]:text-noir xl:h-14 xl:w-14"
              >
                <Icon name="Github" class="h-5 w-5 text-ink" strokeWidth={1.7} />
              </span>
              <span
                class="relative -left-3 flex h-12 w-12 -rotate-45 items-center justify-center rounded-full bg-ink text-noir transition-all duration-300 group-hover:left-2 group-hover:rotate-180 group-hover:bg-noir-soft group-hover:text-ink xl:-left-4 xl:h-14 xl:w-14"
              >
                <Icon name="ArrowUpRight" class="h-5 w-5 xl:h-6 xl:w-6" strokeWidth={2.2} />
              </span>
            </a>
          </div>
        </div>

        <div class="flex items-end justify-between gap-4">
          <p class="tools-text-gsap w-[40%] text-sm leading-relaxed text-ink/65 xl:text-lg" data-scrub={scrub({ rotate: -5, x: -100, mobileX: -30 })}>
            {t.about.favorites}
          </p>
          <div class="back-gsap w-1/2" data-scrub={scrub({ scale: 0.9, rotate: 5, x: 100, mobileX: 40 })}>
            <div class={card}>
              <p class="pixel-tag relative z-10 mb-3 w-fit group-hover:bg-noir">{g.slot} 3</p>
            <p class={cardTitle}>{techGroups.back.label}</p>
              <p class={cardItems}>{techGroups.back.items}</p>
              <div class:list={[cardFill, 'origin-left']}></div>
            </div>
          </div>
        </div>

        <div class="tools-gsap" data-scrub={scrub({ scale: 0.9, rotate: -5, x: -100, mobileX: -40 })}>
          <div class={card}>
            <p class="pixel-tag relative z-10 mb-3 w-fit group-hover:bg-noir">{g.slot} 4</p>
            <p class={cardTitle}>{techGroups.tools.label}</p>
            <p class={cardItems}>{techGroups.tools.items}</p>
            <div class:list={[cardFill, 'origin-right']}></div>
          </div>
        </div>
      </div>

      <div class="personal-image-gsap relative w-full max-w-sm xl:max-w-md" data-scrub={scrub({ y: -50, x: 50, rotate: -5 })}>
        <div class="game-panel relative mx-auto p-3 md:p-4">
          <p class="pixel-tag absolute -top-3 left-5 z-10 border-2 border-acid text-acid">P1 · Gabriel</p>
          <div class="relative h-[24rem] w-full overflow-hidden rounded-[1.35rem] md:h-[30rem] xl:h-[34rem]">
            <Picture
              src={photo}
              alt={photoAlt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[400, 560, 800]}
              sizes="(max-width: 1024px) 90vw, 420px"
              loading="lazy"
              class="img-fill object-cover object-[center_12%] transition-transform duration-700 hover:scale-105"
            />
          </div>
          <ScriptQuote size="sm" class="mt-4 px-1">{t.hero.vibeAlt}</ScriptQuote>
        </div>
      </div>
    </div>
  </div>
</section>
