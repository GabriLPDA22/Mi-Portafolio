---
/**
 * Trayectoria como mapa de misiones: un camino pixel une cada misión (de la más reciente a la
 * primera). Arriba, la "próxima misión" apunta al contacto. Móvil: camino a la izquierda;
 * escritorio: misiones alternas a ambos lados del camino.
 */
import Icon from './Icon.astro';
import GameHeading from './GameHeading.astro';
import { gameLabels, getT, homePath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const g = gameLabels[locale];
const es = locale === 'es';
const total = t.experience.items.length;
---

<section id="trayectoria" class="relative z-10 scroll-mt-24 py-20 sm:py-28">
  <div class="container-main">
    <GameHeading
      level={`${g.level} 04`}
      eyebrow={es ? 'Mapa de misiones' : 'Quest map'}
      title={t.experience.title}
      subtitle={t.experience.subtitle}
    />

    <ol class="quest-map relative">
      <!-- Próxima misión -->
      <li class="quest-row">
        <span class="quest-node node-next" aria-hidden="true">?</span>
        <a
          href={`${homePath(locale)}#contacto`}
          class="quest-card group block border-dashed !border-acid/70 !bg-noir/70 p-5 sm:p-6"
        >
          <p class="font-pixel text-[10px] uppercase tracking-wider text-acid">{es ? 'Próxima misión' : 'Next quest'}</p>
          <p class="mt-1.5 text-xl font-black text-ink sm:text-2xl">{es ? '¿Tu equipo?' : 'Your team?'}</p>
          <p class="mt-1 flex items-center gap-1.5 text-[14px] font-semibold text-ink/70 transition-colors group-hover:text-acid">
            {es ? 'Desbloquéala escribiéndome' : 'Unlock it by messaging me'}
            <Icon name="ArrowRight" class="h-4 w-4 transition-transform group-hover:translate-x-1" strokeWidth={2.4} />
          </p>
        </a>
      </li>

      {
        t.experience.items.map((item, i) => (
          <li class="quest-row">
            <span class="quest-node" aria-hidden="true">
              <Icon name="Flag" class="h-4 w-4" strokeWidth={2.6} />
            </span>
            <article
              data-reveal
              data-reveal-margin="-60px"
              style={`--ry:26px;--d:${(i * 0.05).toFixed(2)}s;--ease:cubic-bezier(0.22,1,0.36,1)`}
              class="quest-card p-5 sm:p-7"
            >
              <div class="flex flex-wrap items-center gap-2">
                <span class="pixel-tag border-2 border-acid/60 text-acid">
                  {es ? 'Misión' : 'Quest'} {String(total - i).padStart(2, '0')}
                </span>
                <span class="pixel-tag bg-transparent text-ink/65">{item.period}</span>
                <span class="font-pixel text-[10px] uppercase tracking-wider text-ink/50">{item.location}</span>
              </div>

              <h3 class="mt-4 text-[1.35rem] font-black leading-tight text-ink sm:text-2xl">{item.role}</h3>
              <p class="mt-1 text-[14px] font-semibold text-ink/60">
                {es ? 'Gremio' : 'Guild'}:{' '}
                {'url' in item && item.url ? (
                  <a href={item.url as string} target="_blank" rel="noopener noreferrer" class="text-acid underline-offset-4 hover:underline">
                    {item.company}
                    <Icon name="ArrowUpRight" class="inline h-3.5 w-3.5 align-[-2px]" strokeWidth={2.4} />
                  </a>
                ) : (
                  <span class="text-acid">{item.company}</span>
                )}
              </p>

              <p class="mt-4 text-[14.5px] leading-relaxed text-ink/70">{item.description}</p>

              <p class="font-pixel mb-2.5 mt-5 text-[10px] uppercase tracking-wider text-ink/55">{es ? 'Recompensas' : 'Rewards'}</p>
              <ul class="space-y-2">
                {item.bullets.map((b) => (
                  <li class="flex items-start gap-2.5 text-[14px] leading-snug text-ink/80">
                    <span class="mt-[5px] h-2 w-2 shrink-0 rotate-45 bg-acid" aria-hidden="true" />
                    {b}
                  </li>
                ))}
              </ul>

              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={es ? 'Botín' : 'Loot'}>
                {item.chips.map((c) => (
                  <li class="rounded-md border-2 border-noir bg-noir px-2 py-1 font-pixel text-[9.5px] uppercase tracking-wider text-ink/80">{c}</li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }

      <!-- Punto de partida -->
      <li class="quest-row">
        <span class="quest-node node-start" aria-hidden="true">▶</span>
        <p class="font-pixel self-center py-2 text-[11px] uppercase tracking-widest text-ink/55">
          {es ? 'Inicio de la partida · 2024' : 'Game start · 2024'}
        </p>
      </li>
    </ol>
  </div>
</section>

<style>
  .quest-map {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  /* Camino pixel: línea de puntos gruesos */
  .quest-map::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.25rem;
    width: 6px;
    transform: translateX(-50%);
    background: repeating-linear-gradient(180deg, #f0b429 0 8px, transparent 8px 16px);
    opacity: 0.55;
  }
  .quest-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
  }
  .quest-node {
    position: relative;
    z-index: 1;
    display: grid;
    height: 2.5rem;
    width: 2.5rem;
    place-items: center;
    margin-top: 1rem;
    border: 3px solid #0a0706;
    border-radius: 0.6rem;
    background: #f0b429;
    color: #120e0b;
    box-shadow: 0 4px 0 #0a0706;
    font-family: var(--font-pixel);
    font-size: 16px;
  }
  .node-next {
    background: #221c17;
    color: #f0b429;
    border-color: #f0b429;
  }
  @media (prefers-reduced-motion: no-preference) {
    .node-next {
      animation: node-bob 1s steps(2) infinite;
    }
  }
  @keyframes node-bob {
    50% {
      transform: translateY(-3px);
    }
  }
  .node-start {
    margin-top: 0;
    background: #fff3e6;
    font-size: 12px;
  }
  .quest-card {
    border: 3px solid #0a0706;
    border-radius: 1.2rem;
    background: #221c17;
    box-shadow:
      inset 0 2px 0 rgba(255, 243, 230, 0.08),
      0 6px 0 #0a0706;
  }

  /* Escritorio: camino centrado y misiones alternas */
  @media (min-width: 1024px) {
    .quest-map::before {
      left: 50%;
    }
    .quest-row {
      grid-template-columns: minmax(0, 1fr) 3rem minmax(0, 1fr);
      gap: 2rem;
    }
    .quest-node {
      grid-column: 2;
      grid-row: 1;
      height: 3rem;
      width: 3rem;
    }
    .quest-row > :last-child {
      grid-row: 1;
      grid-column: 3;
    }
    .quest-row:nth-child(even) > :last-child {
      grid-column: 1;
    }
    .quest-row:nth-child(even) > p:last-child {
      text-align: right;
    }
  }
</style>
