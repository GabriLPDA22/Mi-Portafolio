---
/**
 * Proyectos como índice: una fila por proyecto con su imagen siempre visible, el nombre enorme
 * en letras vivas y el detalle desplegable (<details>, accesible y sin JS).
 */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Mascot from '../Mascot.astro';
import StretchText from '../StretchText.astro';
import archImg from '@/assets/img/arch-icon.webp';
import huvegrymImg from '@/assets/img/Huvegrym.webp';
import tarotImg from '@/assets/img/divinidad-hero.webp';
import { getT, type Locale } from '@/i18n';
import { getPro, LINKS } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const p = getPro(locale);
const es = locale === 'es';
const byId = (id: string) => t.projects.items.find((i) => i.id === id)!;
const [arch, huvegrym, tarot] = ['arch', 'huvegrym', 'tarot-divinidad'].map(byId);
const live = es ? 'En producción' : 'Live';

type Row = {
  id: string;
  title: string;
  kind: string;
  status: string;
  personal?: boolean;
  description: string;
  bullets: readonly string[];
  chips: readonly string[];
  link?: { href: string; label: string };
  img?: ImageMetadata;
  imgClass?: string;
};
const rows: Row[] = [
  { id: 'arch', title: arch.title, kind: arch.subtitle, status: live, description: arch.description, bullets: arch.bullets, chips: arch.chips, link: { href: LINKS.appStore, label: arch.cta }, img: archImg, imgClass: 'is-icon' },
  { id: 'huvegrym', title: huvegrym.title, kind: huvegrym.subtitle, status: live, description: huvegrym.description, bullets: huvegrym.bullets, chips: huvegrym.chips, link: { href: LINKS.huvegrym, label: 'huvegrym.es' }, img: huvegrymImg, imgClass: 'object-[center_78%]' },
  { id: 'tarot', title: tarot.title, kind: tarot.subtitle, status: live, description: tarot.description, bullets: tarot.bullets, chips: tarot.chips, link: { href: LINKS.divinidad, label: 'divinidad000.com' }, img: tarotImg, imgClass: 'object-center' },
  { id: 'bugrun', title: p.projects.bugrun.name, kind: p.projects.bugrun.kind, status: p.projects.bugrun.kind, personal: true, description: p.projects.bugrun.text, bullets: [], chips: p.projects.bugrun.stack },
];
---

<section id="proyectos" class="section cv-auto scroll-mt-16">
  <div class="container-main">
    <h2 class="h2">{p.projects.title}</h2>
    <p class="lead mt-5">{p.projects.intro}</p>

    <ol class="index mt-14" data-project-index>
      {
        rows.map((r, i) => (
          <li class="row" data-row={i}>
            <details open={i === 0}>
              <summary class="row-head">
                <span class:list={['thumb', !r.img && 'is-game']} aria-hidden="true">
                  {r.img ? (
                    <Image src={r.img} alt="" widths={[160, 320, 480]} sizes="(min-width: 900px) 11rem, 5.5rem" class:list={['thumb-img', r.imgClass]} />
                  ) : (
                    <Mascot class="thumb-mascot" />
                  )}
                </span>
                <StretchText text={r.title} class="row-name" />
                <span class="row-kind">{r.kind}</span>
                <span class:list={['row-status', r.personal && 'is-personal']}>{r.personal ? (es ? 'Personal' : 'Personal') : r.status}</span>
                <span class="row-toggle" aria-hidden="true">
                  <Icon name="Plus" strokeWidth={2} />
                </span>
              </summary>

              <div class="row-body">
                <div class="min-w-0">
                  <p class="max-w-[38rem] text-[17px] text-text">{r.description}</p>
                  {r.bullets.length > 0 && (
                    <ul class="mt-5 grid max-w-[40rem] gap-2.5 sm:grid-cols-2">
                      {r.bullets.map((b) => (
                        <li class="flex gap-2.5 text-[15px] leading-snug text-muted">
                          <Icon name="Check" class="mt-[3px] h-4 w-4 shrink-0 text-violet-light" strokeWidth={2.6} />
                          {b}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <div class="flex flex-col gap-5 md:items-end md:text-right">
                  <ul class="chips md:justify-end" aria-label={p.projects.stack}>
                    {r.chips.map((c) => <li>{c}</li>)}
                  </ul>
                  {r.link ? (
                    <a href={r.link.href} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                      {r.link.label}
                      <Icon name="ArrowUpRight" strokeWidth={2.2} />
                    </a>
                  ) : (
                    <button type="button" data-arcade-open hidden class="btn btn-violet">
                      <Icon name="Gamepad2" strokeWidth={2} />
                      {p.projects.bugrun.play}
                    </button>
                  )}
                </div>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .index {
    border-bottom: 1px solid rgba(237, 237, 242, 0.1);
  }
  .row {
    border-top: 1px solid rgba(237, 237, 242, 0.1);
  }

  /* ---------- Cabecera de cada fila: miniatura · nombre · tipo · estado · + ---------- */
  .row-head {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.35rem 1.1rem;
    padding: 1.4rem 0;
    cursor: pointer;
    list-style: none;
  }
  .row-head::-webkit-details-marker {
    display: none;
  }
  @media (min-width: 900px) {
    .row-head {
      grid-template-columns: 11rem minmax(0, 1fr) 15rem 8.5rem 2.5rem;
      gap: 2rem;
      padding: 1.75rem 0;
    }
  }
  .thumb {
    grid-column: 1;
    grid-row: 1 / span 3;
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.8rem;
    border: 1px solid rgba(237, 237, 242, 0.1);
    background: radial-gradient(circle at 50% 45%, rgba(139, 92, 246, 0.4), #0c0c0f 72%);
    transition:
      border-color 0.25s ease,
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (min-width: 900px) {
    .thumb {
      grid-row: 1;
      border-radius: 1rem;
    }
  }
  .row:hover .thumb,
  details[open] .thumb {
    border-color: rgba(167, 139, 250, 0.5);
  }
  .row:hover .thumb {
    transform: rotate(-2deg) scale(1.03);
  }
  .thumb :global(.thumb-img) {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  /* Todo el contenido de la miniatura va posicionado: centrado sea cual sea el tamaño */
  .thumb :global(.thumb-img.is-icon) {
    inset: auto;
    left: 50%;
    top: 50%;
    height: 74%;
    width: auto;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 22%; /* esquinas del icono de iOS */
    box-shadow: 0 10px 30px -8px rgba(139, 92, 246, 0.5);
  }
  .thumb :global(.thumb-mascot) {
    position: absolute;
    left: 50%;
    top: 50%;
    height: 72%;
    width: auto;
    transform: translate(-50%, -45%);
    image-rendering: pixelated;
  }
  .row-head :global(.row-name) {
    grid-column: 2;
    grid-row: 1;
    font-size: clamp(1.75rem, 5.5vw, 4.5rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-transform: uppercase;
    color: #ededf2;
    transition: color 0.25s ease;
  }
  .row:hover :global(.row-name),
  details[open] :global(.row-name) {
    color: #c4b5fd;
  }
  .row-kind {
    grid-column: 2 / -1;
    grid-row: 2;
    font-size: 14.5px;
    line-height: 1.4;
    color: #8a8a99;
  }
  .row-status {
    grid-column: 2 / -1;
    grid-row: 3;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(52, 211, 153, 0.3);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-size: 12.5px;
    font-weight: 600;
    color: #6ee7b7;
  }
  .row-status::before {
    content: '';
    height: 0.4rem;
    width: 0.4rem;
    border-radius: 999px;
    background: currentColor;
  }
  .row-status.is-personal {
    border-color: rgba(167, 139, 250, 0.35);
    color: #c4b5fd;
  }
  .row-toggle {
    grid-column: 3;
    grid-row: 1;
    display: grid;
    height: 2.5rem;
    width: 2.5rem;
    place-items: center;
    border: 1px solid rgba(237, 237, 242, 0.15);
    border-radius: 999px;
    color: #ededf2;
    transition:
      transform 0.3s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .row-toggle :global(svg) {
    height: 1.1rem;
    width: 1.1rem;
  }
  .row:hover .row-toggle {
    border-color: rgba(167, 139, 250, 0.6);
  }
  details[open] .row-toggle {
    transform: rotate(45deg);
    background: #7c3aed;
    border-color: #7c3aed;
  }
  @media (min-width: 900px) {
    .row-kind {
      grid-column: 3;
      grid-row: 1;
    }
    .row-status {
      grid-column: 4;
      grid-row: 1;
    }
    .row-toggle {
      grid-column: 5;
      grid-row: 1;
    }
  }

  /* ---------- Detalle ---------- */
  .row-body {
    display: grid;
    gap: 1.75rem;
    padding: 0 0 2.25rem;
  }
  @media (min-width: 900px) {
    .row-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: 3rem;
      padding-bottom: 2.75rem;
      padding-left: 13rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    details[open] .row-body {
      animation: open 0.4s ease both;
    }
  }
  @keyframes open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chips li {
    border: 1px solid rgba(237, 237, 242, 0.1);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    font-size: 13px;
    font-weight: 500;
    color: #b4b4c2;
  }

</style>
