---
/**
 * Experiencia: una fila por puesto con el año en cifras enormes perfiladas (el más reciente,
 * relleno de violeta; los demás se rellenan al pasar el ratón), la empresa en grande y el detalle.
 */
import Icon from '../Icon.astro';
import { getT, type Locale } from '@/i18n';
import { getPro } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const p = getPro(locale);
// "2024 — 2025" → ["2024", "2025"]: cada año en su línea
const years = (period: string) => period.split(/\s*[—–-]\s*/);
---

<section id="experiencia" class="section cv-auto scroll-mt-16">
  <div class="container-main">
    <h2 class="h2">{p.experience.title}</h2>
    <p class="lead mt-5">{p.experience.intro}</p>

    <ol class="jobs mt-14">
      {
        t.experience.items.map((job, i) => (
          <li class:list={['job', i === 0 && 'is-latest']}>
            <p class="year">
              <span class="sr-only">{job.period}</span>
              {years(job.period).map((y, k) => (
                <span class:list={['y', k > 0 && 'y-end']} aria-hidden="true">
                  {k > 0 && <span class="y-arrow">→ </span>}
                  {y}
                </span>
              ))}
            </p>

            <div class="min-w-0">
              <h3 class="company">
                {'url' in job && job.url ? (
                  <a href={job.url} target="_blank" rel="noopener noreferrer" class="company-link">
                    {job.company}
                    <Icon name="ArrowUpRight" class="h-[0.7em] w-[0.7em]" strokeWidth={2.4} />
                  </a>
                ) : (
                  job.company
                )}
              </h3>
              <p class="mt-2 text-[16px] font-semibold text-violet-light">{job.role}</p>
              <p class="mt-1.5 inline-flex items-center gap-1.5 text-[14px] text-muted">
                <Icon name="MapPin" class="h-3.5 w-3.5" strokeWidth={2} />
                {job.location}
              </p>
            </div>

            <div class="min-w-0">
              <p class="text-[16.5px] leading-relaxed text-text">{job.description}</p>
              <ul class="mt-4 grid gap-2">
                {job.bullets.map((b) => (
                  <li class="flex gap-2.5 text-[15px] leading-snug text-muted">
                    <span class="mt-[0.5em] h-1.5 w-1.5 shrink-0 rounded-full bg-violet" aria-hidden="true" />
                    {b}
                  </li>
                ))}
              </ul>
              <ul class="chips mt-5">
                {job.chips.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Formación -->
    <h3 class="mt-14 text-[15px] font-semibold text-violet-light">{p.experience.educationTitle}</h3>
    <ul class="edu mt-5">
      {
        p.experience.education.map((e) => (
          <li class="edu-item">
            <Icon name="GraduationCap" class="edu-icon" strokeWidth={1.8} />
            <div class="min-w-0">
              <p class="text-[17px] font-semibold leading-snug">{e.title}</p>
              <p class="mt-1 text-[14.5px] text-muted">
                {e.kind}, {e.school}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .jobs {
    border-bottom: 1px solid rgba(237, 237, 242, 0.1);
  }
  .job {
    display: grid;
    gap: 1.25rem;
    border-top: 1px solid rgba(237, 237, 242, 0.1);
    padding: 2.25rem 0;
  }
  @media (min-width: 900px) {
    .job {
      grid-template-columns: 15rem minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 2.5rem;
      padding: 3rem 0;
    }
  }

  /* ---------- Año: cifras enormes perfiladas ---------- */
  .year {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.6rem;
    font-size: clamp(3rem, 6vw, 4.75rem);
    font-weight: 820;
    font-stretch: 125%;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }
  @media (min-width: 900px) {
    .year {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .y {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(237, 237, 242, 0.5); /* ≥ 3:1 (texto grande, WCAG) */
    transition:
      color 0.35s ease,
      -webkit-text-stroke-color 0.35s ease;
  }
  .y-end {
    font-size: 0.55em;
    letter-spacing: -0.02em;
  }
  .y-arrow {
    -webkit-text-stroke: 0;
    color: #8a8a99;
    font-weight: 500;
  }
  /* El más reciente, relleno; los demás se rellenan al pasar por la fila */
  .is-latest .y,
  .job:hover .y {
    -webkit-text-stroke-color: transparent;
    background: linear-gradient(180deg, #c4b5fd, #7c3aed);
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* ---------- Empresa ---------- */
  .company {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 780;
    font-stretch: 118%;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .company-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    text-decoration: underline;
    text-decoration-color: rgba(167, 139, 250, 0.4);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.2s ease;
  }
  .company-link:hover {
    text-decoration-color: #a78bfa;
  }

  /* ---------- Formación ---------- */
  .edu {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .edu {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .edu-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border: 1px solid rgba(237, 237, 242, 0.08);
    border-radius: 1rem;
    background: #16161b;
    padding: 1.1rem 1.25rem;
  }
  .edu-item :global(.edu-icon) {
    height: 1.5rem;
    width: 1.5rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: #a78bfa;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chips li {
    border: 1px solid rgba(237, 237, 242, 0.1);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    font-size: 13px;
    font-weight: 500;
    color: #b4b4c2;
  }
</style>
