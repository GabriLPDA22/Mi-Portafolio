---
/** Sobre mí: quién soy en dos párrafos y cómo trabajo (principios de translations.results). */
import { getT, type Locale } from '@/i18n';
import { getPro } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const p = getPro(locale);
const principles = Object.values(t.results.items);
---

<section id="sobre-mi" class="section cv-auto scroll-mt-16">
  <div class="container-main grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-20">
    <div>
      <h2 class="h2">{p.about.title}</h2>
      <div class="mt-6 grid max-w-[36rem] gap-5 text-[17.5px] leading-relaxed text-muted">
        {p.about.body.map((para, i) => <p class:list={[i === 0 && 'text-text']}>{para}</p>)}
      </div>
    </div>

    <div>
      <h3 class="text-[15px] font-semibold text-violet-light">{p.about.principlesTitle}</h3>
      <dl class="mt-5 grid gap-px overflow-hidden rounded-[1.25rem] border border-white/[0.08] bg-white/[0.08] sm:grid-cols-2">
        {
          principles.map((pr) => (
            <div class="bg-card p-6">
              <dt class="text-[17px] font-[680] leading-snug tracking-[-0.015em] [font-stretch:108%]">{pr.title}</dt>
              <dd class="mt-2 text-[15px] leading-relaxed text-muted">{pr.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
