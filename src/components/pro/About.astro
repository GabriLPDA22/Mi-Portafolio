---
/** Sobre mí: retrato, quién soy en dos párrafos y tres hechos comprobables (no adjetivos). */
import { Image } from 'astro:assets';
import photo from '@/assets/img/Yo.webp';
import type { Locale } from '@/i18n';
import { getPro } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = getPro(locale);
---

<section id="sobre-mi" class="section cv-auto scroll-mt-16">
  <div class="container-main">
    <div class="grid items-end gap-10 md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] md:gap-14 lg:gap-20">
      <figure class="portrait">
        <Image src={photo} alt="Gabriel Saiz" widths={[320, 480, 640]} sizes="(min-width: 768px) 320px, 90vw" />
      </figure>
      <div>
        <h2 class="h2">{p.about.title}</h2>
        <div class="mt-6 grid max-w-[38rem] gap-5 text-[17.5px] leading-relaxed text-muted">
          {p.about.body.map((para, i) => <p class:list={[i === 0 && 'text-text']}>{para}</p>)}
        </div>
        <dl class="langs mt-8" aria-label={p.about.languagesTitle}>
          {
            p.about.languages.map((l) => (
              <div class="lang">
                <dt>{l.name}</dt>
                <dd>{l.level}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <h3 class="mt-16 text-[15px] font-semibold text-violet-light">{p.about.proofTitle}</h3>
    <ul class="proof mt-5">
      {
        p.about.proof.map((item) => (
          <li class="proof-item">
            <p class="proof-big">{item.big}</p>
            <p class="proof-text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Retrato en blanco y negro con un velo violeta suave (la cara se ve con claridad) */
  .portrait {
    position: relative;
    width: min(100%, 20rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.5rem;
    background: #d9d9de;
    box-shadow:
      0 0 0 1px rgba(237, 237, 242, 0.1),
      0 40px 100px -40px rgba(124, 58, 237, 0.7);
  }
  .portrait :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.05) brightness(1.02);
  }
  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, rgba(139, 92, 246, 0.35), rgba(76, 29, 149, 0.15) 45%, transparent 70%);
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* ---------- Idiomas ---------- */
  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .lang {
    border: 1px solid rgba(237, 237, 242, 0.1);
    border-radius: 0.9rem;
    background: #16161b;
    padding: 0.7rem 1rem;
  }
  .lang dt {
    font-size: 15px;
    font-weight: 650;
  }
  .lang dd {
    margin-top: 0.15rem;
    font-size: 13.5px;
    color: #8a8a99;
  }

  /* ---------- Hechos: cifra o palabra enorme + explicación ---------- */
  .proof {
    display: grid;
    border-top: 1px solid rgba(237, 237, 242, 0.1);
  }
  @media (min-width: 900px) {
    .proof {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .proof-item {
    border-bottom: 1px solid rgba(237, 237, 242, 0.1);
    padding: 1.75rem 0;
  }
  @media (min-width: 900px) {
    .proof-item {
      border-bottom: 0;
      padding: 2.25rem 2rem 0.5rem 0;
    }
    .proof-item + .proof-item {
      border-left: 1px solid rgba(237, 237, 242, 0.1);
      padding-left: 2rem;
    }
  }
  .proof-big {
    font-size: clamp(2.4rem, 3.4vw, 3.4rem);
    font-weight: 820;
    font-stretch: 112%;
    white-space: nowrap; /* "End-to-end" no se parte por el guion */
    letter-spacing: -0.04em;
    line-height: 0.95;
    background: linear-gradient(180deg, #c4b5fd, #7c3aed);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.05em;
  }
  .proof-text {
    margin-top: 0.85rem;
    max-width: 22rem;
    font-size: 15.5px;
    line-height: 1.55;
    color: #b4b4c2;
  }
</style>
