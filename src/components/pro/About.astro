---
/** Sobre mí: retrato (duotono violeta), quién soy en dos párrafos y cómo trabajo. */
import { Image } from 'astro:assets';
import photo from '@/assets/img/Yo.webp';
import { getT, type Locale } from '@/i18n';
import { getPro } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const p = getPro(locale);
const principles = Object.values(t.results.items);
---

<section id="sobre-mi" class="section cv-auto scroll-mt-16">
  <div class="container-main">
    <div class="grid items-end gap-10 md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] md:gap-14 lg:gap-20">
      <figure class="portrait">
        <Image src={photo} alt="Gabriel Saiz" widths={[320, 480, 640]} sizes="(min-width: 768px) 320px, 90vw" />
      </figure>
      <div>
        <h2 class="h2">{p.about.title}</h2>
        <div class="mt-6 grid max-w-[38rem] gap-5 text-[17.5px] leading-relaxed text-muted">
          {p.about.body.map((para, i) => <p class:list={[i === 0 && 'text-text']}>{para}</p>)}
        </div>
      </div>
    </div>

    <h3 class="mt-16 text-[15px] font-semibold text-violet-light">{p.about.principlesTitle}</h3>
    <dl class="mt-5 grid gap-px overflow-hidden rounded-[1.25rem] border border-white/[0.08] bg-white/[0.08] sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((pr) => (
          <div class="bg-card p-6">
            <dt class="text-[17px] font-[680] leading-snug tracking-[-0.015em] [font-stretch:108%]">{pr.title}</dt>
            <dd class="mt-2 text-[15px] leading-relaxed text-muted">{pr.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* Retrato en blanco y negro con un velo violeta suave (la cara se ve con claridad) */
  .portrait {
    position: relative;
    width: min(100%, 20rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.5rem;
    background: #d9d9de;
    box-shadow:
      0 0 0 1px rgba(237, 237, 242, 0.1),
      0 40px 100px -40px rgba(124, 58, 237, 0.7);
  }
  .portrait :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.05) brightness(1.02);
  }
  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, rgba(139, 92, 246, 0.35), rgba(76, 29, 149, 0.15) 45%, transparent 70%);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
</style>
