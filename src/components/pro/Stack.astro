---
/** Stack agrupado por uso real: el día a día primero (logos de data/inventory.ts, SVG en build). */
import Icon from '../Icon.astro';
import { STACK_GROUPS, stackItems, type StackGroup } from '@/data/inventory';
import type { Locale } from '@/i18n';
import { getPro } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = getPro(locale);
// Logos de marca demasiado oscuros para el fondo grafito: misma tinta, más clara
const ON_DARK: Record<string, string> = {
  '#512BD4': '#9d7bff', // .NET
  '#4169E1': '#7b9cff', // PostgreSQL
  '#21759B': '#5aa9d6', // WordPress
  '#02569B': '#4aa8f0', // Flutter
};
const logoColor = (c: string) => ON_DARK[c.toUpperCase()] ?? c;
const groups = (Object.keys(STACK_GROUPS) as StackGroup[]).map((id) => ({
  id,
  label: p.stack.groups[id],
  items: stackItems(id),
}));
---

<section id="stack" class="section cv-auto scroll-mt-16">
  <div class="container-main">
    <h2 class="h2">{p.stack.title}</h2>
    <p class="lead mt-5">{p.stack.intro}</p>

    <div class="mt-14 grid gap-px overflow-hidden rounded-[1.25rem] border border-white/[0.08] bg-white/[0.08]">
      {
        groups.map((g) => (
          <div class:list={['group-row', g.id === 'daily' && 'is-daily']}>
            <h3 class="text-[15px] font-semibold leading-snug">{g.label}</h3>
            <ul class="tiles">
              {g.items.map((item) => (
                <li class="tile" title={item.note[locale]}>
                  {item.path ? (
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] shrink-0" aria-hidden="true">
                      <path d={item.path} fill={logoColor(item.color)} />
                    </svg>
                  ) : (
                    <Icon name={item.lucide ?? 'Code'} class="h-[18px] w-[18px] shrink-0" strokeWidth={2} />
                  )}
                  <span>{item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .group-row {
    display: grid;
    gap: 1.25rem;
    background: #16161b;
    padding: 1.5rem;
  }
  @media (min-width: 900px) {
    .group-row {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 2.5rem;
      padding: 2rem 2.25rem;
    }
  }
  .is-daily {
    background:
      radial-gradient(500px circle at 0% 0%, rgba(139, 92, 246, 0.16), transparent 70%),
      #16161b;
  }
  .is-daily h3 {
    color: #c4b5fd;
  }
  /* Lo que más importa a quien contrata: fichas más grandes */
  .is-daily .tile {
    padding: 0.75rem 1.1rem;
    font-size: 16px;
    border-color: rgba(167, 139, 250, 0.25);
  }
  .is-daily .tile :global(svg) {
    height: 22px;
    width: 22px;
  }
  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .tile {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid rgba(237, 237, 242, 0.08);
    border-radius: 0.75rem;
    background: #0c0c0f;
    padding: 0.55rem 0.85rem;
    font-size: 14.5px;
    font-weight: 550;
    transition: border-color 0.15s ease;
  }
  .tile:hover {
    border-color: rgba(167, 139, 250, 0.5);
  }
</style>
