---
/**
 * Stack: "Mi día a día" como protagonista (una tarjeta grande por tecnología: logo iluminado en
 * su color de marca, nombre en letras vivas y para qué la uso) y, debajo, el resto agrupado por
 * dónde se ha usado, en una lista compacta. Datos y logos en data/inventory.ts.
 */
import Icon from '../Icon.astro';
import StretchText from '../StretchText.astro';
import { stackItems, type StackGroup } from '@/data/inventory';
import type { Locale } from '@/i18n';
import { getPro } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = getPro(locale);

// Logos de marca demasiado oscuros para el fondo grafito: misma tinta, más clara
const ON_DARK: Record<string, string> = {
  '#512BD4': '#9d7bff', // .NET
  '#4169E1': '#7b9cff', // PostgreSQL
  '#21759B': '#5aa9d6', // WordPress
  '#02569B': '#4aa8f0', // Flutter
};
const logoColor = (c: string) => ON_DARK[c.toUpperCase()] ?? c;

const daily = stackItems('daily');
const rest = (['arch', 'clients', 'also'] as StackGroup[]).map((id) => ({ id, label: p.stack.groups[id], items: stackItems(id) }));
const uses = p.stack.uses as Record<string, string>;
---

<section id="stack" class="section cv-auto scroll-mt-16">
  <div class="container-main">
    <h2 class="h2">{p.stack.title}</h2>
    <p class="lead mt-5">{p.stack.intro}</p>

    <!-- Mi día a día -->
    <h3 class="mt-14 text-[15px] font-semibold text-violet-light">{p.stack.groups.daily}</h3>
    <ul class="daily mt-5">
      {
        daily.map((item) => {
          const c = logoColor(item.color);
          return (
            <li class="tech" style={`--c:${c}`}>
              <span class="tech-logo" aria-hidden="true">
                {item.path ? (
                  <svg viewBox="0 0 24 24">
                    <path d={item.path} fill={c} />
                  </svg>
                ) : (
                  <Icon name={item.lucide ?? 'Code'} strokeWidth={2} />
                )}
              </span>
              <StretchText text={item.name} class="tech-name" />
              <p class="tech-use">{uses[item.id]}</p>
            </li>
          );
        })
      }
    </ul>

    <!-- El resto, por dónde se ha usado -->
    <h3 class="mt-14 text-[15px] font-semibold text-muted">{p.stack.more}</h3>
    <div class="rest mt-4">
      {
        rest.map((g) => (
          <div class="rest-row">
            <p class="rest-label">{g.label}</p>
            <ul class="tiles">
              {g.items.map((item) => (
                <li class="tile" title={item.note[locale]}>
                  {item.path ? (
                    <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" aria-hidden="true">
                      <path d={item.path} fill={logoColor(item.color)} />
                    </svg>
                  ) : (
                    <Icon name={item.lucide ?? 'Code'} class="h-4 w-4 shrink-0" strokeWidth={2} />
                  )}
                  <span>{item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ---------- Día a día: tarjetas grandes ---------- */
  .daily {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .daily {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .daily {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .tech {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(237, 237, 242, 0.08);
    border-radius: 1.25rem;
    background:
      radial-gradient(260px circle at 0% 0%, color-mix(in srgb, var(--c) 16%, transparent), transparent 70%),
      #16161b;
    padding: 1.4rem 1.4rem 1.5rem;
    transition:
      border-color 0.25s ease,
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .tech:hover {
    border-color: color-mix(in srgb, var(--c) 55%, transparent);
    transform: translateY(-3px);
  }
  .tech-logo {
    display: grid;
    height: 3.25rem;
    width: 3.25rem;
    place-items: center;
    border-radius: 0.95rem;
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
    background: color-mix(in srgb, var(--c) 10%, #0c0c0f);
    box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--c) 70%, transparent);
    color: var(--c);
  }
  .tech-logo :global(svg) {
    height: 1.65rem;
    width: 1.65rem;
  }
  .tech :global(.tech-name) {
    margin-top: 1.4rem;
    font-size: clamp(1.6rem, 2.2vw, 1.9rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .tech-use {
    margin-top: 0.6rem;
    font-size: 14.5px;
    line-height: 1.5;
    color: #8a8a99;
  }

  /* ---------- El resto: lista compacta ---------- */
  .rest {
    border-top: 1px solid rgba(237, 237, 242, 0.08);
  }
  .rest-row {
    display: grid;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(237, 237, 242, 0.08);
    padding: 1.1rem 0;
  }
  @media (min-width: 900px) {
    .rest-row {
      grid-template-columns: 16rem minmax(0, 1fr);
      align-items: center;
      gap: 2rem;
    }
  }
  .rest-label {
    font-size: 14.5px;
    font-weight: 600;
    color: #b4b4c2;
  }
  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .tile {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(237, 237, 242, 0.08);
    border-radius: 999px;
    padding: 0.32rem 0.75rem;
    font-size: 13.5px;
    font-weight: 500;
    color: #b4b4c2;
  }
</style>
