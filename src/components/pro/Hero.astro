---
/**
 * Hero tipográfico: el nombre en "letras vivas" (se ensanchan y engordan al acercar el ratón;
 * sin ratón, respiran con una ola), la propuesta al lado de SAIZ y, debajo, la barra de estado
 * de lo que está en producción hoy.
 */
import Icon from '../Icon.astro';
import StretchText from '../StretchText.astro';
import type { Locale } from '@/i18n';
import { getPro, LINKS } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = getPro(locale);
const h = p.hero;
---

<section id="inicio" data-glow class="hero relative overflow-hidden">
  <div class="spot" aria-hidden="true"></div>

  <div class="container-main relative">
    <div class="hero-top">
      <h1 class="hero-name">
        <StretchText text="Gabriel" idle />
        <StretchText text="Saiz" idle class="line2" />
      </h1>

      <div class="hero-side">
        <p class="hero-role">{h.role}</p>
        <p class="lead mt-3">{h.lead}</p>
        <p class="avail mt-5">
          <span class="live" aria-hidden="true"></span>
          {h.availability}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href={LINKS.cv} download="Gabriel-Saiz-CV.pdf" data-umami-event="descargar-cv" class="btn btn-primary">
            <Icon name="Download" strokeWidth={2.2} />
            {h.cv}
          </a>
          <a href="#proyectos" class="btn btn-ghost">{h.projects}</a>
          <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer" data-umami-event="linkedin" class="btn btn-ghost btn-icon" aria-label="LinkedIn">
            <Icon name="Linkedin" strokeWidth={1.9} />
          </a>
          <a href={LINKS.github} target="_blank" rel="noopener noreferrer" data-umami-event="github" class="btn btn-ghost btn-icon" aria-label="GitHub">
            <Icon name="Github" strokeWidth={1.9} />
          </a>
        </div>
      </div>
    </div>

    <!-- Barra de estado: lo que está publicado ahora mismo -->
    <section class="status" aria-labelledby="status-title">
      <h2 id="status-title" class="status-title">
        <span class="live" aria-hidden="true"></span>
        {h.ledgerTitle}
      </h2>
      <ul class="status-list">
        {
          h.ledger.map((row, i) => (
            <li style={`--i:${i}`}>
              <a href={row.href} target="_blank" rel="noopener noreferrer" data-umami-event="ver-web" data-umami-event-proyecto={row.name} class="status-item">
                <span class="flex items-center justify-between gap-3">
                  <span class="truncate text-[16px] font-semibold text-text">{row.name}</span>
                  <Icon name="ArrowUpRight" class="arrow h-4 w-4 shrink-0" strokeWidth={2.2} />
                </span>
                <span class="mt-1 block truncate text-[13.5px] text-muted">{row.what}</span>
                <span class="where">{row.where}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</section>

<script>
  import { initStretch } from '@/scripts/stretch';
  initStretch();
</script>

<style>
  .hero {
    --glow-size: 760px;
    --glow-alpha: 0.13;
    padding-top: 7rem;
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }
  .spot {
    position: absolute;
    right: -20rem;
    top: -26rem;
    z-index: -1;
    height: 60rem;
    width: 60rem;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgba(124, 58, 237, 0.3), rgba(124, 58, 237, 0.08) 55%, transparent);
    pointer-events: none;
  }

  /* ---------- Nombre ---------- */
  .hero-top {
    --nf: min(16vw, 13rem);
    position: relative;
  }
  @media (min-width: 1024px) {
    .hero-top {
      /* deja sitio al bloque de la derecha, que empieza a la altura de SAIZ */
      min-height: calc(var(--nf) * 0.92 + 15.5rem);
    }
  }
  .hero-name {
    font-size: var(--nf);
    letter-spacing: -0.04em;
    line-height: 0.84;
    text-transform: uppercase;
  }
  .hero-name :global(.stretch) {
    display: flex;
  }
  .hero-name :global(.sl) {
    background: linear-gradient(180deg, #ffffff 10%, #9a9ab0 105%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.04em;
  }

  /* ---------- Propuesta: debajo en móvil, a la derecha de SAIZ en escritorio ---------- */
  .hero-side {
    margin-top: 2rem;
    max-width: 34rem;
  }
  @media (min-width: 1024px) {
    .hero-side {
      position: absolute;
      right: 0;
      top: calc(var(--nf) * 0.92);
      margin: 0;
      width: min(31rem, 46%);
    }
  }
  .hero-role {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: -0.02em;
    color: #a78bfa;
  }
  .hero-side :global(.lead) {
    font-size: 1.05rem;
  }

  .avail {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 15px;
    font-weight: 550;
  }
  .live {
    position: relative;
    display: inline-block;
    height: 0.55rem;
    width: 0.55rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: #34d399;
    box-shadow: 0 0 12px rgba(52, 211, 153, 0.6);
  }
  .live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
  }

  /* ---------- Barra de estado ---------- */
  .status {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid rgba(237, 237, 242, 0.1);
    padding-top: 1.25rem;
  }
  .status-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 14px;
    font-weight: 600;
    color: #b4b4c2;
  }
  .status-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  @media (min-width: 640px) {
    .status-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .status-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .status-item {
    display: block;
    height: 100%;
    border: 1px solid rgba(237, 237, 242, 0.08);
    border-radius: 1rem;
    background: rgba(22, 22, 27, 0.6);
    padding: 1rem 1.1rem;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }
  .status-item:hover {
    border-color: rgba(167, 139, 250, 0.45);
    background: rgba(22, 22, 27, 0.95);
    transform: translateY(-2px);
  }
  .status-item :global(.arrow) {
    color: #8a8a99;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .status-item:hover :global(.arrow) {
    color: #a78bfa;
    transform: translate(2px, -2px);
  }
  .where {
    display: inline-block;
    margin-top: 0.7rem;
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.12);
    padding: 0.2rem 0.6rem;
    font-size: 12px;
    font-weight: 600;
    color: #c4b5fd;
  }

  @media (prefers-reduced-motion: no-preference) {
    .status-list li {
      animation: row-in 0.6s ease both;
      animation-delay: calc(0.7s + var(--i) * 0.08s);
    }
    .hero-side {
      animation: row-in 0.7s ease 0.45s both;
    }
    .live::after {
      animation: ping 2.4s ease-out infinite;
    }
  }
  /* Solo transform: el texto se pinta desde el primer fotograma (es el LCP de la página) */
  @keyframes row-in {
    from {
      transform: translateY(14px);
    }
  }
  @keyframes ping {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }
</style>
