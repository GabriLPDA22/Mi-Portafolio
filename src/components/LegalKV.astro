---
interface Props {
  items: { label: string; value?: string; email?: boolean }[];
}
const EMAIL = 'gsaiz.bajo@gmail.com';
---

<dl class="mt-4 divide-y divide-white/[0.06] border-y border-white/[0.06]">
  {
    Astro.props.items.map(({ label, value, email }) => (
      <div class="grid gap-1 py-3.5 sm:grid-cols-[minmax(0,8.5rem)_1fr] sm:gap-6 sm:py-4">
        <dt class="text-[13px] font-medium text-ink/60">{label}</dt>
        <dd class="text-[15px] leading-relaxed text-ink/80">
          {email ? (
            <a href={`mailto:${EMAIL}`} class="text-ink underline decoration-white/20 underline-offset-[3px] transition-colors hover:text-acid hover:decoration-acid/40">
              {EMAIL}
            </a>
          ) : (
            value
          )}
        </dd>
      </div>
    ))
  }
</dl>
