---
/**
 * Pantalla de carga 8-bit: el monigote programando en su portátil + barra de progreso pixel.
 * Animación solo con CSS (fotogramas a 8 fps).
 */
import { MASCOT_PALETTE, MASCOT_TYPING } from '@/data/mascot';

interface Props {
  label: string;
  class?: string;
  /** Clases de tamaño del sprite. */
  size?: string;
}
const { label, class: className = '', size = 'h-[126px]' } = Astro.props;

const toRects = (rows: readonly string[]) => {
  const rects: string[] = [];
  rows.forEach((row, y) => {
    let x = 0;
    while (x < row.length) {
      const ch = row[x];
      let x2 = x;
      while (x2 < row.length && row[x2] === ch) x2++;
      const fill = MASCOT_PALETTE[ch];
      if (fill) rects.push(`<rect x="${x}" y="${y}" width="${x2 - x}" height="1" fill="${fill}"/>`);
      x = x2;
    }
  });
  return rects.join('');
};
// Secuencia de 8 pasos: teclea, alterna manos y parpadea de vez en cuando.
const sequence = [0, 1, 0, 1, 2, 0, 1, 3];
const frames = MASCOT_TYPING.map(toRects);
const W = MASCOT_TYPING[0][0].length;
const H = MASCOT_TYPING[0].length;
---

<div class:list={['pixel-loader flex flex-col items-center gap-4', className]} role="status" aria-live="polite">
  <svg viewBox={`0 0 ${W} ${H}`} shape-rendering="crispEdges" class:list={[size, 'w-auto']} aria-hidden="true">
    {sequence.map((f, i) => <g class="pl-frame" style={`--i:${i}`} set:html={frames[f]} />)}
  </svg>
  <div class="pl-bar" aria-hidden="true"><span></span></div>
  <p class="font-pixel text-[12px] uppercase tracking-widest text-acid">{label}<span class="pl-dots">...</span></p>
</div>

<style>
  .pl-frame {
    opacity: 0;
  }
  .pl-frame:first-child {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pl-frame {
      /* 8 fotogramas × 125 ms: cada uno visible solo en su octavo del ciclo */
      animation: pl-frame 1s steps(1) infinite;
      animation-delay: calc(var(--i) * 125ms - 1s);
    }
    .pl-bar span {
      animation: pl-fill 1.6s steps(12) infinite;
    }
    .pl-dots {
      animation: pl-blink 0.8s steps(1) infinite;
    }
  }
  @keyframes pl-frame {
    0% {
      opacity: 1;
    }
    12.5%,
    100% {
      opacity: 0;
    }
  }
  .pl-bar {
    width: 12rem;
    height: 14px;
    padding: 3px;
    background: #120e0b;
    box-shadow:
      0 -3px 0 #fff3e6,
      0 3px 0 #fff3e6,
      -3px 0 0 #fff3e6,
      3px 0 0 #fff3e6;
  }
  .pl-bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: repeating-linear-gradient(90deg, #f0b429 0 10px, transparent 10px 12px);
    transform-origin: left;
  }
  @keyframes pl-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes pl-blink {
    50% {
      opacity: 0;
    }
  }
</style>
