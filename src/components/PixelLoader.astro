---
/**
 * Pantalla de carga 8-bit: el monigote programando en su portátil + barra de progreso pixel.
 * Animación solo con CSS (fotogramas a 8 fps).
 */
import { MASCOT_PALETTE, MASCOT_TYPING } from '@/data/mascot';
import { pixelPaths } from '@/lib/pixel';

interface Props {
  label: string;
  class?: string;
  /** Clases de tamaño del sprite. */
  size?: string;
  /** Barra que se llena una sola vez (0 → 100 %) y termina en "¡Listo!" (pantalla de carga). */
  once?: boolean;
  /** Texto final en modo `once`. */
  readyLabel?: string;
}
const { label, class: className = '', size = 'h-[126px]', once = false, readyLabel = '¡Listo!' } = Astro.props;

// Secuencia de 8 pasos: teclea, alterna manos y parpadea de vez en cuando.
const sequence = [0, 1, 0, 1, 2, 0, 1, 3];
const frames = MASCOT_TYPING.map((f) => pixelPaths(f, MASCOT_PALETTE));
const W = MASCOT_TYPING[0][0].length;
const H = MASCOT_TYPING[0].length;
---

<div class:list={['pixel-loader flex flex-col items-center gap-4', className]} role="status" aria-live="polite">
  <svg viewBox={`0 0 ${W} ${H}`} shape-rendering="crispEdges" class:list={[size, 'w-auto']} aria-hidden="true">
    {sequence.map((f, i) => <g class="pl-frame" style={`--i:${i}`} set:html={frames[f]} />)}
  </svg>
  <div class:list={['pl-bar', once && 'pl-once']} aria-hidden="true"><span></span></div>
  {
    once ? (
      <p class="pl-once-text font-pixel text-[12px] uppercase tracking-widest text-acid">
        <span class="pl-loading">
          {label}
          <span class="pl-pct" aria-hidden="true" />
        </span>
        <span class="pl-ready text-ink">{readyLabel} ▶</span>
      </p>
    ) : (
      <p class="font-pixel text-[12px] uppercase tracking-widest text-acid">
        {label}
        <span class="pl-dots">...</span>
      </p>
    )
  }
</div>

<style>
  .pl-frame {
    opacity: 0;
  }
  .pl-frame:first-child {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pl-frame {
      /* 8 fotogramas × 125 ms: cada uno visible solo en su octavo del ciclo */
      animation: pl-frame 1s steps(1) infinite;
      animation-delay: calc(var(--i) * 125ms - 1s);
    }
    .pl-bar span {
      animation: pl-fill 1.6s steps(12) infinite;
    }
    .pl-dots {
      animation: pl-blink 0.8s steps(1) infinite;
    }
  }
  @keyframes pl-frame {
    0% {
      opacity: 1;
    }
    12.5%,
    100% {
      opacity: 0;
    }
  }
  .pl-bar {
    width: 12rem;
    height: 14px;
    padding: 3px;
    background: #120e0b;
    box-shadow:
      0 -3px 0 #fff3e6,
      0 3px 0 #fff3e6,
      -3px 0 0 #fff3e6,
      3px 0 0 #fff3e6;
  }
  .pl-bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: repeating-linear-gradient(90deg, #f0b429 0 10px, transparent 10px 12px);
    transform-origin: left;
  }
  /* Modo "una vez": 0 → 100 % en 1,6 s a saltos, contador con CSS y "¡Listo!" al final */
  @property --pl-p {
    syntax: '<integer>';
    initial-value: 0;
    inherits: false;
  }
  .pl-once span {
    width: 0;
    transform: none;
    animation: pl-width 1.6s steps(16) 0.1s forwards !important;
  }
  @keyframes pl-width {
    to {
      width: 100%;
    }
  }
  .pl-pct {
    margin-left: 0.6em;
    counter-reset: plp var(--pl-p);
    animation: pl-count 1.6s steps(16) 0.1s forwards;
  }
  .pl-pct::after {
    content: counter(plp) '%';
  }
  .pl-once-text {
    display: grid;
    justify-items: center;
  }
  .pl-once-text > span {
    grid-area: 1 / 1;
  }
  .pl-ready {
    visibility: hidden;
    animation: pl-show 0s linear 1.75s forwards;
  }
  .pl-loading {
    animation: pl-hide 0s linear 1.75s forwards;
  }
  @keyframes pl-count {
    to {
      --pl-p: 100;
    }
  }
  @keyframes pl-show {
    to {
      visibility: visible;
    }
  }
  @keyframes pl-hide {
    to {
      visibility: hidden;
    }
  }
  @keyframes pl-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes pl-blink {
    50% {
      opacity: 0;
    }
  }
</style>
