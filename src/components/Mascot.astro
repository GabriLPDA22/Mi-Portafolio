---
/**
 * Monigote pixel art animado (SVG generado en build, animación solo con CSS).
 * Respira (sube/baja 1 píxel) y parpadea cada pocos segundos.
 */
import { MASCOT_FRAMES, MASCOT_PALETTE } from '@/data/mascot';
import { pixelPaths } from '@/lib/pixel';

interface Props {
  class?: string;
  /** Texto alternativo; vacío = decorativo. */
  label?: string;
}
const { class: className = '', label } = Astro.props;

const W = MASCOT_FRAMES.idle[0].length;
const H = MASCOT_FRAMES.idle.length;

const idle = pixelPaths(MASCOT_FRAMES.idle, MASCOT_PALETTE);
const blink = pixelPaths(MASCOT_FRAMES.blink, MASCOT_PALETTE);
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  shape-rendering="crispEdges"
  class:list={['mascot', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <g class="mascot-body">
    <g class="mascot-idle" set:html={idle} />
    <g class="mascot-blink" set:html={blink} />
  </g>
</svg>

<style>
  .mascot {
    image-rendering: pixelated;
    overflow: visible;
  }
  .mascot-blink {
    opacity: 0;
  }
  /* Salto al hacer clic (lo activa el script añadiendo .is-jumping al svg) */
  :global(.mascot.is-jumping) {
    animation: mascot-jump 0.5s steps(5) both;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Respiración: 1 píxel de sprite arriba/abajo, a saltos (como un juego de 16 bits) */
    .mascot-body {
      animation: mascot-breathe 1.2s steps(1) infinite;
    }
    .mascot-blink {
      animation: mascot-blink 4.2s steps(1) infinite;
    }
    .mascot-idle {
      animation: mascot-open 4.2s steps(1) infinite;
    }
  }
  @keyframes mascot-jump {
    0%, 100% { transform: translateY(0); }
    40% { transform: translateY(-18%); }
    60% { transform: translateY(-18%); }
  }
  @keyframes mascot-breathe {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(1px); }
  }
  @keyframes mascot-blink {
    0%, 93% { opacity: 0; }
    94%, 97% { opacity: 1; }
    98% { opacity: 0; }
  }
  @keyframes mascot-open {
    0%, 93% { opacity: 1; }
    94%, 97% { opacity: 0; }
    98% { opacity: 1; }
  }
</style>
