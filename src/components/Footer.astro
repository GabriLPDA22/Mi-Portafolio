---
/** Pie: datos, enlaces legales y el guiño al minijuego (botón visible solo con JS). */
import Mascot from './Mascot.astro';
import { getT, localePath, type Locale } from '@/i18n';
import { getPro, LINKS } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const p = getPro(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-white/[0.07]">
  <div class="container-main flex flex-col gap-8 py-10 md:flex-row md:items-center md:justify-between">
    <div class="text-[14px] text-muted">
      <p class="font-semibold text-text">© {year} Gabriel Saiz</p>
      <p class="mt-1"><a href={`mailto:${LINKS.email}`} class="link">{LINKS.email}</a></p>
      <p class="mt-3 flex gap-5">
        <a href={localePath(locale, '/privacidad')} class="hover:text-text">{t.legalHub.privacy}</a>
        <a href={localePath(locale, '/aviso-legal')} class="hover:text-text">{t.legalHub.legalNotice}</a>
      </p>
    </div>

    <button type="button" data-arcade-open hidden class="egg" title={p.footer.konami}>
      <Mascot class="h-10 w-auto shrink-0" />
      <span>{p.footer.play}</span>
    </button>
  </div>
</footer>

<style>
  .egg {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px dashed rgba(237, 237, 242, 0.16);
    border-radius: 1rem;
    padding: 0.5rem 1rem 0.5rem 0.6rem;
    font-size: 14px;
    font-weight: 550;
    color: #8a8a99;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .egg:hover {
    border-color: rgba(167, 139, 250, 0.6);
    color: #ededf2;
  }
  .egg :global(svg) {
    image-rendering: pixelated;
  }
</style>
