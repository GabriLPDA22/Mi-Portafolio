---
import Logo from '@/components/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';

const year = new Date().getFullYear();
const social = [
  { label: 'LinkedIn', href: site.social.linkedin, icon: 'linkedin' },
  { label: 'GitHub', href: site.social.github, icon: 'github' },
  { label: 'Email', href: `mailto:${site.contact.email}`, icon: 'mail' },
] as const;
---

<footer class="theme-dark overflow-hidden">
  <div class="container-page flex flex-col gap-8 pt-16 pb-10 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <a href="/" aria-label={`${site.name}, ir al inicio`}><Logo /></a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">{site.role} · web y mobile con .NET, Vue 3 y React Native. {site.location}.</p>
    </div>
    <ul class="flex gap-2">
      {
        social.map((s) => (
          <li>
            <a
              href={s.href}
              target={s.icon === 'mail' ? undefined : '_blank'}
              rel={s.icon === 'mail' ? undefined : 'noopener me'}
              class="icon-btn size-12"
              data-cta={`footer-${s.icon}`}
            >
              <Icon name={s.icon} class="size-[1.1rem]" label={s.label} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <p
    class="-mb-[0.2em] text-center font-display text-[clamp(3.4rem,16.5vw,15rem)] leading-[0.85] font-extrabold tracking-[-0.06em] whitespace-nowrap text-lime select-none"
    aria-hidden="true"
  >
    {site.name}
  </p>
  <div class="relative border-t border-line bg-bg">
    <div class="container-page flex flex-col gap-3 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.fullName}. Hecho a mano con Astro.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href="/politica-privacidad" class="hover:text-fg">Privacidad</a></li>
        <li><a href="/politica-cookies" class="hover:text-fg">Cookies</a></li>
        <li><button type="button" class="cursor-pointer hover:text-fg" data-cookie-settings>Configurar cookies</button></li>
      </ul>
    </div>
  </div>
</footer>
