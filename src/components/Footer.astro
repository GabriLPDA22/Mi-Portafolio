---
import Logo from '@/components/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';

const year = new Date().getFullYear();
const social = [
  { label: 'LinkedIn', href: site.social.linkedin, icon: 'linkedin' },
  { label: 'GitHub', href: site.social.github, icon: 'github' },
  { label: 'Email', href: `mailto:${site.contact.email}`, icon: 'mail' },
] as const;
---

<footer class="border-t border-line bg-ink-2">
  <div class="container-page flex flex-col gap-8 py-12 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <a href="/" aria-label={`${site.name}, ir al inicio`}><Logo /></a>
      <p class="mt-3 text-sm text-muted">{site.role} · {site.location}</p>
    </div>
    <ul class="flex gap-2">
      {
        social.map((s) => (
          <li>
            <a
              href={s.href}
              target={s.icon === 'mail' ? undefined : '_blank'}
              rel={s.icon === 'mail' ? undefined : 'noopener me'}
              class="inline-flex size-11 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-line-strong hover:text-fg"
              data-cta={`footer-${s.icon}`}
            >
              <Icon name={s.icon} class="size-[1.1rem]" label={s.label} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="overflow-hidden" aria-hidden="true">
    <p
      class="bg-word !static -mb-[0.18em] block text-center !text-[clamp(3.2rem,15.5vw,14rem)] ![mask-image:linear-gradient(to_bottom,#000_40%,transparent_100%)]"
    >
      {site.name}
    </p>
  </div>
  <div class="border-t border-line">
    <div class="container-page flex flex-col gap-3 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.fullName}. Hecho a mano con Astro.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href="/politica-privacidad" class="hover:text-fg">Privacidad</a></li>
        <li><a href="/politica-cookies" class="hover:text-fg">Cookies</a></li>
        <li><button type="button" class="cursor-pointer hover:text-fg" data-cookie-settings>Configurar cookies</button></li>
      </ul>
    </div>
  </div>
</footer>
