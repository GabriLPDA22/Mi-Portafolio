---
import Logo from '@/components/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, whatsappUrl, PHONE_PLACEHOLDER } from '@/config/site';
import { services } from '@/data/services';

const year = new Date().getFullYear();

const company = [
  { label: 'Diseño web en Zaragoza', href: '/diseno-web-zaragoza' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Precios', href: '/servicios#precios' },
  { label: 'Contacto', href: '/contacto' },
];

const legal = [
  { label: 'Aviso legal', href: '/aviso-legal' },
  { label: 'Privacidad', href: '/politica-privacidad' },
  { label: 'Cookies', href: '/politica-cookies' },
];
---

<footer class="relative border-t border-line bg-ink-2">
  <div class="container-page grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-4">
      <a href="/" aria-label="GabrielCodes, ir a la página de inicio"><Logo /></a>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-muted">
        Estudio de diseño y desarrollo web en Zaragoza. Webs rápidas, optimizadas para Google y pensadas para que tus
        clientes te contacten.
      </p>
      <address class="mt-6 grid gap-3 text-sm not-italic text-soft">
        <a href={`mailto:${site.contact.email}`} class="inline-flex items-center gap-3 hover:text-accent">
          <Icon name="mail" class="size-4 text-accent" />
          {site.contact.email}
        </a>
        {
          !PHONE_PLACEHOLDER && (
            <a href={`tel:+${site.contact.phoneE164}`} class="inline-flex items-center gap-3 hover:text-accent">
              <Icon name="phone" class="size-4 text-accent" />
              {site.contact.phoneDisplay}
            </a>
          )
        }
        <a href={whatsappUrl()} class="inline-flex items-center gap-3 hover:text-accent" rel="noopener" target="_blank">
          <Icon name="messageCircle" class="size-4 text-accent" />
          WhatsApp
        </a>
        <span class="inline-flex items-center gap-3">
          <Icon name="mapPin" class="size-4 text-accent" />
          {site.address.locality}, {site.address.region}
        </span>
        <span class="inline-flex items-center gap-3">
          <Icon name="clock" class="size-4 text-accent" />
          {site.openingHours.display}
        </span>
      </address>
    </div>

    <nav aria-label="Servicios" class="md:col-span-3 md:col-start-6">
      <p class="text-sm font-semibold text-fg">Servicios</p>
      <ul class="mt-4 grid gap-3 text-sm">
        {
          services.map((s) => (
            <li>
              <a href={s.path} class="text-muted transition-colors hover:text-fg">
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Estudio" class="md:col-span-2">
      <p class="text-sm font-semibold text-fg">Estudio</p>
      <ul class="mt-4 grid gap-3 text-sm">
        {
          company.map((l) => (
            <li>
              <a href={l.href} class="text-muted transition-colors hover:text-fg">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="md:col-span-2">
      <p class="text-sm font-semibold text-fg">Síguenos</p>
      <ul class="mt-4 flex gap-2">
        <li>
          <a
            href={site.social.instagram.url}
            target="_blank"
            rel="noopener me"
            class="inline-flex size-10 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-line-strong hover:text-fg"
            data-cta="footer-instagram"
          >
            <Icon name="instagram" class="size-4" label="Instagram" />
          </a>
        </li>
        <li>
          <a
            href={site.founder.linkedin}
            target="_blank"
            rel="noopener me"
            class="inline-flex size-10 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-line-strong hover:text-fg"
          >
            <Icon name="linkedin" class="size-4" label="LinkedIn" />
          </a>
        </li>
        <li>
          <a
            href={site.founder.github}
            target="_blank"
            rel="noopener me"
            class="inline-flex size-10 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-line-strong hover:text-fg"
          >
            <Icon name="github" class="size-4" label="GitHub" />
          </a>
        </li>
      </ul>
      <a href={site.social.instagram.url} target="_blank" rel="noopener" class="mt-4 inline-block text-sm text-muted hover:text-fg">
        @{site.social.instagram.handle}
      </a>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-page py-6">
      <p class="text-xs leading-relaxed text-muted">
        Diseño y desarrollo web para negocios en {site.areaServed.slice(0, 8).join(', ')} y el resto de la provincia de Zaragoza.
      </p>
      <div class="mt-4 flex flex-col gap-3 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} {site.name}. Todos los derechos reservados.</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            legal.map((l) => (
              <li>
                <a href={l.href} class="hover:text-fg">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>
            <button type="button" class="cursor-pointer hover:text-fg" data-cookie-settings>Configurar cookies</button>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
