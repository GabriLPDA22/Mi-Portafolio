---
/**
 * Contacto como diálogo de RPG: el monigote (NPC) habla con texto que se escribe solo y ofrece
 * opciones (escribir, CV, email… o "ahora no", que tiene respuesta). Debajo, el formulario
 * (Formspree) como "carta". Sin JS el texto se ve completo y las opciones son enlaces normales.
 */
import Icon from './Icon.astro';
import Footer from './Footer.astro';
import Mascot from './Mascot.astro';
import PixelLoader from './PixelLoader.astro';
import GameHeading from './GameHeading.astro';
import { gameLabels, getT, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const g = gameLabels[locale];
const es = locale === 'es';
const f = t.contact.form;

const lines = {
  intro: `${t.contact.headline} ${t.contact.subtitle}`,
  no: es
    ? '¡Sin problema! Te dejo el CV por si cambias de idea. Aquí estaré cuando quieras formar equipo.'
    : "No problem! Here's my CV in case you change your mind. I'll be here when you want to team up.",
  yes: es ? '¡Genial! Rellena la carta de aquí abajo y te respondo en menos de 24 h.' : "Great! Fill in the letter below and I'll reply within 24 h.",
};
const stats = [t.contact.badges.response, t.contact.badges.free, t.contact.badges.noCommitment];
const options = ['mobile', 'web', 'ecommerce', 'saas', 'consulting', 'other'] as const;
const msgFailed = es
  ? 'Hubo un error al enviar el mensaje. Por favor, intenta de nuevo o escríbeme directamente a gsaiz.bajo@gmail.com'
  : 'There was an error sending your message. Please try again or email me directly at gsaiz.bajo@gmail.com';

const input =
  'w-full rounded-xl border-[3px] border-noir bg-noir px-4 py-3.5 text-[15px] text-ink placeholder-white/40 outline-none shadow-[inset_0_3px_0_rgba(0,0,0,0.35)] transition-colors duration-200 focus:border-acid';
const label = 'font-pixel mb-2 block text-[10px] uppercase tracking-wider text-ink/70';
---

<section id="contacto" class="relative scroll-mt-24 pt-20 sm:pt-28">
  <div class="container-main pb-20 sm:pb-28">
    <GameHeading level={`${g.level} 06`} eyebrow={g.contact} title={t.contact.title} align="center" />

    <div class="mx-auto flex max-w-[52rem] flex-col gap-8">
      <!-- Diálogo del NPC -->
      <div data-dialog data-line-no={lines.no} data-line-yes={lines.yes} class="dialog">
        <div class="dialog-head">
          <div class="dialog-portrait" aria-hidden="true">
            <Mascot class="h-[92px] w-auto sm:h-[110px]" />
          </div>
          <p class="dialog-name name-mobile font-pixel">Gabriel</p>
        </div>
        <div class="min-w-0 flex-1">
          <p class="dialog-name name-desk font-pixel">Gabriel</p>
          <p class="relative pb-1 pr-5 text-[16px] font-semibold leading-relaxed text-noir sm:text-[17px]">
            <span data-dialog-text>{lines.intro}</span>
            <span data-dialog-typed aria-hidden="true" class="absolute inset-0 pr-5"></span>
            <span class="dialog-caret" aria-hidden="true">▼</span>
          </p>

          <ul class="mt-3 flex flex-wrap gap-2" aria-label={es ? 'Estado' : 'Status'}>
            {stats.map((s) => <li class="font-pixel rounded-md bg-noir/10 px-2 py-1 text-[9.5px] uppercase tracking-wider text-noir/75">{s}</li>)}
          </ul>

          <ul class="choices mt-5 grid gap-1.5 sm:grid-cols-2">
            <li>
              <a href="#contacto-form" data-choice-yes class="choice">{es ? 'Sí, escribir un mensaje' : 'Yes, send a message'}</a>
            </li>
            <li>
              <a href="/cv/Gabriel-Saiz-CV.pdf" download="Gabriel-Saiz-CV.pdf" class="choice">{t.hero.ctaCv}</a>
            </li>
            <li>
              <a href="mailto:gsaiz.bajo@gmail.com" class="choice">{es ? 'Mejor por email' : 'Email is better'}</a>
            </li>
            <li>
              <button type="button" data-choice-no hidden class="choice">{es ? 'Ahora no' : 'Not now'}</button>
            </li>
          </ul>
        </div>
      </div>

      <!-- Formulario (Formspree) -->
      <div id="contacto-form" data-contact data-msg-required={f.error} data-msg-failed={msgFailed} class="relative scroll-mt-28">
        <div class="game-panel relative p-5 sm:p-8">
          <p class="pixel-tag absolute -top-3 left-5 border-2 border-acid text-acid">✉ {f.title}</p>

          <!-- Pantalla de carga 8-bit mientras se envía -->
          <div data-contact-sending hidden class="absolute inset-0 z-10 flex items-center justify-center rounded-[1.2rem] bg-noir">
            <PixelLoader label={f.sending.replace(/\.+$/, '')} />
          </div>

          <div data-contact-success hidden class="py-12 text-center" role="status">
            <p class="font-pixel mb-3 text-[12px] uppercase tracking-widest text-acid">{es ? 'Misión cumplida' : 'Quest complete'}</p>
            <h3 class="game-title mb-3 text-3xl">{f.success.title}</h3>
            <p class="text-[15px] text-ink/70">{f.success.message}</p>
            <button type="button" data-contact-again class="game-btn game-btn-ghost mt-6">
              {f.success.again}
            </button>
          </div>

          <form action="https://formspree.io/f/mrezlekq" method="POST" class="space-y-5 pt-2">
            <p class="text-[14px] leading-relaxed text-ink/65">{f.description}</p>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class={label}>{f.name}</label>
                <input type="text" id="name" name="name" required autocomplete="name" class={input} placeholder={es ? 'Tu nombre' : 'Your name'} />
              </div>
              <div>
                <label for="email" class={label}>{f.email}</label>
                <input type="email" id="email" name="email" required autocomplete="email" class={input} placeholder={es ? 'tu@email.com' : 'you@email.com'} />
              </div>
            </div>

            <div>
              <label for="project" class={label}>{f.project}</label>
              <div class="relative">
                <select id="project" name="project" class:list={[input, 'appearance-none pr-10']}>
                  <option value="" class="bg-noir-elevated">{f.projectOptions.select}</option>
                  {options.map((o) => <option value={o} class="bg-noir-elevated">{f.projectOptions[o]}</option>)}
                </select>
                <Icon name="ChevronDown" class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-acid" strokeWidth={3} />
              </div>
            </div>

            <div>
              <label for="message" class={label}>{f.message}</label>
              <textarea id="message" name="message" required rows="5" class:list={[input, 'resize-none']} placeholder={f.messagePlaceholder}></textarea>
            </div>

            <div data-contact-error hidden role="alert" class="flex items-center gap-2 rounded-xl border-2 border-red-500/30 bg-red-500/10 px-4 py-3 text-[13px] text-red-300">
              <Icon name="AlertCircle" class="h-4 w-4 flex-shrink-0" />
              <span data-error-text></span>
            </div>

            <button type="submit" class="start-btn w-full justify-center text-[16px] font-black uppercase disabled:cursor-not-allowed disabled:opacity-60">
              <span data-idle class="flex items-center gap-2">
                {f.send}
                <Icon name="Send" class="h-4 w-4" strokeWidth={2.2} />
              </span>
              <span data-loading hidden class="flex items-center gap-2">
                <Icon name="Loader2" class="h-4 w-4 animate-spin" />
                {f.sending}
              </span>
            </button>

            <p class="text-center text-[12px] text-ink/60">
              {f.support}{' '}
              <a href="mailto:gsaiz.bajo@gmail.com" class="font-semibold text-acid transition-colors hover:text-acid-light">gsaiz.bajo@gmail.com</a>
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <Footer locale={locale} />
</section>

<style>
  /* Caja de diálogo clásica: fondo claro, borde doble */
  .dialog {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: 1.2rem;
    background: #fff3e6;
    padding: 1.1rem 1.1rem 1.25rem;
    box-shadow:
      0 0 0 3px #0a0706,
      inset 0 0 0 3px #fff3e6,
      inset 0 0 0 6px #d4921f,
      0 8px 0 3px #0a0706;
  }
  @media (min-width: 640px) {
    .dialog {
      flex-direction: row;
      align-items: flex-start;
      gap: 1.5rem;
      padding: 1.6rem 1.75rem 1.75rem;
    }
  }
  /* Móvil: el monigote asoma de pie sobre el borde superior de la caja */
  .dialog {
    margin-top: 3.5rem;
  }
  .dialog-head {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin-top: -4.9rem;
  }
  .dialog-portrait {
    flex-shrink: 0;
    filter: drop-shadow(0 3px 0 #0a0706);
  }
  .name-desk {
    display: none !important;
  }
  @media (min-width: 640px) {
    .name-mobile {
      display: none !important;
    }
    .name-desk {
      display: inline-block !important;
    }
  }
  .dialog-head .dialog-name {
    margin-bottom: 0.35rem;
  }
  /* Escritorio: retrato enmarcado a la izquierda */
  @media (min-width: 640px) {
    .dialog {
      margin-top: 0;
    }
    .dialog-head {
      margin-top: 0;
    }
    .dialog-portrait {
      display: grid;
      place-items: end center;
      height: 136px;
      width: 136px;
      overflow: hidden;
      border-radius: 0.9rem;
      border: 3px solid #0a0706;
      background:
        linear-gradient(180deg, transparent 62%, #6b4a2e 62%, #6b4a2e 66%, #4a3320 66%),
        linear-gradient(180deg, #3a2a1c, #221a14);
      box-shadow: 0 4px 0 #0a0706;
      filter: none;
    }
  }
  .dialog-name {
    display: inline-block;
    margin-bottom: 0.6rem;
    border-radius: 0.4rem;
    background: #120e0b;
    color: #f0b429;
    padding: 0.3rem 0.6rem;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .dialog-caret {
    position: absolute;
    right: 0;
    bottom: 0.2rem;
    font-size: 0.7em;
    color: #d4921f;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dialog-caret {
      display: inline-block;
      animation: caret-bob 0.8s steps(2) infinite;
    }
  }
  @keyframes caret-bob {
    50% {
      transform: translateY(3px);
    }
  }
  :global(.dialog.is-typing) .dialog-caret {
    visibility: hidden;
  }

  /* Opciones de menú con cursor ▶ */
  .choice {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.6rem;
    padding: 0.6rem 0.7rem;
    text-align: left;
    font-size: 15px;
    font-weight: 800;
    color: #120e0b;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .choice[hidden] {
    display: none;
  }
  .choice::before {
    content: '▶';
    font-size: 0.75em;
    color: #d4921f;
    opacity: 0.35;
  }
  .choice:hover,
  .choice:focus-visible {
    background: #120e0b;
    color: #fff3e6;
    outline: none;
  }
  .choice:hover::before,
  .choice:focus-visible::before {
    opacity: 1;
    color: #f0b429;
  }
</style>
