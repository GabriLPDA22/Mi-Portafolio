---
/**
 * Mockup de dispositivos construido con HTML/CSS: nítido en cualquier pantalla,
 * sin peticiones de imagen y sin impacto en LCP. Es decorativo (aria-hidden).
 */
const days = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
const slots = ['10:00', '11:30', '13:00', '16:30', '17:30', '19:00'];
---

<div class="relative mx-auto w-full max-w-[36rem] lg:max-w-none" aria-hidden="true">
  <!-- Navegador -->
  <div class="relative overflow-hidden rounded-2xl border border-line-strong bg-ink-2 shadow-2xl shadow-black/60">
    <div class="flex items-center gap-2 border-b border-line bg-surface px-4 py-3">
      <span class="size-2.5 rounded-full bg-white/15"></span>
      <span class="size-2.5 rounded-full bg-white/15"></span>
      <span class="size-2.5 rounded-full bg-white/15"></span>
      <span class="ml-3 flex h-6 flex-1 items-center gap-2 rounded-md bg-white/[0.04] px-3 text-[0.65rem] text-muted">
        <svg viewBox="0 0 24 24" class="size-3 text-accent" fill="none" stroke="currentColor" stroke-width="2"
          ><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg
        >
        tunegocio.es
      </span>
    </div>
    <div class="relative p-5 sm:p-7">
      <div class="flex items-center justify-between">
        <span class="h-2.5 w-20 rounded-full bg-white/80"></span>
        <span class="hidden gap-3 sm:flex">
          <span class="h-2 w-10 rounded-full bg-white/15"></span>
          <span class="h-2 w-10 rounded-full bg-white/15"></span>
          <span class="h-2 w-10 rounded-full bg-white/15"></span>
        </span>
        <span class="h-6 w-16 rounded-full bg-accent"></span>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-5">
        <div class="sm:col-span-3">
          <span class="block h-2 w-24 rounded-full bg-accent/60"></span>
          <span class="mt-4 block h-4 w-[92%] rounded-md bg-white/85"></span>
          <span class="mt-2 block h-4 w-[70%] rounded-md bg-white/85"></span>
          <span class="mt-4 block h-2 w-[88%] rounded-full bg-white/15"></span>
          <span class="mt-2 block h-2 w-[64%] rounded-full bg-white/15"></span>
          <span class="mt-6 flex gap-2">
            <span class="h-8 w-28 rounded-full bg-accent"></span>
            <span class="h-8 w-24 rounded-full border border-white/20"></span>
          </span>
        </div>
        <div class="hidden rounded-xl bg-gradient-to-br from-accent/25 via-accent/5 to-transparent sm:col-span-2 sm:block"></div>
      </div>
      <div class="mt-8 grid grid-cols-3 gap-3">
        {
          [0, 1, 2].map(() => (
            <span class="rounded-xl border border-line bg-white/[0.02] p-3">
              <span class="block size-6 rounded-lg bg-accent/20" />
              <span class="mt-3 block h-2 w-[80%] rounded-full bg-white/40" />
              <span class="mt-2 block h-1.5 w-[60%] rounded-full bg-white/10" />
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Móvil con reservas -->
  <div
    class="absolute -right-2 -bottom-10 w-[38%] max-w-[11.5rem] rounded-[1.75rem] border border-line-strong bg-ink p-1.5 shadow-2xl shadow-black/80 motion-safe:animate-[float-slow_7s_ease-in-out_infinite] sm:-right-6"
  >
    <div class="overflow-hidden rounded-[1.4rem] bg-surface p-3">
      <span class="mx-auto block h-1.5 w-10 rounded-full bg-white/15"></span>
      <p class="mt-3 text-[0.6rem] font-semibold text-fg">Reserva tu cita</p>
      <div class="mt-2 grid grid-cols-7 gap-0.5 text-center text-[0.45rem] text-muted">
        {days.map((d) => <span>{d}</span>)}
        {
          Array.from({ length: 14 }, (_, i) => (
            <span
              class:list={[
                'rounded-[3px] py-0.5 text-[0.5rem]',
                i === 9 ? 'bg-accent font-semibold text-accent-ink' : 'text-soft',
              ]}
            >
              {i + 8}
            </span>
          ))
        }
      </div>
      <div class="mt-2.5 grid grid-cols-2 gap-1">
        {
          slots.map((s, i) => (
            <span
              class:list={[
                'rounded-md border py-1 text-center text-[0.5rem]',
                i === 4 ? 'border-accent bg-accent/15 text-accent' : 'border-line text-soft',
              ]}
            >
              {s}
            </span>
          ))
        }
      </div>
      <span class="mt-2.5 block rounded-full bg-accent py-1.5 text-center text-[0.55rem] font-semibold text-accent-ink">Confirmar</span>
    </div>
  </div>

  <!-- Notificación -->
  <div
    class="absolute top-[38%] -left-3 flex items-center gap-3 rounded-2xl border border-line-strong bg-ink-2/95 p-3 pr-4 shadow-xl shadow-black/60 backdrop-blur sm:-left-8"
  >
    <span class="inline-flex size-8 items-center justify-center rounded-full bg-accent/15 text-accent">
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg>
    </span>
    <span>
      <span class="block text-[0.7rem] font-semibold text-fg">Nueva reserva</span>
      <span class="block text-[0.65rem] text-muted">Hoy · 17:30</span>
    </span>
  </div>

  <!-- Puntuación de rendimiento -->
  <div
    class="absolute -top-5 right-6 flex items-center gap-2.5 rounded-2xl border border-line-strong bg-ink-2/95 px-3 py-2 shadow-xl shadow-black/60 backdrop-blur"
  >
    <span class="relative inline-flex size-9 items-center justify-center">
      <svg viewBox="0 0 36 36" class="absolute inset-0 -rotate-90"
        ><circle cx="18" cy="18" r="15.5" fill="none" stroke="rgb(0 230 118 / 0.15)" stroke-width="3"></circle><circle
          cx="18"
          cy="18"
          r="15.5"
          fill="none"
          stroke="#00E676"
          stroke-width="3"
          stroke-dasharray="97.4"
          stroke-dashoffset="2"
          stroke-linecap="round"></circle></svg
      >
      <span class="text-[0.65rem] font-bold text-accent">98</span>
    </span>
    <span class="text-[0.65rem] leading-tight text-muted">Velocidad<br /><span class="text-fg">en móvil</span></span>
  </div>
</div>
