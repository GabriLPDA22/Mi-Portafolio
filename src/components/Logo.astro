---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 32 32" class="size-8" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9" fill="#00E676"></rect>
    <path d="M13 10.5 8 16l5 5.5M19 10.5l5 5.5-5 5.5" fill="none" stroke="#09090B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="text-[1.05rem] font-semibold tracking-tight text-fg">gabriel<span class="text-accent">codes</span></span>
</span>
