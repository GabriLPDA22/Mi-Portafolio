---
/**
 * Proyectos como tarjetas que se apilan al hacer scroll (sticky en escritorio; motion.ts encoge
 * y oscurece la de debajo con un velo, solo transform/opacity). Cada proyecto se muestra en el
 * soporte que le toca, centrado: ARCH con su icono de app, Huvegrym en un móvil y Tarot
 * Divinidad en un navegador con su dominio real.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import SectionHead from './ui/SectionHead.astro';
import archImg from '@/assets/img/arch-icon.webp';
import huvegrymImg from '@/assets/img/Huvegrym.webp';
import tarotImg from '@/assets/img/divinidad-hero.webp';
import { getT, type Locale } from '@/i18n';
import { getPro } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const bug = getPro(locale).projects.bugrun;
const es = locale === 'es';

type Meta = { img: ImageMetadata; alt: string; kind: string; status: string; url?: string; domain?: string; tint: string; app?: boolean; phone?: boolean };
const meta: Record<string, Meta> = {
  arch: {
    img: archImg,
    alt: es
      ? 'ARCH App iOS - Aplicación móvil para comunidad de Oxford University desarrollada con React Native y Expo'
      : 'ARCH iOS app - Mobile app for an Oxford University community, built with React Native and Expo',
    kind: es ? 'App iOS' : 'iOS app',
    status: es ? 'En producción' : 'Live',
    url: 'https://apps.apple.com/us/app/the-arch/id6753820007',
    tint: 'rgba(99, 102, 241, 0.35)',
    app: true,
  },
  huvegrym: {
    img: huvegrymImg,
    alt: es ? 'Huvegrym - Sitio web de escuela de danza, optimizado para SEO y rendimiento' : 'Huvegrym - Dance school website, optimized for SEO and performance',
    kind: 'Web',
    status: 'Online',
    url: 'https://huvegrym.es',
    domain: 'huvegrym.es',
    tint: 'rgba(139, 92, 246, 0.28)',
    phone: true,
  },
  'tarot-divinidad': {
    img: tarotImg,
    alt: es ? 'Tarot Divinidad — web de consultas de tarot con reservas y WhatsApp' : 'Tarot Divinidad — tarot reading website with bookings and WhatsApp',
    kind: 'Web',
    status: 'Online',
    url: 'https://divinidad000.com',
    domain: 'divinidad000.com',
    tint: 'rgba(192, 38, 211, 0.26)',
  },
};

const projects = t.projects.items.map((item, i) => ({
  ...item,
  n: String(i + 1).padStart(2, '0'),
  m: meta[item.id],
  secondary: 'secondaryCta' in item && item.secondaryCta ? (item.secondaryCta as string) : undefined,
}));
---

<section id="proyectos" class="section">
  <div class="container-main">
    <SectionHead
      badge={es ? 'Proyectos' : 'Projects'}
      title={t.projects.headline}
      serif={es ? ['producción'] : ['production']}
      lead={t.projects.subtitle}
    />

    <div class="mt-14 flex flex-col gap-5 sm:mt-20 lg:gap-8">
      {
        projects.map((p, i) => (
          <article class="project card overflow-hidden" data-stack style={`--i:${i}; --tint:${p.m.tint}`}>
            <div class="grid lg:min-h-[34rem] lg:grid-cols-[1.05fr_1fr]">
              <!-- Texto -->
              <div class="flex flex-col gap-6 p-6 sm:p-9 lg:p-11">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="serif mr-1 text-2xl text-acid">{p.n}</span>
                  <span class="chip">{p.m.kind}</span>
                  <span class="chip !text-ink/80">
                    <span class="dot-live mr-2 !h-1.5 !w-1.5" />
                    {p.m.status}
                  </span>
                </div>
                <div>
                  <h3 class="text-[clamp(2.2rem,6.5vw,3.75rem)] font-semibold leading-[0.95] tracking-[-0.045em] text-metal">{p.title}</h3>
                  <p class="mt-3 text-[16px] text-ink/70">{p.subtitle}</p>
                  <p class="mt-2 text-[14.5px] leading-relaxed text-ink/50">{p.description}</p>
                </div>
                <ul class="grid gap-x-6 gap-y-2.5 text-[14px] text-ink/75 sm:grid-cols-2">
                  {p.bullets.map((b) => (
                    <li class="flex items-start gap-2.5">
                      <Icon name="Check" class="mt-[3px] h-3.5 w-3.5 shrink-0 text-acid" strokeWidth={2.6} />
                      {b}
                    </li>
                  ))}
                </ul>
                <div class="flex flex-wrap gap-1.5">
                  {p.chips.map((c) => (
                    <span class="chip">{c}</span>
                  ))}
                </div>
                <div class="mt-auto flex flex-col gap-3 pt-2 sm:flex-row sm:items-center">
                  <a href={p.m.url} target="_blank" rel="noopener noreferrer" data-umami-event={p.m.app ? 'app-store' : 'ver-web'} data-umami-event-proyecto={p.title} class="btn btn-volt justify-between sm:justify-center">
                    {p.cta}
                    <span class="btn-icon">
                      <Icon name="ArrowUpRight" class="h-4 w-4" strokeWidth={2.4} />
                    </span>
                  </a>
                  {p.secondary && (
                    <a href="#contacto" class="btn btn-ghost">
                      {p.secondary}
                    </a>
                  )}
                </div>
              </div>

              <!-- Imagen: centrada en su panel, en el soporte de cada proyecto -->
              <div class="media relative order-first grid min-h-[17rem] place-items-center overflow-hidden border-b border-white/[0.06] px-6 py-10 sm:min-h-[24rem] sm:px-10 sm:py-12 lg:order-none lg:border-b-0 lg:border-l">
                <div class="media-glow" aria-hidden="true" />
                {p.m.app ? (
                  <Picture
                    src={p.m.img}
                    alt={p.m.alt}
                    widths={[240, 360, 480]}
                    sizes="(min-width: 1024px) 280px, 200px"
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    class="app-icon relative w-[min(48%,15rem)] rounded-[22%]"
                    loading="lazy"
                  />
                ) : p.m.phone ? (
                  <div class="device phone relative w-[min(56%,15rem)]">
                    <span class="phone-notch" aria-hidden="true" />
                    <Picture
                      src={p.m.img}
                      alt={p.m.alt}
                      widths={[320, 480, 640]}
                      sizes="(min-width: 1024px) 240px, 50vw"
                      formats={['avif', 'webp']}
                      fallbackFormat="webp"
                      class="aspect-[9/17] w-full rounded-[1.6rem] object-cover object-[50%_35%]"
                      loading="lazy"
                    />
                    <span class="device-url" aria-hidden="true">
                      <Icon name="Lock" class="h-2.5 w-2.5" />
                      {p.m.domain}
                    </span>
                  </div>
                ) : (
                  <div class="device browser relative w-full max-w-[36rem] overflow-hidden rounded-2xl">
                    <div class="flex items-center gap-2 border-b border-white/[0.07] bg-[#121216] px-4 py-2.5">
                      <span class="h-2.5 w-2.5 rounded-full bg-white/15" />
                      <span class="h-2.5 w-2.5 rounded-full bg-white/15" />
                      <span class="h-2.5 w-2.5 rounded-full bg-white/15" />
                      <span class="mx-auto flex items-center gap-1.5 rounded-full bg-white/[0.05] px-3 py-1 text-[11.5px] text-ink/60">
                        <Icon name="Lock" class="h-3 w-3" />
                        {p.m.domain}
                      </span>
                    </div>
                    <Picture
                      src={p.m.img}
                      alt={p.m.alt}
                      widths={[480, 720, 960, 1200]}
                      sizes="(min-width: 1024px) 576px, 90vw"
                      formats={['avif', 'webp']}
                      fallbackFormat="webp"
                      class="block h-auto w-full"
                      loading="lazy"
                    />
                  </div>
                )}
              </div>
            </div>
            <span class="veil" aria-hidden="true" />
          </article>
        ))
      }
    </div>

    <!-- Proyecto personal: el minijuego escondido (el botón solo aparece con JS) -->
    <aside class="card spotlight mt-5 flex flex-col gap-5 p-6 sm:p-8 lg:mt-8 lg:flex-row lg:items-center lg:gap-10" data-reveal>
      <div class="flex shrink-0 items-center gap-3">
        <span class="grid h-12 w-12 place-items-center rounded-2xl border border-acid/25 bg-acid/[0.07] text-acid">
          <Icon name="Gamepad2" class="h-5 w-5" strokeWidth={1.8} />
        </span>
        <div>
          <p class="font-pixel text-[15px] tracking-wide text-ink">{bug.name}</p>
          <p class="text-[12.5px] text-ink/60">{bug.kind}</p>
        </div>
      </div>
      <p class="flex-1 text-[14.5px] leading-relaxed text-ink/70">{bug.text}</p>
      <div class="flex flex-wrap items-center gap-1.5 lg:max-w-[14rem]">
        {bug.stack.map((c) => <span class="chip">{c}</span>)}
      </div>
      <button type="button" data-arcade-open hidden data-umami-event="jugar-bug-run" class="btn btn-ghost has-icon shrink-0 justify-between">
        {bug.play}
        <span class="btn-icon"><Icon name="ArrowUpRight" class="h-4 w-4" strokeWidth={2.2} /></span>
      </button>
    </aside>
  </div>
</section>

<style>
  /* Apilado solo si la tarjeta cabe entera en pantalla */
  @media (min-width: 1024px) and (min-height: 760px) {
    .project {
      position: sticky;
      top: calc(6.5rem + var(--i) * 1.5rem);
      transform-origin: 50% 0;
      will-change: transform;
    }
  }
  .media {
    background:
      radial-gradient(70% 70% at 50% 60%, var(--tint), transparent 70%),
      linear-gradient(180deg, #0f0f13, #0a0a0d);
  }
  .media-glow {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 20%, transparent 70%);
    mask-image: radial-gradient(ellipse at center, #000 20%, transparent 70%);
  }
  .device {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 40px 80px -30px rgba(0, 0, 0, 0.9),
      0 0 90px -20px var(--tint);
    transition: transform 1s var(--ease-out-expo);
  }
  .browser {
    background: #0d0d10;
  }
  .phone {
    border-radius: 2.1rem;
    padding: 0.45rem;
    background: linear-gradient(160deg, #26262d, #111115);
  }
  .phone-notch {
    position: absolute;
    left: 50%;
    top: 0.95rem;
    z-index: 1;
    width: 28%;
    height: 0.95rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #050506;
  }
  .device-url {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transform: translateX(-50%);
    border-radius: 999px;
    padding: 0.3rem 0.65rem;
    font-size: 10.5px;
    color: rgba(237, 237, 242, 0.85);
    white-space: nowrap;
    background: rgba(12, 12, 15, 0.75);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .project:hover .device {
    transform: translateY(-6px);
  }
  /* Velo que oscurece la tarjeta tapada (opacity: se compone en la GPU, sin repintar) */
  .veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: #000;
    opacity: 0;
    will-change: opacity;
    border-radius: inherit;
  }
  .app-icon {
    box-shadow:
      0 30px 60px -20px rgba(124, 58, 237, 0.45),
      0 0 60px -10px rgba(139, 92, 246, 0.3);
    transition: transform 1s var(--ease-out-expo);
  }
  .project:hover .app-icon {
    transform: translateY(-6px) rotate(-3deg);
  }
</style>
