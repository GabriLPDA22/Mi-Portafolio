---
/**
 * Proyectos como tarjetas que se apilan al hacer scroll (sticky en escritorio; motion.ts encoge
 * y oscurece la de debajo con un velo, solo transform/opacity). Cada proyecto tiene una portada
 * cuadrada con el estilo de la web (scripts/project-covers.mjs) que rellena su panel entero.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import SectionHead from './ui/SectionHead.astro';
import archImg from '@/assets/img/projects/arch.webp';
import huvegrymImg from '@/assets/img/projects/huvegrym.webp';
import tarotImg from '@/assets/img/projects/tarot-divinidad.webp';
import { getT, type Locale } from '@/i18n';
import { getPro } from '@/lib/pro-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const bug = getPro(locale).projects.bugrun;
const es = locale === 'es';

type Meta = { img: ImageMetadata; alt: string; kind: string; status: string; url?: string; domain?: string; app?: boolean };
const meta: Record<string, Meta> = {
  arch: {
    img: archImg,
    alt: es
      ? 'ARCH App iOS - Aplicación móvil para comunidad de Oxford University desarrollada con React Native y Expo'
      : 'ARCH iOS app - Mobile app for an Oxford University community, built with React Native and Expo',
    kind: es ? 'App iOS' : 'iOS app',
    status: es ? 'En producción' : 'Live',
    url: 'https://apps.apple.com/us/app/the-arch/id6753820007',
    app: true,
  },
  huvegrym: {
    img: huvegrymImg,
    alt: es ? 'Huvegrym - Sitio web de escuela de danza, optimizado para SEO y rendimiento' : 'Huvegrym - Dance school website, optimized for SEO and performance',
    kind: 'Web',
    status: 'Online',
    url: 'https://huvegrym.es',
    domain: 'huvegrym.es',
  },
  'tarot-divinidad': {
    img: tarotImg,
    alt: es ? 'Tarot Divinidad — web de consultas de tarot con reservas y WhatsApp' : 'Tarot Divinidad — tarot reading website with bookings and WhatsApp',
    kind: 'Web',
    status: 'Online',
    url: 'https://divinidad000.com',
    domain: 'divinidad000.com',
  },
};

const projects = t.projects.items.map((item, i) => ({
  ...item,
  n: String(i + 1).padStart(2, '0'),
  m: meta[item.id],
  secondary: 'secondaryCta' in item && item.secondaryCta ? (item.secondaryCta as string) : undefined,
}));
---

<section id="proyectos" class="section">
  <div class="container-main">
    <SectionHead
      badge={es ? 'Proyectos' : 'Projects'}
      title={t.projects.headline}
      serif={es ? ['producción'] : ['production']}
      lead={t.projects.subtitle}
    />

    <div class="mt-14 flex flex-col gap-5 sm:mt-20 lg:gap-8">
      {
        projects.map((p, i) => (
          <article class="project card overflow-hidden" data-stack style={`--i:${i}`}>
            <div class="grid lg:min-h-[34rem] lg:grid-cols-[1.05fr_1fr]">
              <!-- Texto -->
              <div class="flex flex-col gap-6 p-6 sm:p-9 lg:p-11">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="serif mr-1 text-2xl text-acid">{p.n}</span>
                  <span class="chip">{p.m.kind}</span>
                  <span class="chip !text-ink/80">
                    <span class="dot-live mr-2 !h-1.5 !w-1.5" />
                    {p.m.status}
                  </span>
                </div>
                <div>
                  <h3 class="text-[clamp(2.2rem,6.5vw,3.75rem)] font-semibold leading-[0.95] tracking-[-0.045em] text-metal">{p.title}</h3>
                  <p class="mt-3 text-[16px] text-ink/70">{p.subtitle}</p>
                  <p class="mt-2 text-[14.5px] leading-relaxed text-ink/50">{p.description}</p>
                </div>
                <ul class="grid gap-x-6 gap-y-2.5 text-[14px] text-ink/75 sm:grid-cols-2">
                  {p.bullets.map((b) => (
                    <li class="flex items-start gap-2.5">
                      <Icon name="Check" class="mt-[3px] h-3.5 w-3.5 shrink-0 text-acid" strokeWidth={2.6} />
                      {b}
                    </li>
                  ))}
                </ul>
                <div class="flex flex-wrap gap-1.5">
                  {p.chips.map((c) => (
                    <span class="chip">{c}</span>
                  ))}
                </div>
                <div class="mt-auto flex flex-col gap-3 pt-2 sm:flex-row sm:items-center">
                  <a href={p.m.url} target="_blank" rel="noopener noreferrer" data-umami-event={p.m.app ? 'app-store' : 'ver-web'} data-umami-event-proyecto={p.title} class="btn btn-volt justify-between sm:justify-center">
                    {p.cta}
                    <span class="btn-icon">
                      <Icon name="ArrowUpRight" class="h-4 w-4" strokeWidth={2.4} />
                    </span>
                  </a>
                  {p.secondary && (
                    <a href="#contacto" class="btn btn-ghost">
                      {p.secondary}
                    </a>
                  )}
                </div>
              </div>

              <!-- Portada: rellena el panel entero (mismo encuadre en los tres proyectos) -->
              <div class="media relative order-first aspect-[5/4] overflow-hidden border-b border-white/[0.06] sm:aspect-[16/11] lg:order-none lg:aspect-auto lg:border-b-0 lg:border-l">
                <Picture
                  src={p.m.img}
                  alt={p.m.alt}
                  widths={[480, 720, 960, 1200]}
                  sizes="(min-width: 1024px) 560px, 100vw"
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  class="cover absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
            </div>
            <span class="veil" aria-hidden="true" />
          </article>
        ))
      }
    </div>

    <!-- Proyecto personal: el minijuego escondido (el botón solo aparece con JS) -->
    <aside class="card spotlight mt-5 flex flex-col gap-5 p-6 sm:p-8 lg:mt-8 lg:flex-row lg:items-center lg:gap-10" data-reveal>
      <div class="flex shrink-0 items-center gap-3">
        <span class="grid h-12 w-12 place-items-center rounded-2xl border border-acid/25 bg-acid/[0.07] text-acid">
          <Icon name="Gamepad2" class="h-5 w-5" strokeWidth={1.8} />
        </span>
        <div>
          <p class="font-pixel text-[15px] tracking-wide text-ink">{bug.name}</p>
          <p class="text-[12.5px] text-ink/60">{bug.kind}</p>
        </div>
      </div>
      <p class="flex-1 text-[14.5px] leading-relaxed text-ink/70">{bug.text}</p>
      <div class="flex flex-wrap items-center gap-1.5 lg:max-w-[14rem]">
        {bug.stack.map((c) => <span class="chip">{c}</span>)}
      </div>
      <button type="button" data-arcade-open hidden data-umami-event="jugar-bug-run" class="btn btn-ghost has-icon shrink-0 justify-between">
        {bug.play}
        <span class="btn-icon"><Icon name="ArrowUpRight" class="h-4 w-4" strokeWidth={2.2} /></span>
      </button>
    </aside>
  </div>
</section>

<style>
  /* Apilado solo si la tarjeta cabe entera en pantalla */
  @media (min-width: 1024px) and (min-height: 760px) {
    .project {
      position: sticky;
      top: calc(6.5rem + var(--i) * 1.5rem);
      transform-origin: 50% 0;
      will-change: transform;
    }
  }
  .media {
    background: #0e0e12;
  }
  .media :global(.cover) {
    transition: transform 1.4s var(--ease-out-expo);
  }
  .project:hover .media :global(.cover) {
    transform: scale(1.035);
  }
  /* Velo que oscurece la tarjeta tapada (opacity: se compone en la GPU, sin repintar) */
  .veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: #000;
    opacity: 0;
    will-change: opacity;
    border-radius: inherit;
  }
</style>
