---
/**
 * Proyectos como pantalla de "selección de nivel": tarjetas de nivel arriba y panel de misión
 * con el detalle del seleccionado. Accesible como pestañas (flechas del teclado).
 * Sin JS se ven todos los paneles uno detrás de otro.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import GameHeading from './GameHeading.astro';
import archImg from '@/assets/img/Arch.webp';
import huvegrymImg from '@/assets/img/Huvegrym.webp';
import tarotImg from '@/assets/img/divinidad-hero.webp';
import { gameLabels, getT, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const g = gameLabels[locale];
const es = locale === 'es';

const meta: Record<string, { img: ImageMetadata; alt: string; kind: string; icon: string; fit: 'contain' | 'cover'; pos?: string; time: string }> = {
  arch: {
    img: archImg,
    alt: 'ARCH App iOS - Aplicación móvil para comunidad de Oxford University desarrollada con React Native y Expo',
    kind: 'App iOS',
    icon: '★',
    fit: 'contain',
    time: es ? 'En producción' : 'Live',
  },
  huvegrym: {
    img: huvegrymImg,
    alt: 'Huvegrym - Sitio web de escuela de danza, optimizado para SEO y rendimiento',
    kind: 'Web',
    icon: '◆',
    fit: 'cover',
    pos: 'object-[center_30%]',
    time: 'Online',
  },
  'tarot-divinidad': {
    img: tarotImg,
    alt: 'Tarot Divinidad — web de consultas de tarot con reservas y WhatsApp',
    kind: 'Web',
    icon: '◆',
    fit: 'cover',
    time: 'Online',
  },
};

const hrefs: Record<string, Record<string, string>> = {
  arch: {
    'Descargar en App Store': 'https://apps.apple.com/us/app/the-arch/id6753820007',
    'Download on App Store': 'https://apps.apple.com/us/app/the-arch/id6753820007',
    'Solicitar detalles': '#contacto',
    'Request details': '#contacto',
  },
  huvegrym: { 'Ver sitio web': 'https://huvegrym.es', 'View website': 'https://huvegrym.es' },
  'tarot-divinidad': { 'Ver sitio web': 'https://divinidad000.com', 'View website': 'https://divinidad000.com' },
};

const projects = t.projects.items.map((item, i) => {
  const href = hrefs[item.id]?.[item.cta] || '#';
  const secondary = 'secondaryCta' in item && item.secondaryCta ? (item.secondaryCta as string) : undefined;
  return {
    ...item,
    n: i + 1,
    m: meta[item.id],
    cta: { label: item.cta, href, external: href.startsWith('http') },
    secondary: secondary ? { label: secondary, href: hrefs[item.id]?.[secondary] || '#contacto' } : undefined,
  };
});
---

<section id="proyectos" class="cv-auto relative scroll-mt-24 py-20 sm:py-28">
  <div class="container-main">
    <GameHeading level={`${g.level} 03`} eyebrow={g.projects} title={t.projects.title} subtitle={t.projects.subtitle} />

    <div data-level-select>
      <!-- Tarjetas de nivel -->
      <div
        role="tablist"
        aria-label={g.projects}
        class="scrollbar-hide -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 pt-5 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-5 sm:overflow-visible sm:px-0"
      >
        {
          projects.map((p, i) => (
            <button
              type="button"
              role="tab"
              id={`lvl-tab-${p.id}`}
              aria-controls={`lvl-panel-${p.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-level-tab
              class="level-card group relative w-[78%] shrink-0 snap-center text-left sm:w-auto"
            >
              <span class="level-selected pixel-tag absolute -top-3 right-4 z-10 border-2 border-noir bg-acid text-noir">✓ {g.selected}</span>
              <span class="relative block aspect-[16/10] overflow-hidden rounded-t-[1.05rem] bg-noir-elevated">
                <Picture
                  src={p.m.img}
                  alt=""
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[320, 480, 720]}
                  sizes="(max-width: 640px) 78vw, 360px"
                  loading="lazy"
                  class:list={[
                    'img-fill transition-transform duration-500 group-hover:scale-105',
                    p.m.fit === 'contain' ? 'object-contain p-6' : 'object-cover',
                    p.m.pos,
                  ]}
                />
                <span class="pixel-tag absolute left-3 top-3">
                  <span aria-hidden="true">{p.m.icon}</span>
                  {p.m.kind}
                </span>
              </span>
              <span class="block p-4 sm:p-5">
                <span class="font-pixel block text-[10px] uppercase tracking-wider text-acid">
                  {g.level} 3-{p.n} · {p.m.time}
                </span>
                <span class="mt-1.5 block text-xl font-black uppercase leading-tight text-ink sm:text-2xl">{p.title}</span>
                <span class="mt-1 block text-[13px] leading-snug text-ink/70">{p.subtitle}</span>
              </span>
            </button>
          ))
        }
      </div>

      <!-- Panel de misión -->
      {
        projects.map((p, i) => (
          <article
            role="tabpanel"
            id={`lvl-panel-${p.id}`}
            aria-labelledby={`lvl-tab-${p.id}`}
            data-level-panel
            data-hidden-js={i === 0 ? undefined : 'true'}
            class="game-panel mt-6 grid gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:gap-10"
          >
            <div class="flex flex-col gap-5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="pixel-tag">
                  <span aria-hidden="true">{p.m.icon}</span> {p.m.kind}
                </span>
                <span class="pixel-tag bg-transparent text-ink/60">{g.level} 3-{p.n}</span>
              </div>
              <h3 class="game-title origin-left -rotate-1 text-4xl sm:text-5xl">{p.title}</h3>
              <p class="max-w-xl text-[15px] leading-relaxed text-ink/75 sm:text-base">
                <span class="font-semibold text-ink">{p.subtitle}. </span>
                {p.description}
              </p>

              <div>
                <p class="font-pixel mb-3 text-[11px] uppercase tracking-wider text-ink/60">{es ? 'Objetivos de la misión' : 'Mission objectives'}</p>
                <ul class="grid gap-2 sm:grid-cols-2">
                  {p.bullets.map((b) => (
                    <li class="flex items-start gap-2.5 text-[14px] leading-snug text-ink/80">
                      <span class="mt-0.5 grid h-4 w-4 shrink-0 place-items-center rounded-[3px] border-2 border-noir bg-acid text-[10px] font-black text-noir">
                        ✓
                      </span>
                      {b}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-1 flex flex-wrap items-center gap-4">
                <a
                  href={p.cta.href}
                  target={p.cta.external ? '_blank' : undefined}
                  rel={p.cta.external ? 'noopener noreferrer' : undefined}
                  class="start-btn group !gap-3 !py-2.5 !pl-4 !pr-5 text-[15px] font-black uppercase"
                >
                  <Icon name="Play" class="h-5 w-5 fill-current" strokeWidth={2.5} />
                  {p.cta.label}
                  <Icon name="ArrowUpRight" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" strokeWidth={2.6} />
                </a>
                {p.secondary && (
                  <a href={p.secondary.href} class="text-[14px] font-semibold text-ink/70 underline-offset-4 hover:text-acid hover:underline">
                    {p.secondary.label}
                  </a>
                )}
              </div>
            </div>

            <div class="flex flex-col gap-5">
              <div class="relative aspect-[16/10] overflow-hidden rounded-2xl border-[3px] border-noir bg-noir-elevated shadow-[0_6px_0_#0a0706]">
                <Picture
                  src={p.m.img}
                  alt={p.m.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[480, 720, 1024]}
                  sizes="(max-width: 1024px) 100vw, 480px"
                  loading="lazy"
                  class:list={['img-fill', p.m.fit === 'contain' ? 'object-contain p-8' : 'object-cover', p.m.pos]}
                />
              </div>
              <div>
                <p class="font-pixel mb-3 text-[11px] uppercase tracking-wider text-ink/60">{es ? 'Equipamiento usado' : 'Gear used'}</p>
                <ul class="flex flex-wrap gap-2">
                  {p.chips.map((c) => (
                    <li class="rounded-lg border-2 border-white/15 bg-noir px-2.5 py-1 text-[12px] font-bold text-ink/85">{c}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .level-card {
    border: 3px solid #0a0706;
    border-radius: 1.3rem;
    background: #221c17;
    box-shadow:
      inset 0 2px 0 rgba(255, 243, 230, 0.08),
      0 6px 0 #0a0706;
    transition:
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .level-card:hover {
    transform: translateY(-4px);
  }
  .level-card[aria-selected='true'] {
    border-color: #f0b429;
    box-shadow:
      inset 0 2px 0 rgba(255, 243, 230, 0.08),
      0 6px 0 #8a5f10,
      0 0 0 4px rgba(240, 180, 41, 0.25);
    transform: translateY(-6px);
  }
  .level-selected {
    display: none;
  }
  .level-card[aria-selected='true'] .level-selected {
    display: inline-flex;
  }
  /* Con JS solo se ve el panel del nivel elegido */
  :global(.js) [data-level-panel][data-hidden-js='true'] {
    display: none;
  }
</style>
