---
import LegalShell from './LegalShell.astro';
import LegalSection from './LegalSection.astro';
import LegalSub from './LegalSub.astro';
import LegalList from './LegalList.astro';
import LegalKV from './LegalKV.astro';
import { getT, type Locale } from '@/i18n';
import { UMAMI_WEBSITE_ID } from '@/lib/analytics';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const p = t.privacy.sections;
// Solo si la analítica (Umami) está activada en src/lib/analytics.ts
const analytics = UMAMI_WEBSITE_ID
  ? locale === 'es'
    ? {
        title: '2.4. Analítica web',
        description:
          'Para saber cuántas personas visitan la web y qué secciones les interesan uso Umami, una herramienta de analítica sin cookies:',
        items: [
          'No usa cookies ni guarda nada en tu navegador.',
          'No recoge datos personales ni permite identificarte: solo estadísticas agregadas (páginas vistas, país, tipo de dispositivo y navegador, web de procedencia).',
          'Cuenta acciones como descargar el CV o enviar el formulario, nunca su contenido.',
        ],
        note: 'Las estadísticas las trata Umami Software, Inc. (Estados Unidos) como encargado del tratamiento. Como no se recoge ningún dato que te identifique, no se transfieren datos personales.',
        purpose: 'Elaborar estadísticas anónimas de uso de la web (Umami, sin cookies)',
        legalBasis: 'Interés legítimo: para la analítica web anónima, que no usa cookies ni permite identificarte',
        retention: 'Las estadísticas anónimas de la analítica web se conservan un máximo de 6 meses.',
        thirdParty: 'La analítica web (Umami) funciona sin cookies y no rastrea entre sitios.',
      }
    : {
        title: '2.4. Web analytics',
        description:
          'To know how many people visit the site and which sections they find useful, I use Umami, a cookie-free analytics tool:',
        items: [
          'It does not use cookies or store anything in your browser.',
          'It does not collect personal data or identify you: only aggregated statistics (page views, country, device type and browser, referring site).',
          'It counts actions such as downloading the CV or sending the form, never their content.',
        ],
        note: 'The statistics are processed by Umami Software, Inc. (United States) as data processor. Since nothing that identifies you is collected, no personal data is transferred.',
        purpose: 'Producing anonymous usage statistics for the site (Umami, cookie-free)',
        legalBasis: 'Legitimate interest: for anonymous web analytics, which uses no cookies and cannot identify you',
        retention: 'Anonymous web analytics statistics are kept for a maximum of 6 months.',
        thirdParty: 'Web analytics (Umami) works without cookies and does not track you across sites.',
      }
  : null;
const sections = [
  { id: 'responsible', title: p.responsible.title },
  { id: 'data-collected', title: p.dataCollected.title },
  { id: 'purpose', title: p.purpose.title },
  { id: 'legal-basis', title: p.legalBasis.title },
  { id: 'retention', title: p.retention.title },
  { id: 'rights', title: p.rights.title },
  { id: 'security', title: p.security.title },
  { id: 'third-party', title: p.thirdParty.title },
  { id: 'changes', title: p.changes.title },
  { id: 'contact', title: p.contact.title },
];
const emailLink = 'text-ink underline decoration-white/20 underline-offset-[3px] transition-colors hover:text-acid hover:decoration-acid/40';
---

<LegalShell locale={locale} title={t.privacy.title} lastUpdatedLabel={t.privacy.lastUpdated} sections={sections} path="/privacidad">
  <LegalSection id="responsible" title={p.responsible.title}>
    <p>{p.responsible.description}</p>
    <LegalKV
      items={[
        { label: p.responsible.name, value: 'Gabriel Saiz' },
        { label: p.responsible.email, email: true },
        { label: p.responsible.website, value: 'gabrielcodes.dev' },
      ]}
    />
  </LegalSection>

  <LegalSection id="data-collected" title={p.dataCollected.title}>
    <p>{p.dataCollected.description}</p>
    <LegalSub title={p.dataCollected.contactForm.title}>
      <p>{p.dataCollected.contactForm.description}</p>
      <LegalList items={p.dataCollected.contactForm.items} />
      <p>{p.dataCollected.contactForm.note}</p>
    </LegalSub>
    <LegalSub title={p.dataCollected.cookies.title}>
      <p>{p.dataCollected.cookies.description}</p>
      <LegalList items={p.dataCollected.cookies.items} />
      <p>{p.dataCollected.cookies.note}</p>
    </LegalSub>
    <LegalSub title={p.dataCollected.arcade.title}>
      <p>{p.dataCollected.arcade.description}</p>
      <LegalList items={p.dataCollected.arcade.items} />
      <p>{p.dataCollected.arcade.note}</p>
    </LegalSub>
    {
      analytics && (
        <LegalSub title={analytics.title}>
          <p>{analytics.description}</p>
          <LegalList items={analytics.items} />
          <p>{analytics.note}</p>
        </LegalSub>
      )
    }
  </LegalSection>

  <LegalSection id="purpose" title={p.purpose.title}>
    <p>{p.purpose.description}</p>
    <LegalList items={analytics ? [...p.purpose.items, analytics.purpose] : p.purpose.items} />
  </LegalSection>

  <LegalSection id="legal-basis" title={p.legalBasis.title}>
    <p>{p.legalBasis.description}</p>
    <LegalList items={analytics ? [...p.legalBasis.items, analytics.legalBasis] : p.legalBasis.items} />
  </LegalSection>

  <LegalSection id="retention" title={p.retention.title}>
    <p>{p.retention.description}</p>
    <p>{p.retention.cookiesNote}</p>
    <LegalList items={p.retention.cookieItems} />
    {analytics && <p>{analytics.retention}</p>}
  </LegalSection>

  <LegalSection id="rights" title={p.rights.title}>
    <p>{p.rights.description}</p>
    <LegalList items={p.rights.items} />
    <p>{p.rights.contact} <a href="mailto:gsaiz.bajo@gmail.com" class={emailLink}>gsaiz.bajo@gmail.com</a></p>
  </LegalSection>

  <LegalSection id="security" title={p.security.title}><p>{p.security.description}</p></LegalSection>
  <LegalSection id="third-party" title={p.thirdParty.title}>
    <p>{p.thirdParty.description}</p>
    {analytics && <p>{analytics.thirdParty}</p>}
  </LegalSection>
  <LegalSection id="changes" title={p.changes.title}><p>{p.changes.description}</p></LegalSection>

  <LegalSection id="contact" title={p.contact.title}>
    <div class="space-y-3">
      <p>{p.contact.description}</p>
      <p><a href="mailto:gsaiz.bajo@gmail.com" class={emailLink}>gsaiz.bajo@gmail.com</a></p>
    </div>
  </LegalSection>
</LegalShell>
