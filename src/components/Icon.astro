---
/**
 * Icono Lucide renderizado a SVG en build (mismo set y atributos que lucide-react,
 * pero sin JavaScript en el cliente).
 */
import * as lucide from 'lucide';

type IconNode = [string, Record<string, string | number>][];

interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = '', strokeWidth = 2 } = Astro.props;
const node = (lucide as unknown as Record<string, IconNode>)[name];
if (!node) throw new Error(`Icono Lucide desconocido: ${name}`);

const kebab = name.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase();
const attrs = (a: Record<string, string | number>) =>
  Object.entries(a)
    .map(([k, v]) => `${k}="${String(v).replace(/"/g, '&quot;')}"`)
    .join(' ');
const inner = node.map(([tag, a]) => `<${tag} ${attrs(a)}></${tag}>`).join('');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['lucide', `lucide-${kebab}`, className]}
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
