---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from './Footer.astro';
import Hero from './pro/Hero.astro';
import Projects from './pro/Projects.astro';
import Experience from './pro/Experience.astro';
import Stack from './pro/Stack.astro';
import About from './pro/About.astro';
import Contact from './pro/Contact.astro';
import { personData, organizationData, websiteData, breadcrumbsData, profilePageData } from '@/lib/structured-data';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [profilePageData(locale), personData, websiteData(locale), organizationData, breadcrumbsData(locale)],
};
---

<BaseLayout locale={locale} jsonLd={jsonLd}>
  <main id="main-content">
    <Hero locale={locale} />
    <Projects locale={locale} />
    <Experience locale={locale} />
    <Stack locale={locale} />
    <About locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
