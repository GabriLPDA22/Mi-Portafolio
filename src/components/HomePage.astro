---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Stack from './Stack.astro';
import About from './About.astro';
import Services from './Services.astro';
import Projects from './Projects.astro';
import Experience from './Experience.astro';
import Process from './Process.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { personData, organizationData, websiteData, breadcrumbsData } from '@/lib/structured-data';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personData, websiteData(locale), organizationData, breadcrumbsData(locale)],
};
---

<BaseLayout locale={locale} jsonLd={jsonLd} scrollTop>
  <main id="main-content">
    <Hero locale={locale} />
    <Stack locale={locale} />
    <About locale={locale} />
    <Services locale={locale} />
    <Projects locale={locale} />
    <Experience locale={locale} />
    <Process locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
