---
import Icon from './Icon.astro';
import SplitTitle from './SplitTitle.astro';
import { getT, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);

const serviceIcons: Record<string, string> = {
  mobile: 'Smartphone',
  web: 'Monitor',
  backend: 'Server',
  devops: 'Container',
  performance: 'Gauge',
  maintenance: 'ShieldCheck',
};
const gsapCard = ['services-first-card-gsap', 'services-second-card-gsap', 'services-third-card-gsap'];
const cardScrub = [{ x: -50, rotate: -5 }, { scale: 0.9 }, { x: 50, rotate: 5 }];
const ribbon = `${t.services.ribbon}  ·  ${t.services.ribbon}  ·  ${t.services.ribbon}  ·  `;
---

<section id="servicios" data-scrub-scope class="relative z-10 scroll-mt-24 bg-noir py-20 xl:bg-transparent xl:py-32">
  <div class="container-main flex flex-col gap-12 xl:gap-20">
    <!-- Cinta curva: el texto se desliza con el scroll -->
    <div data-arc aria-hidden="true" class="pointer-events-none relative -mx-5 mb-2 overflow-hidden sm:mx-0">
      <svg
        viewBox="0 0 1200 280"
        class="h-[12.5rem] w-[175%] max-w-none -translate-x-[21%] sm:h-[12rem] sm:w-full sm:translate-x-0 xl:h-[14rem]"
        preserveAspectRatio="xMidYMid meet"
      >
        <path d="M 48 204 Q 600 40 1152 204" fill="none" stroke="var(--color-ink)" stroke-width="152" stroke-linecap="round" class="sm:[stroke-width:112]"></path>
        <path id="arc-path-services" d="M 48 204 Q 600 40 1152 204" fill="none"></path>
        <text fill="var(--color-noir)" class="font-code text-[52px] font-bold uppercase tracking-[0.12em] sm:text-[34px] xl:text-[36px]">
          <textPath href="#arc-path-services" startOffset="0%">{ribbon}</textPath>
        </text>
      </svg>
    </div>

    <div class="text-center">
      <h2 class="services-title-gsap font-code text-[clamp(2.4rem,8vw,5.5rem)] font-bold uppercase tracking-tight text-ink" data-scrub={JSON.stringify({ y: -50, x: -50, rotate: -5 })}>
        <SplitTitle text={t.services.title} />
      </h2>
      <p class="services-description-gsap mx-auto mt-5 max-w-[34rem] text-[15px] leading-relaxed text-ink/65 xl:text-xl" data-scrub={JSON.stringify({ scale: 0.85 })}>
        {t.services.subtitle}
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 xl:grid-cols-3 xl:gap-10">
      {
        t.services.items.map((service, i) => {
          const col = i % 3;
          const tilt = col === 0 ? 'xl:-rotate-2' : col === 2 ? 'xl:rotate-2' : 'xl:z-[1]';
          const drop = i % 2 === 0 ? '2xl:mt-4' : '';
          const fan = col === 0 ? 'xl:translate-x-2' : col === 2 ? 'xl:-translate-x-2' : 'xl:scale-[1.02]';
          return (
            <div class:list={[gsapCard[col], tilt, drop, fan, 'h-full']} data-scrub={JSON.stringify(cardScrub[col])}>
              <article
                data-reveal
                data-reveal-margin="-60px"
                style={`--ry:32px;--d:${(i * 0.07).toFixed(2)}s;--ease:cubic-bezier(0.22,1,0.36,1)`}
                class="group flex h-full flex-col justify-between rounded-[3rem] border border-white/15 bg-noir-soft p-7 shadow-[0_20px_50px_-28px_rgba(0,0,0,0.8)] xl:p-8 xl:hover:-translate-y-6"
              >
                <div>
                  <div class="mb-4 flex items-start justify-between">
                    <span class="font-code text-base text-ink/60 xl:text-xl">{String(i + 1).padStart(2, '0')}</span>
                    <span class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-ink/70">
                      <Icon name={serviceIcons[service.id] ?? 'Monitor'} class="h-5 w-5" strokeWidth={1.6} />
                    </span>
                  </div>
                  <h3 class="mb-3 font-code text-2xl tracking-wide text-ink xl:text-3xl">{service.title}</h3>
                  <p class="mb-6 text-base leading-relaxed text-ink/65 xl:text-lg">{service.description}</p>
                </div>
                <div class="flex flex-wrap gap-2 border-t border-white/10 pt-6">
                  {service.chips.map((chip) => (
                    <span class="rounded-full border border-white/10 px-3 py-1 text-xs italic text-ink/65 xl:text-sm">{chip}</span>
                  ))}
                </div>
              </article>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
