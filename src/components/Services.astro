---
/**
 * Capacidades: bento de 6 tarjetas. Las dos primeras (móvil y web) son las más anchas porque
 * es donde más producto he entregado. Foco de luz que sigue al cursor (solo con ratón).
 */
import Icon from './Icon.astro';
import SectionHead from './ui/SectionHead.astro';
import { getT, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getT(locale);
const es = locale === 'es';

const icons: Record<string, string> = {
  mobile: 'Smartphone',
  web: 'LayoutDashboard',
  backend: 'Server',
  devops: 'Cloud',
  performance: 'Gauge',
  maintenance: 'LifeBuoy',
};
// Ancho en la rejilla de escritorio (6 columnas)
const span: Record<string, string> = {
  mobile: 'lg:col-span-4',
  web: 'lg:col-span-2',
  backend: 'lg:col-span-2',
  devops: 'lg:col-span-2',
  performance: 'lg:col-span-2',
  maintenance: 'lg:col-span-6',
};
---

<section id="servicios" class="section cv-auto">
  <div class="container-main">
    <SectionHead
      badge={es ? 'Capacidades' : 'Capabilities'}
      title={t.services.headline}
      serif={es ? ['fuerte'] : ['strong']}
      lead={t.services.subtitle}
    />

    <div class="mt-14 grid gap-3 sm:mt-16 sm:grid-cols-2 sm:gap-4 lg:grid-cols-6">
      {
        t.services.items.map((s, i) => (
          <article
            class:list={['card spotlight group flex flex-col p-6 sm:p-7', span[s.id]]}
            data-spotlight
            data-reveal
            style={`--delay:${(i % 3) * 0.08}s`}
          >
            <div class="flex items-start justify-between gap-4">
              <span class="svc-icon">
                <Icon name={icons[s.id]} class="h-5 w-5" strokeWidth={1.8} />
              </span>
              <span class="serif text-xl text-ink/25" aria-hidden="true">0{i + 1}</span>
            </div>
            <div class:list={['mt-8 flex flex-1 flex-col', s.id === 'maintenance' && 'lg:flex-row lg:items-end lg:justify-between lg:gap-10']}>
              <div>
                <h3 class="text-[1.4rem] font-semibold tracking-[-0.03em] text-ink">{s.title}</h3>
                <p class="mt-2.5 max-w-md text-[14.5px] leading-relaxed text-ink/55">{s.description}</p>
              </div>
              <ul class:list={['mt-5 flex flex-col gap-2 text-[14px] text-ink/75', s.id === 'maintenance' && 'lg:mt-0']}>
                {s.bullets.slice(0, s.id === 'mobile' ? 5 : 3).map((b) => (
                  <li class="flex items-center gap-2.5">
                    <Icon name="Check" class="h-3.5 w-3.5 shrink-0 text-acid" strokeWidth={2.6} />
                    {b}
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-6 flex flex-wrap gap-1.5 border-t border-white/[0.06] pt-5">
              {s.chips.map((c) => (
                <span class="chip">{c}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .svc-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.9rem;
    color: #f0b429;
    background: linear-gradient(180deg, rgba(240, 180, 41, 0.14), rgba(240, 180, 41, 0.03));
    box-shadow:
      inset 0 0 0 1px rgba(240, 180, 41, 0.25),
      0 0 24px -8px rgba(240, 180, 41, 0.5);
    transition: transform 0.6s var(--ease-out-expo);
  }
  .group:hover .svc-icon {
    transform: rotate(-8deg) scale(1.06);
  }
</style>
