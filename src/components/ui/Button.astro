---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
}

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 rounded-full font-semibold whitespace-nowrap transition duration-200 ease-(--ease-out-expo) focus-visible:outline-offset-4 active:scale-[0.98]';

const variants = {
  primary: 'bg-accent text-accent-ink hover:bg-white shadow-[0_0_0_1px_rgb(0_230_118/0.4),0_8px_30px_-8px_rgb(0_230_118/0.55)]',
  secondary: 'border border-line-strong bg-white/[0.03] text-fg hover:bg-white/[0.08] hover:border-white/25',
  ghost: 'text-soft hover:text-fg',
};

const sizes = {
  md: 'h-11 px-5 text-sm',
  lg: 'h-13 px-7 text-base',
};
---

<a href={href} class:list={[base, variants[variant], sizes[size], className]} {...rest}>
  <slot />
</a>
