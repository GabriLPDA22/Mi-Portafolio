---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import brandMark from '@/assets/img/brand-mark-64.png';
import { getT, homePath, localePath, otherLocale, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  /** Ruta sin prefijo de idioma de la página actual, para el cambio de idioma. */
  path?: string;
}

const { locale, path = '/' } = Astro.props;
const t = getT(locale);
const home = homePath(locale);
const other = otherLocale(locale);

const navItems = [
  { label: t.nav.about, href: `${home}#sobre-mi` },
  { label: t.nav.projects, href: `${home}#proyectos` },
  { label: t.nav.services, href: `${home}#servicios` },
  { label: t.nav.process, href: `${home}#resultados` },
];
const menuItems = [...navItems, { label: t.nav.contact, href: `${home}#contacto` }];

const langLabel = other === 'en' ? 'Read in English' : 'Leer en español';
const labels = locale === 'es' ? { open: 'Abrir menú', close: 'Cerrar menú' } : { open: 'Open menu', close: 'Close menu' };
---

<header class="fixed inset-x-0 top-0 z-50 w-full">
  <div class="container-main">
    <div
      data-header-bar
      class="mt-3 flex items-center justify-between gap-2 rounded-full border border-transparent bg-transparent px-4 py-2.5 transition-all duration-500 data-[scrolled=true]:glass data-[scrolled=true]:border-white/10 data-[scrolled=true]:shadow-[0_8px_40px_-12px_rgba(0,0,0,0.7)] sm:mt-4 sm:px-5"
    >
      <!-- Wordmark -->
      <a
        href={home}
        data-home-link
        class="group flex items-center gap-2.5 font-display text-lg font-bold tracking-tight text-ink"
        aria-label={locale === 'es' ? 'gabriel.codes — Gabriel Saiz, inicio' : 'gabriel.codes — Gabriel Saiz, home'}
      >
        <span class="relative inline-block h-7 w-7 shrink-0 text-ink transition-transform duration-300 group-hover:scale-105">
          <Image src={brandMark} alt="" width={28} densities={[1, 2]} class="h-full w-full object-contain" loading="eager" />
        </span>
        <span>
          gabriel<span class="text-acid">.</span><span class="text-ink/65">codes</span>
        </span>
      </a>

      <!-- Navegación de escritorio (lg+) -->
      <nav class="hidden items-center gap-1 lg:flex" aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="rounded-full px-3.5 py-1.5 text-[13px] font-medium text-ink/70 transition-all duration-200 hover:bg-white/[0.06] hover:text-ink"
            >
              {item.label}
            </a>
          ))
        }
        <div class="mx-2 h-4 w-px bg-white/10"></div>
        <a
          href={localePath(other, path)}
          hreflang={other}
          lang={other}
          data-lang-switch
          class="relative flex h-9 flex-shrink-0 items-center gap-1.5 rounded-full border border-white/[0.1] bg-white/[0.03] px-3 text-[12px] font-semibold text-ink/75 transition-all duration-200 hover:border-acid/40 hover:text-acid"
          aria-label={`${locale.toUpperCase()} — ${langLabel}`}
          title={langLabel}
        >
          <Icon name="Languages" class="h-3.5 w-3.5 flex-shrink-0" strokeWidth={1.7} />
          <span class="whitespace-nowrap uppercase tracking-wide">{locale}</span>
        </a>
        <a href={`${home}#contacto`} class="btn-arrow ml-2 h-9 px-4 text-[13px]">{t.nav.contact}</a>
      </nav>

      <!-- Controles móvil/tablet -->
      <div class="flex items-center gap-2 lg:hidden">
        <a
          href={localePath(other, path)}
          hreflang={other}
          lang={other}
          data-lang-switch
          class="relative flex h-9 flex-shrink-0 items-center gap-1 rounded-full border border-white/[0.1] bg-white/[0.03] px-2.5 text-[11px] font-semibold text-ink/75 transition-all duration-200 hover:border-acid/40 hover:text-acid sm:gap-1.5 sm:px-3 sm:text-[12px]"
          aria-label={`${locale.toUpperCase()} — ${langLabel}`}
          title={langLabel}
        >
          <Icon name="Languages" class="h-3 w-3 flex-shrink-0 sm:h-3.5 sm:w-3.5" strokeWidth={1.7} />
          <span class="whitespace-nowrap uppercase tracking-wide">{locale}</span>
        </a>
        <button
          type="button"
          data-menu-toggle
          data-label-open={labels.open}
          data-label-close={labels.close}
          class="group/btn relative z-50 flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] transition-colors duration-200 hover:border-acid/40"
          aria-label={labels.open}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="flex w-4 flex-col items-center gap-[5px]" aria-hidden="true">
            <span
              class="h-[1.5px] w-full origin-center rounded-full bg-ink transition-all duration-300 group-aria-expanded/btn:translate-y-[6.5px] group-aria-expanded/btn:rotate-45 group-aria-expanded/btn:bg-acid"
            ></span>
            <span class="h-[1.5px] w-full rounded-full bg-ink transition-all duration-300 group-aria-expanded/btn:scale-0 group-aria-expanded/btn:opacity-0"
            ></span>
            <span
              class="h-[1.5px] w-full origin-center rounded-full bg-ink transition-all duration-300 group-aria-expanded/btn:-translate-y-[6.5px] group-aria-expanded/btn:-rotate-45 group-aria-expanded/btn:bg-acid"
            ></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Menú a pantalla completa (móvil/tablet) -->
<div
  id="mobile-menu"
  data-menu
  data-open="false"
  inert
  aria-hidden="true"
  class="group/menu pointer-events-none fixed inset-0 z-40 flex flex-col bg-noir/[0.98] pt-28 opacity-0 backdrop-blur-xl transition-opacity duration-300 data-[open=true]:pointer-events-auto data-[open=true]:opacity-100 lg:hidden"
>
  <nav class="container-main flex-1" aria-label={locale === 'es' ? 'Menú móvil' : 'Mobile menu'}>
    <ul class="flex flex-col gap-1">
      {
        menuItems.map((item, i) => (
          <li
            class="translate-y-6 border-b border-white/[0.06] opacity-0 transition-all duration-500 group-data-[open=true]/menu:translate-y-0 group-data-[open=true]/menu:opacity-100 group-data-[open=true]/menu:[transition-delay:var(--delay)]"
            style={`--delay:${i * 60 + 100}ms`}
          >
            <a href={item.href} class="group flex items-baseline justify-between py-4">
              <span class="font-display text-4xl font-semibold tracking-tight text-ink transition-colors group-hover:text-acid">{item.label}</span>
              <span class="font-display text-sm text-acid/70" aria-hidden="true">0{i + 1}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div
    class="container-main translate-y-6 pb-10 opacity-0 transition-all duration-500 group-data-[open=true]/menu:translate-y-0 group-data-[open=true]/menu:opacity-100 group-data-[open=true]/menu:[transition-delay:500ms]"
  >
    <a href="mailto:gsaiz.bajo@gmail.com" class="inline-flex items-center gap-2 text-[13px] tracking-[0.08em] text-ink/70 transition-colors hover:text-acid">
      <span class="text-[11px] uppercase tracking-[0.2em] text-ink/60">Email</span>
      gsaiz.bajo@gmail.com
    </a>
  </div>
</div>
