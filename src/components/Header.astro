---
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import Logo from '@/components/Logo.astro';
import { services, formatPrice } from '@/data/services';
import { site, whatsappUrl, PHONE_PLACEHOLDER } from '@/config/site';
import { normalizePath } from '@/lib/url';

const current = normalizePath(Astro.url.pathname);
const isActive = (path: string) => (path === '/' ? current === '/' : current === path || current.startsWith(`${path}/`));

const serviceIcons = {
  'landing-pages': 'target',
  'diseno-web': 'layout',
  'web-con-reservas': 'calendar',
  'mantenimiento-web': 'wrench',
} as const;

const links = [
  { label: 'Diseño web Zaragoza', href: '/diseno-web-zaragoza' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Precios', href: '/servicios#precios' },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-ink/75 backdrop-blur-xl backdrop-saturate-150">
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="GabrielCodes, ir a la página de inicio">
      <Logo />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-sm">
        <li class="group relative">
          <a
            href="/servicios"
            class:list={[
              'inline-flex items-center gap-1 rounded-full px-3.5 py-2 transition-colors hover:text-fg',
              isActive('/servicios') || current === '/mantenimiento-web' ? 'text-fg' : 'text-muted',
            ]}
            aria-current={current === '/servicios' ? 'page' : undefined}
          >
            Servicios
            <Icon name="chevronDown" class="size-3.5 transition-transform group-focus-within:rotate-180 group-hover:rotate-180" />
          </a>
          <div
            class="invisible absolute top-full left-1/2 w-[34rem] -translate-x-1/2 translate-y-1 pt-3 opacity-0 transition duration-200 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100"
          >
            <ul class="card grid grid-cols-2 gap-1 bg-ink-2/95 p-2 shadow-2xl shadow-black/60 backdrop-blur-xl">
              {
                services.map((s) => (
                  <li>
                    <a
                      href={s.path}
                      class="block rounded-xl p-3.5 transition-colors hover:bg-white/[0.05]"
                      aria-current={isActive(s.path) ? 'page' : undefined}
                    >
                      <span class="block text-sm font-medium text-fg">{s.name}</span>
                      <span class="mt-1 block text-xs leading-relaxed text-muted">{s.idealFor}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[
                  'inline-flex rounded-full px-3.5 py-2 transition-colors hover:text-fg',
                  isActive(l.href) ? 'text-fg' : 'text-muted',
                ]}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/contacto"
            class:list={[
              'inline-flex rounded-full px-3.5 py-2 transition-colors hover:text-fg',
              isActive('/contacto') ? 'text-fg' : 'text-muted',
            ]}
            aria-current={isActive('/contacto') ? 'page' : undefined}>Contacto</a
          >
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden sm:block">
        <Button href="/contacto#presupuesto" data-cta="header">Solicitar presupuesto</Button>
      </div>
      <button
        type="button"
        class="relative inline-flex size-11 items-center justify-center rounded-full border border-line bg-white/[0.03] text-fg transition-colors hover:bg-white/[0.07] lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">Abrir menú</span>
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <!-- Menú móvil: panel a pantalla completa bajo la cabecera. `absolute` (no `fixed`) porque el
       backdrop-filter del header crea un nuevo bloque contenedor para los hijos `fixed`. -->
  <div
    id="mobile-menu"
    class="mobile-menu absolute inset-x-0 top-full hidden h-[calc(100dvh-4rem)] flex-col bg-ink lg:hidden"
    data-menu
  >
    <nav aria-label="Móvil" class="container-page flex-1 overflow-y-auto overscroll-contain pt-6 pb-8">
      <div class="menu-item flex items-center justify-between">
        <p class="eyebrow">Servicios</p>
        <a href="/servicios" class="inline-flex items-center gap-1 text-sm text-muted hover:text-fg">
          Ver todos <Icon name="arrowRight" class="size-3.5" />
        </a>
      </div>
      <ul class="mt-4 grid grid-cols-2 gap-3">
        {
          services.map((s, i) => (
            <li class="menu-item" style={`--i:${i + 1}`}>
              <a
                href={s.path}
                class:list={[
                  'flex h-full flex-col rounded-2xl border p-4 transition-colors active:scale-[0.98]',
                  isActive(s.path) ? 'border-accent/40 bg-accent/[0.06]' : 'border-line bg-surface/60 hover:border-line-strong',
                ]}
                aria-current={isActive(s.path) ? 'page' : undefined}
              >
                <span class="inline-flex size-9 items-center justify-center rounded-xl bg-accent/10 text-accent">
                  <Icon name={serviceIcons[s.id]} class="size-[1.1rem]" />
                </span>
                <span class="mt-4 text-[0.95rem] leading-tight font-medium text-fg">{s.name}</span>
                <span class="mt-1 text-xs text-muted">{formatPrice(s.price)}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="mt-6 divide-y divide-line border-y border-line">
        {
          [...links, { label: 'Contacto', href: '/contacto' }].map((l, i) => (
            <li class="menu-item" style={`--i:${i + 5}`}>
              <a
                href={l.href}
                class:list={[
                  'flex items-center justify-between py-3.5 text-base font-medium transition-colors',
                  isActive(l.href) ? 'text-accent' : 'text-fg hover:text-accent',
                ]}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
                <Icon name="arrowRight" class="size-4 text-muted" />
              </a>
            </li>
          ))
        }
      </ul>

      <p class="menu-item mt-6 flex items-center gap-2 text-sm text-muted" style="--i:9">
        <Icon name="mapPin" class="size-4 text-accent" />
        {site.address.locality} · {site.openingHours.display}
      </p>
    </nav>

    <div class="border-t border-line bg-ink-2/95 px-4 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] backdrop-blur-xl sm:px-6">
      <Button href="/contacto#presupuesto" size="lg" class="w-full" data-cta="mobile-menu">
        Solicitar presupuesto
        <Icon name="arrowRight" class="size-4" />
      </Button>
      <div class="mt-3 grid grid-cols-2 gap-3">
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener"
          class="inline-flex h-11 items-center justify-center gap-2 rounded-full border border-line-strong text-sm font-semibold text-fg hover:bg-white/5"
          data-cta="mobile-menu-whatsapp"
        >
          <Icon name="messageCircle" class="size-4 text-[#25D366]" /> WhatsApp
        </a>
        {
          PHONE_PLACEHOLDER ? (
            <a
              href={`mailto:${site.contact.email}`}
              class="inline-flex h-11 items-center justify-center gap-2 rounded-full border border-line-strong text-sm font-semibold text-fg hover:bg-white/5"
            >
              <Icon name="mail" class="size-4 text-accent" /> Email
            </a>
          ) : (
            <a
              href={`tel:+${site.contact.phoneE164}`}
              class="inline-flex h-11 items-center justify-center gap-2 rounded-full border border-line-strong text-sm font-semibold text-fg hover:bg-white/5"
              data-cta="mobile-menu-phone"
            >
              <Icon name="phone" class="size-4 text-accent" /> Llamar
            </a>
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const label = toggle.querySelector('.sr-only');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
      // `menu-open` bloquea el scroll del fondo y oculta el botón flotante de WhatsApp.
      document.documentElement.classList.toggle('menu-open', open);
      if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    // Si se pasa a escritorio con el menú abierto, se cierra para no dejar el scroll bloqueado.
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
