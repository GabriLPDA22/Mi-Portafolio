---
/**
 * Cabecera flotante: cápsula de cristal con la marca, navegación (la sección visible se marca
 * sola), cambio de idioma y CTA. Una línea dorada en el borde inferior muestra el progreso de
 * lectura. En móvil/tablet, menú a pantalla completa con enlaces grandes numerados.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '@/assets/img/logo-g.webp';
import { getT, homePath, localePath, otherLocale, type Locale } from '@/i18n';
import { SOCIALS } from '@/data/socials';

interface Props {
  locale: Locale;
  /** Ruta sin prefijo de idioma de la página actual, para el cambio de idioma. */
  path?: string;
}

const { locale, path = '/' } = Astro.props;
const t = getT(locale);
const es = locale === 'es';
const home = homePath(locale);
const other = otherLocale(locale);
// La 404 solo existe en español: el cambio de idioma lleva a la portada del otro idioma.
const switchPath = path === '/404' ? '/' : path;

const items = [
  { id: 'proyectos', label: t.nav.projects },
  { id: 'experiencia', label: es ? 'Experiencia' : 'Experience' },
  { id: 'sobre-mi', label: t.nav.about },
  { id: 'servicios', label: es ? 'Capacidades' : 'Skills' },
  { id: 'resultados', label: es ? 'Cómo trabajo' : 'How I work' },
].map((l, i) => ({ ...l, n: String(i + 1).padStart(2, '0'), href: `${home}#${l.id}` }));

const langLabel = other === 'en' ? 'Read in English' : 'Leer en español';
const labels = es ? { open: 'Abrir menú', close: 'Cerrar menú' } : { open: 'Open menu', close: 'Close menu' };
---

<header class="site-header fixed inset-x-0 top-0 z-50 w-full" data-site-header>
  <div class="container-main pt-3 sm:pt-4">
    <div data-header-bar class="header-bar glass relative flex items-center justify-between gap-2 rounded-full py-1.5 pl-2 pr-1.5 sm:py-2 sm:pl-2.5 sm:pr-2">
      <!-- Marca -->
      <a
        href={home}
        data-home-link
        class="group flex min-w-0 items-center gap-2.5 rounded-full py-1 pl-1 pr-3 text-[15px] font-semibold tracking-tight text-ink"
        aria-label={es ? 'gabriel.codes — Gabriel Saiz, inicio' : 'gabriel.codes — Gabriel Saiz, home'}
      >
        <Image src={logo} alt="" height={30} widths={[30, 60]} sizes="30px" class="h-[30px] w-auto shrink-0 transition-transform duration-500 group-hover:rotate-[-8deg]" loading="eager" />
        <span class="truncate">gabriel<span class="text-ink/55">.codes</span></span>
      </a>

      <!-- Navegación de escritorio -->
      <nav class="nav-pill absolute left-1/2 hidden -translate-x-1/2 items-center gap-0.5 rounded-full p-1 lg:flex" aria-label={es ? 'Navegación principal' : 'Main navigation'}>
        {
          items.map((item) => (
            <a href={item.href} data-nav-link={item.id} class="nav-link">
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex shrink-0 items-center gap-1.5">
        <a href={localePath(other, switchPath)} hreflang={other} data-lang-switch class="lang-btn" title={langLabel}>
          <span class="text-ink">{locale.toUpperCase()}</span><span class="text-ink/50">/</span><span class="text-ink/60">{other.toUpperCase()}</span>
          <span class="sr-only" lang={other}> — {langLabel}</span>
        </a>
        <a href={`${home}#contacto`} class="btn btn-volt hidden !min-h-0 !py-1.5 !pl-4 !pr-1.5 !text-[14px] sm:inline-flex">
          {t.nav.contact}
          <span class="btn-icon !h-7 !w-7"><Icon name="ArrowUpRight" class="h-3.5 w-3.5" strokeWidth={2.4} /></span>
        </a>
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={labels.open}
          data-label-open={labels.open}
          data-label-close={labels.close}
          class="menu-btn grid h-10 w-10 place-items-center rounded-full lg:hidden"
        >
          <span class="burger" aria-hidden="true"><span></span><span></span></span>
        </button>
      </div>

      <!-- Progreso de lectura -->
      <span class="header-progress" aria-hidden="true"></span>
    </div>
  </div>

  <!-- Menú móvil: pantalla completa -->
  <div id="mobile-menu" data-menu data-open="false" inert aria-hidden="true" class="mobile-menu lg:hidden">
    <div class="container-main flex h-full flex-col pb-8 pt-24">
      <nav aria-label={es ? 'Menú' : 'Menu'} class="flex flex-col">
        {
          items.map((item, i) => (
            <a href={item.href} class="menu-link group" style={`--i:${i}`}>
              <span class="menu-n">{item.n}</span>
              <span class="flex-1">{item.label}</span>
              <Icon name="ArrowUpRight" class="h-6 w-6 text-ink/30 transition-colors group-hover:text-acid" strokeWidth={1.6} />
            </a>
          ))
        }
      </nav>
      <div class="mt-auto flex flex-col gap-5 pt-10">
        <a href={`${home}#contacto`} class="btn btn-volt w-full justify-between text-[16px]">
          {es ? 'Hablemos' : "Let's talk"}
          <span class="btn-icon"><Icon name="ArrowUpRight" class="h-4 w-4" strokeWidth={2.4} /></span>
        </a>
        <div class="flex items-center justify-between gap-4 text-[14px] text-ink/60">
          <div class="flex gap-5">
            {SOCIALS.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer" data-umami-event={s.label.toLowerCase()} class="hover:text-ink">{s.label}</a>)}
          </div>
          <span>Zaragoza · {es ? 'Remoto' : 'Remote'}</span>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .header-bar {
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 18px 40px -24px rgba(0, 0, 0, 0.9);
    transition:
      transform 0.6s var(--ease-out-expo),
      background-color 0.4s ease;
  }
  /* Al bajar se esconde; al subir vuelve (lo decide motion.ts) */
  :global(.site-header[data-hidden='true']) .header-bar {
    transform: translateY(calc(-100% - 1.25rem));
  }
  .header-progress {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: -1px;
    height: 1px;
    transform-origin: left;
    transform: scaleX(var(--xp, 0));
    background: linear-gradient(90deg, transparent, #a78bfa 30%, #c4b5fd);
    opacity: 0.9;
  }
  .nav-pill {
    background: rgba(255, 255, 255, 0.025);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  .nav-link {
    position: relative;
    border-radius: 999px;
    padding: 0.42rem 0.85rem;
    font-size: 13.5px;
    font-weight: 500;
    color: rgba(237, 237, 242, 0.62);
    transition:
      color 0.3s ease,
      background-color 0.3s ease;
  }
  .nav-link:hover {
    color: #ededf2;
  }
  .nav-link[aria-current='true'] {
    color: #0c0c0f;
    background: #ededf2;
  }
  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    height: 2.5rem;
    border-radius: 999px;
    padding-inline: 0.8rem;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    transition: box-shadow 0.3s ease;
  }
  .lang-btn:hover {
    box-shadow: inset 0 0 0 1px rgba(139, 92, 246, 0.5);
  }
  .menu-btn {
    background: #ededf2;
    color: #0c0c0f;
  }
  .burger {
    position: relative;
    display: block;
    width: 16px;
    height: 10px;
  }
  .burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.5s var(--ease-out-expo),
      top 0.5s var(--ease-out-expo);
  }
  .burger span:first-child {
    top: 1px;
  }
  .burger span:last-child {
    top: 7.4px;
  }
  [aria-expanded='true'] .burger span:first-child {
    top: 4.2px;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .burger span:last-child {
    top: 4.2px;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 60% at 50% 0%, rgba(139, 92, 246, 0.12), transparent 60%),
      #0c0c0f;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s var(--ease-out-expo);
  }
  .mobile-menu[data-open='true'] {
    clip-path: inset(0 0 0 0);
  }
  .menu-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    padding-block: 1.05rem;
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: #ededf2;
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.6s var(--ease-out-expo),
      transform 0.8s var(--ease-out-expo);
  }
  .mobile-menu[data-open='true'] .menu-link {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.12s + var(--i) * 0.05s);
  }
  .menu-n {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    font-weight: 400;
    color: #a78bfa;
    width: 1.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .menu-link {
      transition: none;
    }
  }
</style>
