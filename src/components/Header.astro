---
/**
 * Cabecera: transparente sobre el hero y barra grafito translúcida al hacer scroll.
 * En móvil, menú a pantalla completa (lo gestiona initHeader en scripts/ui.ts).
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '@/assets/img/logo-g.webp';
import { homePath, localePath, otherLocale, type Locale } from '@/i18n';
import { getPro, LINKS } from '@/lib/pro-content';

interface Props {
  locale: Locale;
  /** Ruta sin prefijo de idioma de la página actual, para el cambio de idioma. */
  path?: string;
}

const { locale, path = '/' } = Astro.props;
const p = getPro(locale);
const es = locale === 'es';
const home = homePath(locale);
const other = otherLocale(locale);
// La 404 solo existe en español: el cambio de idioma lleva a la portada del otro idioma.
const switchPath = path === '/404' ? '/' : path;

const items = [
  { id: 'proyectos', label: p.nav.projects },
  { id: 'experiencia', label: p.nav.experience },
  { id: 'stack', label: p.nav.stack },
  { id: 'sobre-mi', label: p.nav.about },
  { id: 'contacto', label: p.nav.contact },
].map((i) => ({ ...i, href: `${home}#${i.id}` }));

const langLabel = other === 'en' ? 'Read in English' : 'Leer en español';
const labels = es ? { open: 'Abrir menú', close: 'Cerrar menú' } : { open: 'Open menu', close: 'Close menu' };
---

<header data-site-header class="site-header fixed inset-x-0 top-0 z-50">
  <div class="container-main flex h-[4.5rem] items-center justify-between gap-4">
    <a href={home} data-home-link class="brand flex shrink-0 items-center gap-2.5">
      <Image src={logo} alt="" height={34} widths={[34, 68]} sizes="34px" class="logo-mark" loading="eager" />
      <span class="text-[17px] font-bold tracking-[-0.01em] [font-stretch:112%]">gabriel<span class="opacity-60">.codes</span></span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label={es ? 'Principal' : 'Main'}>
      {
        items.map((item) => (
          <a href={item.href} data-nav-link={item.id} class="nav-link">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={localePath(other, switchPath)}
        hreflang={other}
        lang={other}
        data-lang-switch
        class="lang"
        aria-label={langLabel}
        title={langLabel}
      >
        {other.toUpperCase()}
      </a>
      <a href={LINKS.cv} download="Gabriel-Saiz-CV.pdf" data-umami-event="descargar-cv" class="btn btn-primary hidden !min-h-[2.5rem] !px-4 !text-[14px] sm:inline-flex">
        <Icon name="Download" strokeWidth={2.2} />
        {p.nav.cv}
      </a>
      <button
        type="button"
        data-menu-toggle
        data-label-open={labels.open}
        data-label-close={labels.close}
        class="menu-btn lg:hidden"
        aria-label={labels.open}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<!-- Menú móvil a pantalla completa -->
<div id="mobile-menu" data-menu data-open="false" inert aria-hidden="true" class="mobile-menu lg:hidden">
  <div class="container-main flex min-h-full flex-col pb-10 pt-28">
    <nav aria-label={es ? 'Menú móvil' : 'Mobile menu'} class="flex-1">
      <ul class="flex flex-col">
        {
          items.map((item, i) => (
            <li class="menu-item" style={`--i:${i}`}>
              <a href={item.href} data-nav-link={item.id} class="menu-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-item mt-10 flex flex-col gap-3" style="--i:5">
      <a href={LINKS.cv} download="Gabriel-Saiz-CV.pdf" data-umami-event="descargar-cv" class="btn btn-primary w-full">
        <Icon name="Download" strokeWidth={2.2} />
        {p.nav.cv}
      </a>
      <div class="flex gap-3">
        <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer" data-umami-event="linkedin" class="btn btn-ghost flex-1">LinkedIn</a>
        <a href={LINKS.github} target="_blank" rel="noopener noreferrer" data-umami-event="github" class="btn btn-ghost flex-1">GitHub</a>
      </div>
      <a href={`mailto:${LINKS.email}`} data-umami-event="email" class="link mt-2 text-center text-[15px] text-muted">{LINKS.email}</a>
    </div>
  </div>
</div>

<script>
  // Fondo de la cabecera en cuanto se hace scroll (sobre el hero va transparente)
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    let frame = 0;
    const update = () => {
      frame = 0;
      header.toggleAttribute('data-scrolled', window.scrollY > 24);
    };
    update();
    window.addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
  }
</script>

<style>
  .brand :global(.logo-mark) {
    height: 2.1rem;
    width: auto;
    filter: drop-shadow(0 0 10px rgba(139, 92, 246, 0.45));
    transition: transform 0.4s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .brand:hover :global(.logo-mark) {
    transform: rotate(-8deg) scale(1.06);
  }
  .site-header {
    color: #ededf2;
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .site-header[data-scrolled] {
    background: rgba(12, 12, 15, 0.78);
    box-shadow: 0 1px 0 rgba(237, 237, 242, 0.07);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .nav-link {
    border-radius: 999px;
    padding: 0.5rem 0.85rem;
    font-size: 15px;
    font-weight: 550;
    color: #8a8a99;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .nav-link:hover {
    color: #ededf2;
  }
  .nav-link[aria-current='true'] {
    color: #ededf2;
    background: rgba(237, 237, 242, 0.07);
  }
  .lang {
    display: inline-grid;
    height: 2.5rem;
    min-width: 2.5rem;
    place-items: center;
    border: 1px solid rgba(237, 237, 242, 0.16);
    color: #8a8a99;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    transition: border-color 0.15s ease;
  }
  .lang:hover {
    border-color: rgba(237, 237, 242, 0.4);
    color: #ededf2;
  }

  .menu-btn {
    position: relative;
    z-index: 60;
    display: inline-grid;
    height: 2.5rem;
    width: 2.5rem;
    place-items: center;
    border-radius: 999px;
    background: #ededf2;
    color: #0c0c0f;
    cursor: pointer;
  }
  @media (min-width: 1024px) {
    .menu-btn {
      display: none;
    }
  }
  .menu-icon {
    position: relative;
    display: block;
    height: 10px;
    width: 18px;
  }
  .menu-icon span {
    position: absolute;
    left: 0;
    height: 2px;
    width: 100%;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.25s ease, top 0.25s ease;
  }
  .menu-icon span:first-child {
    top: 0;
  }
  .menu-icon span:last-child {
    top: 8px;
  }
  .menu-btn[aria-expanded='true'] .menu-icon span {
    top: 4px;
  }
  .menu-btn[aria-expanded='true'] .menu-icon span:first-child {
    transform: rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-icon span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 48; /* por encima del aviso de cookies (45), por debajo de la cabecera (50) */
    overflow-y: auto;
    background:
      radial-gradient(600px circle at 90% 0%, rgba(139, 92, 246, 0.22), transparent 60%),
      #0c0c0f;
    color: #ededf2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .mobile-menu[data-open='true'] {
    opacity: 1;
    pointer-events: auto;
  }
  .menu-link {
    display: block;
    padding: 0.35rem 0;
    font-size: clamp(2.2rem, 10vw, 3.2rem);
    font-weight: 800;
    font-stretch: 118%;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .menu-link[aria-current='true'] {
    color: #a78bfa;
  }
  .menu-item {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .mobile-menu[data-open='true'] .menu-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 40ms + 60ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-item {
      transform: none;
    }
  }
</style>
