---
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import Logo from '@/components/Logo.astro';
import { services } from '@/data/services';
import { normalizePath } from '@/lib/url';

const current = normalizePath(Astro.url.pathname);
const isActive = (path: string) => (path === '/' ? current === '/' : current === path || current.startsWith(`${path}/`));

const links = [
  { label: 'Diseño web Zaragoza', href: '/diseno-web-zaragoza' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Precios', href: '/servicios#precios' },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-ink/75 backdrop-blur-xl backdrop-saturate-150">
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="GabrielCodes, ir a la página de inicio">
      <Logo />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-sm">
        <li class="group relative">
          <a
            href="/servicios"
            class:list={[
              'inline-flex items-center gap-1 rounded-full px-3.5 py-2 transition-colors hover:text-fg',
              isActive('/servicios') || current === '/mantenimiento-web' ? 'text-fg' : 'text-muted',
            ]}
            aria-current={current === '/servicios' ? 'page' : undefined}
          >
            Servicios
            <Icon name="chevronDown" class="size-3.5 transition-transform group-focus-within:rotate-180 group-hover:rotate-180" />
          </a>
          <div
            class="invisible absolute top-full left-1/2 w-[34rem] -translate-x-1/2 translate-y-1 pt-3 opacity-0 transition duration-200 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100"
          >
            <ul class="card grid grid-cols-2 gap-1 bg-ink-2/95 p-2 shadow-2xl shadow-black/60 backdrop-blur-xl">
              {
                services.map((s) => (
                  <li>
                    <a
                      href={s.path}
                      class="block rounded-xl p-3.5 transition-colors hover:bg-white/[0.05]"
                      aria-current={isActive(s.path) ? 'page' : undefined}
                    >
                      <span class="block text-sm font-medium text-fg">{s.name}</span>
                      <span class="mt-1 block text-xs leading-relaxed text-muted">{s.idealFor}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[
                  'inline-flex rounded-full px-3.5 py-2 transition-colors hover:text-fg',
                  isActive(l.href) ? 'text-fg' : 'text-muted',
                ]}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/contacto"
            class:list={[
              'inline-flex rounded-full px-3.5 py-2 transition-colors hover:text-fg',
              isActive('/contacto') ? 'text-fg' : 'text-muted',
            ]}
            aria-current={isActive('/contacto') ? 'page' : undefined}>Contacto</a
          >
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden sm:block">
        <Button href="/contacto#presupuesto" data-cta="header">Solicitar presupuesto</Button>
      </div>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-full border border-line text-fg lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">Abrir menú</span>
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden border-t border-line bg-ink lg:hidden" data-menu>
    <nav aria-label="Móvil" class="container-page max-h-[calc(100dvh-4rem)] overflow-y-auto py-6">
      <p class="eyebrow mb-3">Servicios</p>
      <ul class="grid gap-1">
        {
          services.map((s) => (
            <li>
              <a href={s.path} class="flex items-center justify-between rounded-xl px-3 py-3 text-base text-fg hover:bg-white/5">
                {s.name}
                <Icon name="arrowRight" class="size-4 text-muted" />
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mt-6 grid gap-1 border-t border-line pt-6">
        {
          [...links, { label: 'Todos los servicios', href: '/servicios' }, { label: 'Contacto', href: '/contacto' }].map((l) => (
            <li>
              <a href={l.href} class="block rounded-xl px-3 py-3 text-base text-soft hover:bg-white/5 hover:text-fg">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/contacto#presupuesto" size="lg" class="mt-6 w-full" data-cta="mobile-menu">
        Solicitar presupuesto
      </Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const label = toggle.querySelector('.sr-only');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      document.documentElement.classList.toggle('overflow-hidden', open);
      if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>
