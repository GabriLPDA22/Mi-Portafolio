---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import PricingCards from '@/components/sections/PricingCards.astro';
import FaqSection from '@/components/sections/FaqSection.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import Icon from '@/components/ui/Icon.astro';
import { services, formatPrice } from '@/data/services';
import { generalFaqs } from '@/data/faqs';
import { serviceSchema, faqSchema } from '@/lib/schema';

const breadcrumbs = [{ name: 'Servicios', path: '/servicios' }];

const comparison = [
  { label: 'Número de páginas', values: ['1', 'Hasta 6', 'Hasta 6 + reservas', '—'] },
  { label: 'Diseño a medida', values: [true, true, true, '—'] },
  { label: 'SEO local', values: ['Básico', true, true, 'Seguimiento'] },
  { label: 'Formulario y WhatsApp', values: [true, true, true, '—'] },
  { label: 'Reservas o citas online', values: [false, false, true, '—'] },
  { label: 'Pagos o señal online', values: [false, false, 'Opcional', '—'] },
  { label: 'Plazo de entrega', values: services.map((s) => s.delivery) },
];
---

<BaseLayout
  title="Servicios de Diseño Web y Precios | GabrielCodes"
  description="Landing pages desde 300 €, webs profesionales para empresas desde 700 €, webs con reservas online desde 900 € y mantenimiento web desde 25 €/mes. Compara y elige."
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
  schema={[...services.map(serviceSchema), faqSchema(generalFaqs.slice(0, 4))]}
>
  <PageHero
    eyebrow="Servicios"
    breadcrumbs={breadcrumbs}
    lead="Cuatro formas de trabajar según lo que necesite tu negocio, con precios orientativos desde el principio. Todas incluyen diseño a medida, adaptación a móvil y optimización para Google."
  >
    Servicios de diseño y desarrollo web para negocios
  </PageHero>

  <section class="section" aria-labelledby="lista-title">
    <div class="container-page">
      <h2 id="lista-title" class="sr-only">Nuestros servicios</h2>
      <div class="grid gap-5 md:grid-cols-2">
        {
          services.map((s) => (
            <article class="reveal group card card-hover relative p-7 sm:p-9">
              <p class="text-sm font-medium text-accent">{formatPrice(s.price)}</p>
              <h3 class="mt-3 text-2xl font-semibold text-fg">
                <a href={s.path} class="after:absolute after:inset-0 after:content-['']">
                  {s.name}
                </a>
              </h3>
              <p class="mt-4 leading-relaxed text-muted">{s.summary}</p>
              <p class="mt-4 text-sm text-soft">
                <span class="text-muted">Ideal para:</span> {s.idealFor}
              </p>
              <p class="mt-7 inline-flex items-center gap-1.5 text-sm font-medium text-fg">
                Más información
                <Icon name="arrowRight" class="size-4 text-accent transition-transform group-hover:translate-x-1" />
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="precios" class="section border-t border-line bg-ink-2" aria-labelledby="precios-title">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Precios</p>
        <h2 id="precios-title" class="heading-lg mt-4">Precios de páginas web</h2>
        <p class="lead mt-5">Rangos orientativos. Tras una llamada corta te enviamos un presupuesto cerrado para tu caso.</p>
      </div>
      <div class="mt-16">
        <PricingCards showMaintenance />
      </div>
      <p class="mt-4 text-center text-sm text-muted">
        ¿Presupuesto ajustado? Mira nuestras
        <a href="/paginas-web-economicas" class="text-accent underline underline-offset-4">páginas web económicas</a>.
      </p>
    </div>
  </section>

  <section class="section border-t border-line" aria-labelledby="comparativa-title">
    <div class="container-page">
      <p class="eyebrow">Comparativa</p>
      <h2 id="comparativa-title" class="heading-lg mt-4">¿Qué tipo de web necesito?</h2>
      <div class="mt-12 overflow-x-auto rounded-[var(--radius-card)] border border-line">
        <table class="w-full min-w-[44rem] text-left text-sm">
          <caption class="sr-only">Comparativa de servicios de diseño web</caption>
          <thead class="bg-surface text-fg">
            <tr>
              <th scope="col" class="p-4 font-medium">Característica</th>
              {services.map((s) => <th scope="col" class="p-4 font-medium">{s.name}</th>)}
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              comparison.map((row) => (
                <tr>
                  <th scope="row" class="p-4 font-normal text-soft">
                    {row.label}
                  </th>
                  {row.values.map((v) => (
                    <td class="p-4 text-muted">
                      {v === true ? (
                        <Icon name="check" class="size-4 text-accent" label="Incluido" />
                      ) : v === false ? (
                        <span class="text-white/30">
                          <span aria-hidden="true">—</span>
                          <span class="sr-only">No incluido</span>
                        </span>
                      ) : (
                        v
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <div class="border-t border-line">
    <FaqSection faqs={generalFaqs.slice(0, 4)} />
  </div>

  <CtaSection />
</BaseLayout>
