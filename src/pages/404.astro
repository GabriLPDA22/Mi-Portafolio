---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Mascot from '@/components/Mascot.astro';
---

<BaseLayout locale="es" path="/404" title="404" description="Esta página no existe." noindex>
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 pt-20 text-center">
    <p class="hud-chip">Error 404 · Nivel no encontrado</p>
    <h1 class="game-title -rotate-2 text-[clamp(3rem,12vw,6.5rem)]">Game over</h1>
    <div class="relative">
      <Mascot class="h-[168px] w-auto" label="Gabriel en pixel art, perdido" />
      <span class="font-pixel absolute -right-10 top-2 text-2xl text-acid" aria-hidden="true">?</span>
    </div>
    <p class="max-w-sm text-ink/75">Este nivel no existe (todavía). <span lang="en">This level doesn't exist.</span></p>
    <p class="font-pixel text-[12px] uppercase tracking-widest text-ink/70">¿Continuar?</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="start-btn text-[15px] font-black uppercase">▶ Sí, volver al inicio</a>
      <a href="/en" class="game-btn game-btn-ghost" lang="en">English</a>
    </div>
  </main>
</BaseLayout>
