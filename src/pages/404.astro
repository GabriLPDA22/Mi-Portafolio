---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
---

<BaseLayout title="Página no encontrada | Gabriel Saiz" description="La página que buscas no existe o ha cambiado de dirección." noindex>
  <section class="section">
    <div class="container-page max-w-2xl text-center">
      <p class="font-mono text-sm text-accent">Error 404</p>
      <h1 class="heading-lg mt-4">Esta página no existe</h1>
      <p class="lead mt-6">Puede que el enlace haya cambiado. Todo lo importante está en la portada.</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/" size="lg">Ir al inicio</Button>
        <Button href={site.documents.cv} variant="secondary" size="lg" download>Descargar CV</Button>
      </div>
    </div>
  </section>
</BaseLayout>
