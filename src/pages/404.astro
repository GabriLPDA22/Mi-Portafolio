---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Esta página no existe." path="/404" noindex>
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center">
    <p class="font-code text-sm tracking-[0.2em] text-acid uppercase">404</p>
    <h1 class="font-display text-3xl font-bold text-ink sm:text-5xl">Esta página no existe</h1>
    <a href="/" class="rounded-full bg-acid px-6 py-3 text-sm font-bold text-noir transition-colors hover:bg-acid-light">Volver al inicio</a>
  </main>
</BaseLayout>
