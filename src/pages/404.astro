---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout locale="es" path="/404" title="404" description="Esta página no existe." noindex>
  <main id="main-content" class="relative isolate flex min-h-svh flex-col items-center justify-center overflow-hidden px-4 pt-20 text-center">
    <div aria-hidden="true" class="grid-lines absolute inset-0 -z-10"></div>
    <p class="badge">Error 404</p>
    <h1 class="display text-metal mt-6 text-[clamp(6rem,30vw,16rem)]">404</h1>
    <p class="mt-4 text-[clamp(1.25rem,4vw,1.75rem)] font-medium tracking-tight text-ink/90">
      Esta página <span class="serif text-gold">no existe</span>.
    </p>
    <p class="lead mt-2"><span lang="en">This page doesn't exist.</span></p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-volt">
        Volver al inicio
        <span class="btn-icon"><Icon name="ArrowUpRight" class="h-4 w-4" strokeWidth={2.4} /></span>
      </a>
      <a href="/en" class="btn btn-ghost" lang="en">English</a>
      <button type="button" data-arcade-open hidden data-umami-event="jugar-bug-run" class="btn btn-ghost has-icon">
        Insert coin
        <span class="btn-icon"><Icon name="Gamepad2" class="h-4 w-4" /></span>
      </button>
    </div>
  </main>
</BaseLayout>
