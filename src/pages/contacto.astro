---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, whatsappUrl, PHONE_PLACEHOLDER } from '@/config/site';

const breadcrumbs = [{ name: 'Contacto', path: '/contacto' }];

const nextSteps = [
  'Leemos tu solicitud y te respondemos en menos de 24 h laborables.',
  'Hacemos una llamada o reunión de 20 minutos para entender tu negocio.',
  'Te enviamos un presupuesto cerrado con precio, plazo y lo que incluye.',
];
---

<BaseLayout
  title="Contacto y Presupuesto de Página Web | GabrielCodes"
  description="Pide presupuesto para tu página web en Zaragoza. Rellena el formulario o escríbenos por WhatsApp y te respondemos en menos de 24 horas. Sin compromiso."
  breadcrumbs={breadcrumbs}
  pageType="ContactPage"
>
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-page relative grid gap-14 pt-10 pb-20 sm:pt-14 lg:grid-cols-12 lg:pb-28">
      <div class="lg:col-span-5">
        <Breadcrumbs items={breadcrumbs} />
        <p class="eyebrow mt-10">Contacto</p>
        <h1 class="heading-lg mt-5">Solicita tu presupuesto de página web</h1>
        <p class="lead mt-6">
          Cuéntanos qué necesitas y te enviamos un presupuesto cerrado en menos de 24 horas. Sin compromiso y sin tecnicismos.
        </p>

        <h2 class="mt-12 text-sm font-semibold tracking-[0.18em] text-muted uppercase">Qué pasa después</h2>
        <ol class="mt-5 grid gap-4">
          {
            nextSteps.map((s, i) => (
              <li class="flex gap-4 text-soft">
                <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full border border-accent/40 text-xs font-semibold text-accent">
                  {i + 1}
                </span>
                <span class="pt-0.5">{s}</span>
              </li>
            ))
          }
        </ol>

        <h2 class="mt-12 text-sm font-semibold tracking-[0.18em] text-muted uppercase">¿Prefieres hablar directamente?</h2>
        <ul class="mt-5 grid gap-3">
          <li>
            <a
              href={whatsappUrl()}
              target="_blank"
              rel="noopener"
              class="card card-hover flex items-center gap-4 p-4"
              data-cta="contact-whatsapp"
            >
              <span class="inline-flex size-10 items-center justify-center rounded-full bg-[#25D366]/15 text-[#25D366]">
                <Icon name="messageCircle" class="size-5" />
              </span>
              <span>
                <span class="block font-medium text-fg">WhatsApp</span>
                <span class="block text-sm text-muted">La forma más rápida de contactar</span>
              </span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.contact.email}`} class="card card-hover flex items-center gap-4 p-4" data-cta="contact-email">
              <span class="inline-flex size-10 items-center justify-center rounded-full bg-accent/10 text-accent">
                <Icon name="mail" class="size-5" />
              </span>
              <span>
                <span class="block font-medium text-fg">Email</span>
                <span class="block text-sm text-muted">{site.contact.email}</span>
              </span>
            </a>
          </li>
          {
            !PHONE_PLACEHOLDER && (
              <li>
                <a href={`tel:+${site.contact.phoneE164}`} class="card card-hover flex items-center gap-4 p-4" data-cta="contact-phone">
                  <span class="inline-flex size-10 items-center justify-center rounded-full bg-accent/10 text-accent">
                    <Icon name="phone" class="size-5" />
                  </span>
                  <span>
                    <span class="block font-medium text-fg">Teléfono</span>
                    <span class="block text-sm text-muted">{site.contact.phoneDisplay}</span>
                  </span>
                </a>
              </li>
            )
          }
        </ul>
        <p class="mt-6 flex items-center gap-2 text-sm text-muted">
          <Icon name="mapPin" class="size-4 text-accent" />
          {site.address.locality} y alrededores · {site.openingHours.display}
        </p>
      </div>

      <div id="presupuesto" class="scroll-mt-24 lg:col-span-7">
        <div class="card p-6 sm:p-10">
          <h2 class="text-2xl font-semibold text-fg">Formulario de presupuesto</h2>
          <p class="mt-2 mb-8 text-sm text-muted">Los campos marcados con <span class="text-accent">*</span> son obligatorios.</p>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
