---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/data/projects';
import { absoluteUrl } from '@/config/site';
import { ids } from '@/lib/schema';

const breadcrumbs = [{ name: 'Proyectos', path: '/proyectos' }];
const clientWork = projects.filter((p) => p.kind === 'cliente');
const academicWork = projects.filter((p) => p.kind === 'academico');

const itemList = {
  '@type': 'ItemList',
  name: 'Proyectos de diseño web',
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: p.name,
      description: p.solution,
      genre: p.sector,
      image: absoluteUrl(p.image.src),
      creator: { '@id': ids.business },
      ...(p.url ? { url: p.url } : {}),
    },
  })),
};
---

<BaseLayout
  title="Proyectos de Diseño Web y Casos Reales | GabrielCodes"
  description="Ejemplos de páginas web, landing pages y webs con reservas que hemos diseñado y desarrollado: el reto de cada negocio y cómo lo resolvimos."
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
  schema={[itemList]}
>
  <PageHero
    eyebrow="Proyectos"
    breadcrumbs={breadcrumbs}
    lead="Webs y apps en producción para clientes reales, y los proyectos técnicos de formación que están detrás de lo que hacemos hoy."
  >
    Proyectos de diseño y desarrollo web
  </PageHero>

  <section class="section" aria-labelledby="clientes-title">
    <div class="container-page">
      <p class="eyebrow">En producción</p>
      <h2 id="clientes-title" class="heading-lg mt-4">Trabajos para clientes</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {clientWork.map((p) => <ProjectCard project={p} detailed />)}
      </div>
    </div>
  </section>

  {
    academicWork.length > 0 && (
      <section class="section border-t border-line bg-ink-2" aria-labelledby="academicos-title">
        <div class="container-page">
          <p class="eyebrow">Formación</p>
          <h2 id="academicos-title" class="heading-lg mt-4">Proyectos académicos</h2>
          <p class="lead mt-5 max-w-2xl">
            Desarrollos completos hechos durante la formación en Desarrollo de Aplicaciones Web, incluido el TFG. No son
            encargos de clientes, pero usan las mismas tecnologías que aplicamos en los proyectos reales.
          </p>
          <div class="mt-12 grid gap-6 md:grid-cols-2">
            {academicWork.map((p) => <ProjectCard project={p} detailed />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaSection title="¿Tu negocio es el próximo?" />
</BaseLayout>
