---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import TechIcon from '@/components/TechIcon.astro';
import ContactForm from '@/components/ContactForm.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import photo from '@/assets/team/gabriel-saiz.webp';
import nasaImage from '@/assets/achievements/nasa-space-apps.webp';
import { site } from '@/config/site';
import { experience, education, achievements, skills, supportingSkills, alsoUsed, marquee, stats } from '@/data/profile';
import { projects } from '@/data/projects';
import { tech, type Tech } from '@/data/tech';
import { profilePageSchema, projectsSchema } from '@/lib/schema';

const featured = projects.find((p) => p.featured)!;
const others = projects.filter((p) => !p.featured);

// Cada grupo del carrusel repite la lista dos veces para superar el ancho de cualquier pantalla.
const marqueeGroup: Tech[] = [...marquee, ...marquee].map((id) => tech[id]);

const skillIcons = ['layout', 'smartphone', 'server'] as const;

const medalStyles = {
  gold: { label: 'Ganador', class: 'bg-lime text-lime-ink' },
  finalist: { label: 'Finalista', class: 'bg-accent text-accent-ink' },
  participant: { label: 'Participante', class: 'bg-fg/[0.07] text-fg' },
} as const;

const lookingFor = [
  'Puesto full-stack web y/o mobile: .NET, Vue 3 o React Native',
  'Empresa con producto propio y equipo técnico con el que aprender',
  'También abierto a backend con PHP y Symfony',
  'Zaragoza presencial o híbrido, o remoto desde España',
  'Incorporación inmediata',
];

// Texto del sello circular del hero (se repite alrededor del círculo).
const stampText = 'Disponible · Full-Stack · Zaragoza · ';
---

<BaseLayout
  title="Gabriel Saiz — Desarrollador Full-Stack .NET, Vue y React Native"
  description="Desarrollador Full-Stack en Zaragoza: apps en App Store y Google Play, backend .NET + PostgreSQL y frontend Vue 3. Disponible para incorporación inmediata."
  schema={[profilePageSchema(), projectsSchema()]}
>
  <!-- ============================== HERO ============================== -->
  <section id="inicio" class="relative overflow-x-clip">
    <div class="dot-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="container-page relative grid items-center gap-16 pt-12 pb-16 sm:pt-16 lg:grid-cols-12 lg:gap-8 lg:pt-20 lg:pb-20">
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2.5 rounded-full border border-line-strong bg-card py-1.5 pr-4 pl-3 text-sm font-medium text-soft">
          <span class="status-dot" aria-hidden="true"></span>
          Disponible · {site.availability.toLowerCase()}
        </p>

        <h1 class="mt-7">
          <span class="block font-sans text-lg font-medium tracking-normal text-muted sm:text-xl">Hola, soy {site.name} 👋</span>
          <span class="heading-xl mt-4 block">
            Desarrollador Full&#8209;Stack <span class="serif-accent pr-1">web &amp; mobile</span>
          </span>
        </h1>

        <p class="lead mt-7 max-w-xl">
          Construyo <strong class="marker font-semibold text-fg">de punta a punta</strong>: APIs en .NET, aplicaciones web con Vue y apps
          con React Native publicadas en App Store y Google Play. Busco un equipo con producto propio donde aportar desde el primer día.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={site.documents.cv} download class="btn btn-primary group" data-cta="hero-cv">
            <Icon name="download" class="size-5 transition-transform group-hover:translate-y-0.5" />
            Descargar CV
          </a>
          <a href="#contacto" class="btn btn-outline group" data-cta="hero-contact">
            Hablemos
            <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
          </a>
          <div class="flex gap-2 sm:ml-1">
            <a href={site.social.linkedin} target="_blank" rel="noopener me" class="icon-btn" data-cta="hero-linkedin">
              <Icon name="linkedin" class="size-5" label="LinkedIn" />
            </a>
            <a href={site.social.github} target="_blank" rel="noopener me" class="icon-btn" data-cta="hero-github">
              <Icon name="github" class="size-5" label="GitHub" />
            </a>
          </div>
        </div>

        <ul class="mt-10 flex flex-wrap gap-2">
          <li class="chip gap-1.5"><Icon name="mapPin" class="size-3.5 text-accent" />Zaragoza · remoto</li>
          <li class="chip gap-1.5"><Icon name="smartphone" class="size-3.5 text-accent" />Apps en App Store y Google Play</li>
          <li class="chip gap-1.5"><Icon name="graduationCap" class="size-3.5 text-accent" />DAW · TFG 10 MH</li>
        </ul>
      </div>

      <!-- Retrato en duotono con sello giratorio -->
      <div class="relative mx-auto w-full max-w-[20rem] sm:max-w-[22rem] lg:col-span-5 lg:max-w-[24rem]">
        <div class="duotone rotate-2 overflow-hidden rounded-[2rem] border-2 border-fg shadow-[10px_10px_0_0_var(--color-fg)]">
          <Picture
            src={photo}
            alt={`Retrato de ${site.name}, desarrollador full-stack`}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[360, 540, 720]}
            sizes="(min-width: 1024px) 384px, 352px"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] w-full object-cover object-[50%_20%]"
          />
        </div>

        <p class="absolute top-6 -right-3 -rotate-3 rounded-full border-2 border-fg bg-card px-3.5 py-1.5 text-xs font-semibold text-fg sm:-right-8">
          <span aria-hidden="true">🏆</span> Ganador NASA Space Apps
        </p>

        <div class="absolute -bottom-10 -left-4 size-28 sm:-left-10 sm:size-32" aria-hidden="true">
          <svg viewBox="0 0 100 100" class="stamp size-full">
            <defs><path id="stamp-circle" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"></path></defs>
            <circle cx="50" cy="50" r="49" fill="#2B3AFF"></circle>
            <text fill="#FFFFFF" font-size="9" font-weight="600" font-family="ui-monospace, monospace">
              <textPath href="#stamp-circle" textLength="236" lengthAdjust="spacing">{stampText.toUpperCase()}</textPath>
            </text>
          </svg>
          <svg viewBox="0 0 32 32" class="absolute inset-0 m-auto size-9">
            <path d="M13 10.5 8 16l5 5.5M19 10.5l5 5.5-5 5.5" fill="none" stroke="#D4FF3F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Carrusel infinito de tecnologías sobre la palabra STACK gigante en contorno -->
    <div class="relative overflow-x-clip py-16 sm:py-24">
      <span class="bg-word top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 !text-[clamp(6rem,24vw,20rem)]" aria-hidden="true">
        Stack
      </span>
      <p class="sr-only">Tecnologías: {marquee.map((id) => tech[id].name).join(', ')}.</p>
      <div class="marquee relative z-10" style="--marquee-duration: 60s">
        {
          [0, 1].map(() => (
            <ul class="marquee-group" aria-hidden="true">
              {marqueeGroup.map((t) => (
                <li class="group/item flex shrink-0 items-center">
                  <span class="flex items-center gap-4 px-8 text-fg transition-colors duration-300 group-hover/item:text-accent sm:px-12">
                    {t.path && <TechIcon tech={t} class:list={[t.wordmark ? 'h-16 w-auto sm:h-24' : 'size-9 sm:size-12']} />}
                    {!t.wordmark && (
                      <span class="font-display text-3xl font-bold tracking-tight whitespace-nowrap sm:text-5xl">{t.name}</span>
                    )}
                  </span>
                  <span class="text-lg text-accent sm:text-2xl" aria-hidden="true">✦</span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>

    <!-- Cifras -->
    <div class="container-page">
      <dl class="mb-20 grid grid-cols-2 border-y border-fg lg:grid-cols-4">
        {
          stats.map((s, i) => (
            <div
              class:list={[
                'flex flex-col px-4 py-8 sm:px-6',
                i % 2 === 1 && 'border-l border-line-strong',
                i >= 2 && 'border-t border-line-strong lg:border-t-0',
                i === 2 && 'lg:border-l',
              ]}
            >
              <dt class="order-2 mt-3 text-sm leading-snug text-muted">{s.label}</dt>
              <dd class="font-display text-5xl leading-none font-bold tracking-tight text-fg sm:text-6xl">
                {s.value}
                <span class="text-accent">.</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============================== PROYECTOS ============================== -->
  <section id="proyectos" class="section overflow-x-clip" aria-labelledby="proyectos-title">
    <div class="container-page">
      <SectionHeading
        id="proyectos-title"
        number="01"
        eyebrow="Proyectos"
        title="Producto real,"
        accent="en producción"
        lead="De la base de datos a la app en la store. Esto es lo que he construido."
      />

      <!-- Proyecto destacado -->
      <article class="reveal theme-dark mt-14 grid overflow-hidden rounded-[2rem] lg:grid-cols-12">
        <div class="flex flex-col p-7 sm:p-10 lg:col-span-7 lg:p-12">
          <p class="inline-flex items-center gap-2 self-start rounded-full bg-lime px-3 py-1 text-xs font-semibold text-lime-ink">
            <span class="status-dot scale-75" aria-hidden="true"></span>
            {featured.label}
          </p>
          <h3 class="mt-6 text-4xl font-bold text-fg sm:text-5xl">{featured.name}</h3>
          <p class="mt-3 font-serif text-2xl text-accent italic">{featured.tagline}</p>
          <p class="mt-5 leading-relaxed text-muted">{featured.description}</p>
          <ul class="mt-6 grid gap-3 text-sm text-soft">
            {
              featured.highlights.map((h) => (
                <li class="flex gap-3">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-lime" />
                  {h}
                </li>
              ))
            }
          </ul>
          <ul class="mt-7 flex flex-wrap gap-2" aria-label="Tecnologías">
            {featured.stack.map((t) => <li class="chip">{t}</li>)}
          </ul>
          <div class="mt-9 flex flex-wrap gap-3">
            {
              featured.links.map((l) => (
                <a href={l.url} target="_blank" rel="noopener" class="btn bg-lime text-lime-ink hover:bg-fg">
                  <TechIcon tech={tech.appStore} class="size-5" />
                  {l.label}
                  <Icon name="arrowUpRight" class="size-4" />
                </a>
              ))
            }
          </div>
        </div>
        <div class="relative order-first flex items-center justify-center overflow-hidden bg-[#2B3AFF] p-10 lg:order-none lg:col-span-5">
          <div class="dot-grid absolute inset-0 opacity-60 invert" aria-hidden="true"></div>
          <div class="absolute size-[26rem] rounded-full border border-white/20" aria-hidden="true"></div>
          <div class="absolute size-[18rem] rounded-full border border-white/25" aria-hidden="true"></div>
          <div class="relative mx-auto w-[62%] max-w-[16rem]">
            <Picture
              src={featured.image}
              alt={featured.imageAlt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[240, 440]}
              sizes="260px"
              loading="lazy"
              pictureAttributes={{ class: 'block' }}
              class="mx-auto block h-auto w-full rotate-3 drop-shadow-[0_40px_40px_rgb(0_0_0/0.45)] transition-transform duration-700 ease-(--ease-out-expo) hover:rotate-0"
            />
          </div>
        </div>
      </article>

      <!-- Resto de proyectos -->
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {
          others.map((p, i) => (
            <article class="reveal spotlight group card card-hover flex flex-col overflow-hidden">
              <div class="relative bg-bg-2 p-4 pb-0">
                <span class="absolute top-3 right-4 z-10 font-mono text-xs text-muted">0{i + 2}</span>
                <div class="overflow-hidden rounded-t-xl border border-b-0 border-line-strong bg-card">
                  <div class="flex items-center gap-1.5 border-b border-line px-3 py-2" aria-hidden="true">
                    <span class="size-2 rounded-full bg-[#ff5f57]" />
                    <span class="size-2 rounded-full bg-[#febc2e]" />
                    <span class="size-2 rounded-full bg-[#28c840]" />
                  </div>
                  <Picture
                    src={p.image}
                    alt={p.imageAlt}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[400, 640, 900]}
                    sizes="(min-width: 768px) 360px, 100vw"
                    loading="lazy"
                    class="aspect-[16/10] w-full object-cover object-top transition-transform duration-700 ease-(--ease-out-expo) group-hover:scale-[1.04]"
                  />
                </div>
              </div>
              <div class="flex flex-1 flex-col border-t border-line p-6">
                <p class="font-mono text-[0.72rem] font-medium tracking-wide text-accent uppercase">{p.label}</p>
                <h3 class="mt-3 text-2xl font-bold text-fg">{p.name}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{p.description}</p>
                <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías">
                  {p.stack.map((t) => <li class="chip">{t}</li>)}
                </ul>
                <div class="mt-auto pt-6">
                  {p.links.map((l) => (
                    <a
                      href={l.url}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1.5 text-sm font-semibold text-fg underline decoration-accent decoration-2 underline-offset-4 hover:text-accent"
                    >
                      {l.label}
                      <span class="sr-only"> de {p.name}</span>
                      <Icon name="arrowUpRight" class="size-4" />
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================== EXPERIENCIA ============================== -->
  <section id="experiencia" class="section theme-dark overflow-x-clip" aria-labelledby="experiencia-title">
    <div class="container-page grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <SectionHeading
            id="experiencia-title"
            number="02"
            eyebrow="Experiencia"
            bg="Trayectoria"
            title="Dónde he"
            accent="trabajado"
            lead="Apps publicadas, clientes reales y pipelines que despliegan solos."
          />
          <a
            href={site.documents.recommendation}
            target="_blank"
            rel="noopener"
            class="group mt-8 flex items-center gap-4 rounded-2xl border border-line-strong p-4 transition hover:border-lime"
            data-cta="recommendation-letter"
          >
            <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-lime text-lime-ink">
              <Icon name="fileText" class="size-5" />
            </span>
            <span>
              <span class="block text-sm font-semibold text-fg">Carta de recomendación</span>
              <span class="block text-xs text-muted">GOLIVE Services · PDF</span>
            </span>
            <Icon name="arrowUpRight" class="ml-auto size-4 text-muted transition group-hover:text-lime" />
          </a>
        </div>
      </div>

      <ol class="relative lg:col-span-8">
        <span class="absolute top-2 bottom-2 left-[7px] w-px bg-line-strong" aria-hidden="true"></span>
        {
          experience.map((e, i) => (
            <li class="reveal relative pb-10 pl-10 last:pb-0">
              <span
                class:list={['absolute top-7 left-0 size-[15px] rounded-full border-2 border-lime', i === 0 ? 'bg-lime' : 'bg-bg']}
                aria-hidden="true"
              />
              <div class="spotlight rounded-[var(--radius-card)] border border-line bg-card p-6 sm:p-8">
                <p class="inline-flex rounded-full border border-lime/40 px-2.5 py-0.5 font-mono text-xs text-lime">{e.period}</p>
                <h3 class="mt-4 text-2xl font-bold text-fg">{e.role}</h3>
                <p class="mt-1 text-soft">
                  {e.url ? (
                    <a href={e.url} target="_blank" rel="noopener" class="font-semibold underline decoration-lime/50 underline-offset-4 hover:decoration-lime">
                      {e.company}
                    </a>
                  ) : (
                    <span class="font-semibold">{e.company}</span>
                  )}
                  <span class="text-muted"> · {e.location}</span>
                </p>
                <p class="mt-4 leading-relaxed text-muted">{e.summary}</p>
                <ul class="mt-4 grid gap-2.5 text-sm leading-relaxed text-soft">
                  {e.bullets.map((b) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.45rem] size-1.5 shrink-0 rotate-45 bg-lime" aria-hidden="true" />
                      {b}
                    </li>
                  ))}
                </ul>
                <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tecnologías">
                  {e.stack.map((t) => <li class="chip">{t}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================== STACK ============================== -->
  <section id="stack" class="section overflow-x-clip" aria-labelledby="stack-title">
    <div class="container-page">
      <SectionHeading
        id="stack-title"
        number="03"
        eyebrow="Stack"
        title="Web y mobile sobre"
        accent="un backend .NET"
        lead="Tres piezas que domino y que uso juntas: The Arch es el ejemplo completo."
      />

      <!-- Stack principal -->
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {
          skills.map((g, i) => (
            <div class="reveal spotlight card flex flex-col p-7">
              <div class="flex items-center justify-between">
                <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-fg text-bg">
                  <Icon name={skillIcons[i]} class="size-5" />
                </span>
                <span class="font-mono text-xs text-muted">0{i + 1}</span>
              </div>
              <h3 class="mt-6 text-3xl font-bold text-fg">{g.group}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{g.description}</p>
              <ul class="mt-7 grid grid-cols-2 gap-2.5">
                {g.items.map((id) => (
                  <li class="group/tile flex flex-col items-center gap-2.5 rounded-2xl border border-line bg-bg px-2 py-5 text-center transition hover:-translate-y-0.5 hover:border-fg">
                    <TechIcon tech={tech[id]} class="size-9 transition-transform duration-300 group-hover/tile:scale-110" branded />
                    <span class="text-sm leading-tight font-medium text-soft">{tech[id].name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <!-- Apoyo: infraestructura y otras tecnologías -->
      <div class="reveal mt-5 grid gap-8 rounded-[var(--radius-card)] border border-dashed border-line-strong p-7 md:grid-cols-2">
        <div>
          <h3 class="flex items-center gap-2 font-sans text-sm font-semibold tracking-normal text-fg">
            <Icon name="cloud" class="size-4 text-accent" /> Despliegue e infraestructura
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              supportingSkills.map((id) => (
                <li class="inline-flex items-center gap-2 rounded-full border border-line bg-card py-1.5 pr-3.5 pl-2 text-sm text-soft">
                  <TechIcon tech={tech[id]} class="size-4.5" branded />
                  {tech[id].name}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="flex items-center gap-2 font-sans text-sm font-semibold tracking-normal text-fg">
            <Icon name="code" class="size-4 text-accent" /> También he trabajado con
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              alsoUsed.map((id) => (
                <li class="inline-flex items-center gap-2 rounded-full border border-line py-1.5 pr-3.5 pl-2 text-sm text-muted">
                  <TechIcon tech={tech[id]} class="size-4.5 opacity-85" branded />
                  {tech[id].name}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== LOGROS Y FORMACIÓN ============================== -->
  <section id="logros" class="section overflow-x-clip border-y border-line bg-bg-2" aria-labelledby="logros-title">
    <div class="container-page">
      <SectionHeading id="logros-title" number="04" eyebrow="Logros" bg="Premios" title="Premios y" accent="competiciones" />

      <div class="mt-14 grid gap-5 lg:grid-cols-2">
        <article class="reveal card relative overflow-hidden lg:row-span-3">
          <Picture
            src={nasaImage}
            alt="Equipo ganador de la edición de Zaragoza del NASA Space Apps Challenge 2023"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 560px, 100vw"
            loading="lazy"
            class="aspect-[16/9] w-full border-b border-line object-cover lg:aspect-auto lg:h-72"
          />
          <div class="p-7">
            <p class={`inline-flex rounded-full px-3 py-1 text-xs font-semibold ${medalStyles[achievements[0].medal].class}`}>
              🏆 {medalStyles[achievements[0].medal].label} · {achievements[0].year}
            </p>
            <h3 class="mt-4 text-3xl font-bold text-fg">{achievements[0].title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{achievements[0].detail}</p>
          </div>
        </article>
        {
          achievements.slice(1).map((a) => (
            <article class="reveal spotlight card card-hover flex gap-5 p-6">
              <span class={`inline-flex size-12 shrink-0 items-center justify-center rounded-2xl ${medalStyles[a.medal].class}`}>
                <Icon name="award" class="size-6" />
              </span>
              <div>
                <p class="font-mono text-[0.72rem] font-medium tracking-wide text-muted uppercase">
                  {medalStyles[a.medal].label} · {a.year}
                </p>
                <h3 class="mt-1.5 text-xl font-bold text-fg">{a.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{a.detail}</p>
              </div>
            </article>
          ))
        }
      </div>

      <h2 id="formacion-title" class="heading-md mt-24 flex items-center gap-3">
        <span class="inline-flex size-10 items-center justify-center rounded-xl bg-fg text-bg"><Icon name="graduationCap" class="size-5" /></span>
        Formación
      </h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          education.map((e) => (
            <article class="reveal spotlight card p-7">
              <p class="font-mono text-xs font-medium text-accent">{e.period}</p>
              <h3 class="mt-3 text-xl font-bold text-fg">{e.title}</h3>
              <p class="mt-1 text-sm text-soft">{e.center}</p>
              <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-muted">
                {e.bullets.map((b) => (
                  <li class="flex gap-3">
