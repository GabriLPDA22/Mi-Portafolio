---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import TechIcon from '@/components/TechIcon.astro';
import ContactForm from '@/components/ContactForm.astro';
import photo from '@/assets/team/gabriel-saiz.webp';
import nasaImage from '@/assets/achievements/nasa-space-apps.webp';
import { site } from '@/config/site';
import { experience, education, achievements, skills, marquee, stats } from '@/data/profile';
import { projects } from '@/data/projects';
import { tech, type Tech } from '@/data/tech';
import { profilePageSchema, projectsSchema } from '@/lib/schema';

const featured = projects.find((p) => p.featured)!;
const others = projects.filter((p) => !p.featured);

// Cada grupo del carrusel repite la lista dos veces para superar el ancho de cualquier pantalla.
const marqueeGroup: Tech[] = [...marquee, ...marquee].map((id) => tech[id]);

const skillIcons = ['server', 'layout', 'smartphone', 'cloud', 'code'] as const;

const medalStyles = {
  gold: { label: 'Ganador', class: 'bg-[#f5c542]/15 text-[#f5c542] ring-[#f5c542]/30' },
  finalist: { label: 'Finalista', class: 'bg-accent/15 text-accent ring-accent/30' },
  participant: { label: 'Participante', class: 'bg-white/5 text-soft ring-white/15' },
} as const;

const lookingFor = [
  'Empresa con producto propio y equipo técnico con el que aprender',
  'Stack .NET, Vue o React Native, y también PHP con Symfony o Java',
  'Zaragoza presencial o híbrido, o remoto desde España',
  'Incorporación inmediata',
];

const pill = 'rounded-full border border-line bg-white/[0.03] px-3 py-1 text-xs text-soft';
---

<BaseLayout
  title="Gabriel Saiz — Desarrollador Full-Stack .NET, Vue y React Native"
  description="Desarrollador Full-Stack en Zaragoza: apps en App Store y Google Play, backend .NET + PostgreSQL y frontend Vue 3. Disponible para incorporación inmediata."
  schema={[profilePageSchema(), projectsSchema()]}
>
  <!-- ============================== HERO ============================== -->
  <section id="inicio" class="relative overflow-hidden">
    <div class="hero-aurora pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>

    <div class="container-page relative grid items-center gap-16 pt-12 pb-20 sm:pt-20 lg:grid-cols-12 lg:gap-10 lg:pt-24 lg:pb-28">
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2.5 rounded-full border border-accent/30 bg-accent/[0.07] py-1.5 pr-4 pl-3 text-sm font-medium text-accent">
          <span class="status-dot" aria-hidden="true"></span>
          Disponible · {site.availability.toLowerCase()}
        </p>

        <h1 class="mt-7">
          <span class="block text-lg font-medium tracking-normal text-soft sm:text-xl">Hola, soy {site.name} 👋</span>
          <span class="mt-3 block text-[2.7rem] leading-[1.02] font-semibold sm:text-7xl lg:text-[5.2rem]">
            Desarrollador <span class="text-gradient">Full-Stack</span>
          </span>
        </h1>

        <p class="lead mt-7 max-w-xl">
          Llevo apps y webs a producción: <strong class="font-medium text-fg">apps publicadas en App Store y Google Play</strong>,
          backends en .NET y paneles en Vue. Busco un equipo con producto propio donde aportar desde el primer día.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={site.documents.cv}
            download
            class="group inline-flex h-13 items-center justify-center gap-2 rounded-full bg-accent px-7 text-base font-semibold text-accent-ink shadow-[0_0_0_1px_rgb(0_230_118/0.4),0_10px_36px_-8px_rgb(0_230_118/0.6)] transition hover:bg-white"
            data-cta="hero-cv"
          >
            <Icon name="download" class="size-5 transition-transform group-hover:translate-y-0.5" />
            Descargar CV
          </a>
          <a
            href="#contacto"
            class="group inline-flex h-13 items-center justify-center gap-2 rounded-full border border-line-strong bg-white/[0.03] px-7 text-base font-semibold text-fg transition hover:bg-white/[0.08]"
            data-cta="hero-contact"
          >
            Hablemos
            <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
          </a>
          <div class="flex gap-2 sm:ml-2">
            <a
              href={site.social.linkedin}
              target="_blank"
              rel="noopener me"
              class="inline-flex size-13 items-center justify-center rounded-full border border-line text-soft transition hover:border-[#0A66C2] hover:text-[#0A66C2]"
              data-cta="hero-linkedin"
            >
              <Icon name="linkedin" class="size-5" label="LinkedIn" />
            </a>
            <a
              href={site.social.github}
              target="_blank"
              rel="noopener me"
              class="inline-flex size-13 items-center justify-center rounded-full border border-line text-soft transition hover:border-line-strong hover:text-fg"
              data-cta="hero-github"
            >
              <Icon name="github" class="size-5" label="GitHub" />
            </a>
          </div>
        </div>

        <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
          <li class="inline-flex items-center gap-2"><Icon name="mapPin" class="size-4 text-accent" />Zaragoza · remoto</li>
          <li class="inline-flex items-center gap-2"><Icon name="smartphone" class="size-4 text-accent" />Apps en App Store y Google Play</li>
          <li class="inline-flex items-center gap-2"><Icon name="graduationCap" class="size-4 text-accent" />DAW · TFG 10 MH</li>
        </ul>
      </div>

      <!-- Foto + tarjeta de código -->
      <div class="relative mx-auto w-full max-w-[22rem] lg:col-span-5 lg:max-w-[24rem]">
        <div class="photo-frame rounded-[2rem] p-px shadow-2xl shadow-black/60">
          <div class="relative overflow-hidden rounded-[calc(2rem-1px)] bg-surface">
            <Picture
              src={photo}
              alt={`Retrato de ${site.name}, desarrollador full-stack`}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[360, 540, 720]}
              sizes="(min-width: 1024px) 384px, 352px"
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/5] w-full object-cover object-[50%_20%] grayscale"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent" aria-hidden="true">
            </div>
          </div>
        </div>

        <p
          class="absolute top-5 -left-3 flex items-center gap-2 rounded-2xl border border-line-strong bg-ink-2/90 px-3 py-2 text-xs font-medium text-fg shadow-xl shadow-black/50 backdrop-blur sm:-left-9"
        >
          <span aria-hidden="true">🏆</span> Ganador NASA Space Apps
        </p>
      </div>
    </div>

    <!-- Carrusel infinito de tecnologías: solo logos -->
    <div class="marquee relative border-y border-line bg-ink-2/60 py-8">
      <p class="sr-only">Tecnologías: {marquee.map((id) => tech[id].name).join(', ')}.</p>
      {
        [0, 1].map((copy) => (
          <ul class="marquee-group !gap-14 !pr-14" aria-hidden="true" data-copy={copy}>
            {marqueeGroup.map((t) => (
              <li class="flex shrink-0 items-center" title={t.name}>
                {t.path ? (
                  <TechIcon tech={t} class="size-10 opacity-85 transition hover:scale-110 hover:opacity-100" branded />
                ) : (
                  <span class="text-2xl font-bold tracking-tight whitespace-nowrap opacity-85" style={`color:${t.color}`}>
                    {t.name}
                  </span>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>

    <!-- Cifras -->
    <div class="container-page">
      <dl class="my-16 grid grid-cols-2 gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line lg:grid-cols-4">
        {
          stats.map((s) => (
            <div class="spotlight flex flex-col bg-ink p-6 sm:p-8">
              <dt class="order-2 mt-2 text-sm leading-snug text-muted">{s.label}</dt>
              <dd class="text-4xl font-semibold tracking-tight text-fg sm:text-5xl">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============================== PROYECTOS ============================== -->
  <section id="proyectos" class="section border-t border-line" aria-labelledby="proyectos-title">
    <div class="container-page">
      <p class="eyebrow"><span class="text-muted">01 —</span> Proyectos</p>
      <h2 id="proyectos-title" class="heading-lg mt-4 max-w-3xl">Producto real, en producción</h2>
      <p class="lead mt-5 max-w-2xl">De la base de datos a la app en la store. Esto es lo que he construido.</p>

      <!-- Proyecto destacado -->
      <article class="reveal spotlight mt-14 overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-accent/50 via-line-strong to-transparent p-px">
        <div class="grid overflow-hidden rounded-[calc(1.75rem-1px)] bg-surface lg:grid-cols-12">
          <div class="relative flex items-center justify-center overflow-hidden p-10 lg:col-span-5">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_55%,rgb(0_230_118/0.22),transparent_60%)]" aria-hidden="true"></div>
            <div class="grid-bg absolute inset-0 opacity-60" aria-hidden="true"></div>
            <div class="relative mx-auto w-[62%] max-w-[16rem]">
              <Picture
                src={featured.image}
                alt={featured.imageAlt}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[240, 440]}
                sizes="260px"
                loading="lazy"
                pictureAttributes={{ class: 'block' }}
                class="mx-auto block h-auto w-full -rotate-3 drop-shadow-[0_40px_50px_rgb(0_0_0/0.7)] transition-transform duration-700 ease-(--ease-out-expo) hover:rotate-0"
              />
            </div>
          </div>
          <div class="flex flex-col p-7 sm:p-10 lg:col-span-7">
            <p class="inline-flex items-center gap-2 self-start rounded-full bg-accent/15 px-3 py-1 text-xs font-semibold text-accent">
              <span class="status-dot scale-75" aria-hidden="true"></span>
              {featured.label}
            </p>
            <h3 class="mt-5 text-3xl font-semibold text-fg sm:text-4xl">{featured.name}</h3>
            <p class="mt-2 text-lg text-soft">{featured.tagline}</p>
            <p class="mt-4 leading-relaxed text-muted">{featured.description}</p>
            <ul class="mt-6 grid gap-3 text-sm text-soft">
              {
                featured.highlights.map((h) => (
                  <li class="flex gap-3">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
                    {h}
                  </li>
                ))
              }
            </ul>
            <ul class="mt-7 flex flex-wrap gap-2" aria-label="Tecnologías">
              {featured.stack.map((t) => <li class={pill}>{t}</li>)}
            </ul>
            <div class="mt-8 flex flex-wrap gap-3">
              {
                featured.links.map((l) => (
                  <a
                    href={l.url}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex h-11 items-center gap-2 rounded-full bg-white px-5 text-sm font-semibold text-ink transition hover:bg-accent"
                  >
                    <TechIcon tech={tech.appStore} class="size-4" />
                    {l.label}
                    <Icon name="arrowUpRight" class="size-4" />
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </article>

      <!-- Resto de proyectos -->
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {
          others.map((p) => (
            <article class="reveal spotlight group card card-hover flex flex-col overflow-hidden">
              <div class="border-b border-line bg-ink-2 p-3 pb-0">
                <div class="overflow-hidden rounded-t-xl border border-b-0 border-line-strong">
                  <div class="flex items-center gap-1.5 bg-surface-2 px-3 py-2" aria-hidden="true">
                    <span class="size-2 rounded-full bg-white/15" />
                    <span class="size-2 rounded-full bg-white/15" />
                    <span class="size-2 rounded-full bg-white/15" />
                  </div>
                  <Picture
                    src={p.image}
                    alt={p.imageAlt}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[400, 640, 900]}
                    sizes="(min-width: 768px) 360px, 100vw"
                    loading="lazy"
                    class="aspect-[16/10] w-full object-cover object-top transition-transform duration-700 ease-(--ease-out-expo) group-hover:scale-[1.04]"
                  />
                </div>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <p class="text-xs font-semibold tracking-wide text-accent uppercase">{p.label}</p>
                <h3 class="mt-3 text-xl font-semibold text-fg">{p.name}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{p.description}</p>
                <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías">
                  {p.stack.map((t) => <li class={pill}>{t}</li>)}
                </ul>
                <div class="mt-auto pt-6">
                  {p.links.map((l) => (
                    <a
                      href={l.url}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline hover:underline-offset-4"
                    >
                      {l.label}
                      <span class="sr-only"> de {p.name}</span>
                      <Icon name="arrowUpRight" class="size-4" />
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================== EXPERIENCIA ============================== -->
  <section id="experiencia" class="section border-t border-line bg-ink-2" aria-labelledby="experiencia-title">
    <div class="container-page grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow"><span class="text-muted">02 —</span> Experiencia</p>
          <h2 id="experiencia-title" class="heading-lg mt-4">Dónde he trabajado</h2>
          <p class="mt-5 text-muted">Apps publicadas, clientes reales y pipelines que despliegan solos.</p>
          <a
            href={site.documents.recommendation}
            target="_blank"
            rel="noopener"
            class="spotlight card card-hover mt-8 flex items-center gap-4 p-4"
            data-cta="recommendation-letter"
          >
            <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <Icon name="fileText" class="size-5" />
            </span>
            <span>
              <span class="block text-sm font-medium text-fg">Carta de recomendación</span>
              <span class="block text-xs text-muted">GOLIVE Services · PDF</span>
            </span>
            <Icon name="arrowUpRight" class="ml-auto size-4 text-muted" />
          </a>
        </div>
      </div>

      <ol class="relative lg:col-span-8">
        <span class="absolute top-2 bottom-2 left-[7px] w-px bg-gradient-to-b from-accent via-line-strong to-transparent" aria-hidden="true"></span>
        {
          experience.map((e) => (
            <li class="reveal relative pb-12 pl-10 last:pb-0">
              <span class="absolute top-1.5 left-0 size-[15px] rounded-full border-2 border-accent bg-ink" aria-hidden="true" />
              <div class="spotlight card p-6 sm:p-7">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="text-xl font-semibold text-fg">{e.role}</h3>
                  <p class="text-sm font-medium text-accent">{e.period}</p>
                </div>
                <p class="mt-1 text-soft">
                  {e.url ? (
                    <a href={e.url} target="_blank" rel="noopener" class="underline decoration-white/20 underline-offset-4 hover:decoration-accent">
                      {e.company}
                    </a>
                  ) : (
                    e.company
                  )}
                  <span class="text-muted"> · {e.location}</span>
                </p>
                <p class="mt-4 leading-relaxed text-muted">{e.summary}</p>
                <ul class="mt-4 grid gap-2.5 text-sm leading-relaxed text-soft">
                  {e.bullets.map((b) => (
                    <li class="flex gap-3">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      {b}
                    </li>
                  ))}
                </ul>
                <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías">
                  {e.stack.map((t) => <li class={pill}>{t}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================== STACK ============================== -->
  <section id="stack" class="section border-t border-line" aria-labelledby="stack-title">
    <div class="container-page">
      <p class="eyebrow"><span class="text-muted">03 —</span> Stack</p>
      <h2 id="stack-title" class="heading-lg mt-4">Con qué trabajo</h2>
      <p class="lead mt-5 max-w-2xl">
        Mi día a día es .NET, Vue 3 y React Native. También tengo experiencia real con PHP y Symfony, y base en Java.
      </p>
      <div class="mt-14 grid gap-5 md:grid-cols-6">
        {
          skills.map((g, i) => (
            <div
              class:list={[
                'reveal spotlight card p-7',
                i < 2 ? 'md:col-span-3' : 'md:col-span-2',
                i === 0 && 'border-accent/35',
              ]}
            >
              <div class="flex items-center gap-3">
                <span class="inline-flex size-10 items-center justify-center rounded-xl bg-accent/10 text-accent">
                  <Icon name={skillIcons[i]} class="size-5" />
                </span>
                <h3 class="text-lg font-semibold text-fg">{g.group}</h3>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted">{g.description}</p>
              <ul class="mt-6 grid grid-cols-3 gap-2.5">
                {g.items.map((id) => (
                  <li class="group/tile flex flex-col items-center gap-2 rounded-xl border border-line bg-white/[0.02] px-2 py-3.5 text-center transition hover:-translate-y-0.5 hover:border-line-strong hover:bg-white/[0.05]">
                    <TechIcon tech={tech[id]} class="size-7 transition-transform duration-300 group-hover/tile:scale-110" branded />
                    <span class="text-xs leading-tight text-soft">{tech[id].name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================== LOGROS Y FORMACIÓN ============================== -->
  <section id="logros" class="section border-t border-line bg-ink-2" aria-labelledby="logros-title">
    <div class="container-page">
      <p class="eyebrow"><span class="text-muted">04 —</span> Logros</p>
      <h2 id="logros-title" class="heading-lg mt-4">Premios y competiciones</h2>

      <div class="mt-14 grid gap-5 lg:grid-cols-2">
        <article class="reveal spotlight card relative overflow-hidden lg:row-span-3">
          <div class="relative">
            <Picture
              src={nasaImage}
              alt="Equipo ganador de la edición de Zaragoza del NASA Space Apps Challenge 2023"
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[600, 900, 1200]}
              sizes="(min-width: 1024px) 560px, 100vw"
              loading="lazy"
              class="aspect-[16/9] w-full object-cover lg:aspect-auto lg:h-72"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent" aria-hidden="true"></div>
          </div>
          <div class="relative -mt-6 p-7">
            <p class={`inline-flex rounded-full px-3 py-1 text-xs font-semibold ring-1 ${medalStyles[achievements[0].medal].class}`}>
              🏆 {medalStyles[achievements[0].medal].label} · {achievements[0].year}
            </p>
            <h3 class="mt-4 text-2xl font-semibold text-fg">{achievements[0].title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{achievements[0].detail}</p>
          </div>
        </article>
        {
          achievements.slice(1).map((a) => (
            <article class="reveal spotlight card flex gap-5 p-6">
              <span class={`inline-flex size-12 shrink-0 items-center justify-center rounded-2xl ring-1 ${medalStyles[a.medal].class}`}>
                <Icon name="award" class="size-6" />
              </span>
              <div>
                <p class="text-xs font-semibold tracking-wide text-muted uppercase">
                  {medalStyles[a.medal].label} · {a.year}
                </p>
                <h3 class="mt-1.5 text-lg font-semibold text-fg">{a.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{a.detail}</p>
              </div>
            </article>
          ))
        }
      </div>

      <h2 id="formacion-title" class="heading-md mt-24 flex items-center gap-3">
        <Icon name="graduationCap" class="size-7 text-accent" /> Formación
      </h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          education.map((e) => (
            <article class="reveal spotlight card p-7">
              <p class="text-sm font-medium text-accent">{e.period}</p>
              <h3 class="mt-2 text-lg font-semibold text-fg">{e.title}</h3>
              <p class="mt-1 text-sm text-soft">{e.center}</p>
              <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-muted">
                {e.bullets.map((b) => (
                  <li class="flex gap-3">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    {b}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================== SOBRE MÍ ============================== -->
  <section id="sobre-mi" class="section border-t border-line" aria-labelledby="sobre-title">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="eyebrow"><span class="text-muted">05 —</span> Sobre mí</p>
        <h2 id="sobre-title" class="heading-lg mt-4">Me gusta llevar las cosas a producción</h2>
        <div class="mt-6 grid gap-4 text-lg leading-relaxed text-muted">
          <p>
            Empecé en sistemas y redes y di el salto al desarrollo. Hoy trabajo de punta a punta: modelo la base de datos,
            escribo la API en .NET, monto el panel en Vue y publico la app en las stores.
          </p>
          <p>
            He peleado con las revisiones de Apple, con pagos in-app y con despliegues en AWS, y he aprendido que lo
            importante es que el producto funcione para quien lo usa, con código que otro pueda mantener.
          </p>
        </div>
      </div>
      <div class="spotlight card p-7 sm:p-9">
        <h3 class="flex items-center gap-3 text-xl font-semibold text-fg">
          <Icon name="target" class="size-6 text-accent" /> Qué busco
        </h3>
        <ul class="mt-6 grid gap-4">
          {
            lookingFor.map((l) => (
              <li class="flex gap-3 text-soft">
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
                  <Icon name="check" class="size-3.5" />
                </span>
                {l}
              </li>
            ))
          }
        </ul>
      </div>
