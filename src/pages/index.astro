---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import HeroMockup from '@/components/HeroMockup.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PricingCards from '@/components/sections/PricingCards.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import FaqSection from '@/components/sections/FaqSection.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import { services, formatPrice } from '@/data/services';
import { projects } from '@/data/projects';
import { generalFaqs } from '@/data/faqs';
import { site } from '@/config/site';
import { faqSchema, serviceSchema } from '@/lib/schema';

const serviceIcons = {
  'landing-pages': 'target',
  'diseno-web': 'layout',
  'web-con-reservas': 'calendar',
  'mantenimiento-web': 'wrench',
} as const;

const pillars = [
  {
    icon: 'zap',
    title: 'Carga en menos de 2 segundos',
    text: 'Si tu web tarda, el cliente se va a la competencia. Optimizamos cada imagen y cada línea de código para que abra al instante en el móvil.',
  },
  {
    icon: 'search',
    title: 'Aparece en Google',
    text: 'SEO técnico y local desde el primer día: que te encuentren quienes buscan tu servicio en Zaragoza, no solo quienes ya te conocen.',
  },
  {
    icon: 'messageCircle',
    title: 'Convierte visitas en contactos',
    text: 'Botones de llamada, WhatsApp y formularios donde el cliente los necesita. Cada página tiene un objetivo claro.',
  },
] as const;

const reasons = [
  {
    icon: 'handshake',
    title: 'Hablas con quien hace tu web',
    text: 'Sin comerciales ni intermediarios. Una sola persona de contacto que conoce tu proyecto de principio a fin.',
  },
  {
    icon: 'euro',
    title: 'Precio cerrado por escrito',
    text: 'Sabes lo que vas a pagar antes de empezar. Sin horas extra sorpresa ni cuotas obligatorias.',
  },
  {
    icon: 'gauge',
    title: 'Rendimiento medible',
    text: 'Entregamos cada web con una puntuación de 90+ en Google PageSpeed. Si no llega, seguimos trabajando.',
  },
  {
    icon: 'shield',
    title: 'La web es 100 % tuya',
    text: 'Dominio a tu nombre, todos los accesos y sin permanencia. Si un día quieres cambiar de proveedor, te lo llevas todo.',
  },
  {
    icon: 'smartphone',
    title: 'Pensada primero para el móvil',
    text: 'Diseñamos para el teléfono, que es desde donde te buscan tus clientes, y después adaptamos a ordenador.',
  },
  {
    icon: 'mapPin',
    title: 'Estudio local en Zaragoza',
    text: 'Podemos vernos en persona. Conocemos el mercado local y cómo buscan los clientes de la zona.',
  },
] as const;

const featuredProjects = projects.slice(0, 3);
---

<BaseLayout
  title="Diseño Web en Zaragoza para Negocios | GabrielCodes"
  description="Diseño de páginas web profesionales en Zaragoza para negocios que quieren más clientes. Webs rápidas y optimizadas para Google desde 300 €. Pide presupuesto."
  schema={[...services.map(serviceSchema), faqSchema(generalFaqs)]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -top-48 left-1/2 h-[34rem] w-[60rem] -translate-x-1/2 rounded-full bg-accent/[0.09] blur-[130px]"
      aria-hidden="true"
    >
    </div>
    <div class="container-page relative grid items-center gap-16 pt-14 pb-24 sm:pt-20 lg:grid-cols-12 lg:gap-10 lg:pt-24 lg:pb-32">
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2 rounded-full border border-line-strong bg-white/[0.03] py-1.5 pr-4 pl-2 text-xs text-soft">
          <span class="rounded-full bg-accent/15 px-2 py-0.5 font-semibold text-accent">Zaragoza</span>
          Diseño y desarrollo web para negocios
        </p>
        <h1 class="mt-7 text-[2.35rem] leading-[1.05] font-semibold sm:text-6xl lg:text-[3.5rem] xl:text-[3.9rem]">
          Diseño páginas web profesionales para negocios que quieren <span class="text-gradient">conseguir más clientes</span>
        </h1>
        <p class="lead mt-7 max-w-xl">
          Webs rápidas, modernas y optimizadas para Google. Desde landing pages hasta sistemas de reservas online.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button href="/contacto#presupuesto" size="lg" data-cta="home-hero">
            Solicitar presupuesto
            <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
          </Button>
          <Button href="#precios" variant="secondary" size="lg" data-cta="home-hero-precios">Ver precios</Button>
        </div>
        <ul class="mt-10 flex flex-col gap-3 text-sm text-soft sm:flex-row sm:flex-wrap sm:gap-x-7">
          <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-accent" />Presupuesto en 24 h</li>
          <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-accent" />Desde 300 €</li>
          <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-accent" />Sin permanencia</li>
        </ul>
      </div>
      <div class="lg:col-span-5">
        <HeroMockup />
      </div>
    </div>
  </section>

  <!-- PROPUESTA DE VALOR -->
  <section class="section border-t border-line" aria-labelledby="valor-title">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow">Por qué importa</p>
          <h2 id="valor-title" class="heading-lg mt-4">Una web que trabaja para tu negocio, no solo que “está”</h2>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="lead">
            Una página web profesional no es solo una tarjeta de visita. Debe cargar rápido, aparecer en Google y facilitar que
            tus clientes contacten contigo.
          </p>
          <p class="mt-5 text-muted">
            La mayoría de tus clientes te buscan desde el móvil, comparan dos o tres opciones y deciden en segundos. Si tu web
            es lenta, no sale en Google o no deja claro cómo contactarte, ese cliente acaba en la competencia aunque tu servicio
            sea mejor.
          </p>
        </div>
      </div>
      <div class="mt-16 grid gap-5 md:grid-cols-3">
        {
          pillars.map((p) => (
            <div class="reveal card p-7">
              <span class="inline-flex size-11 items-center justify-center rounded-xl border border-accent/25 bg-accent/10 text-accent">
                <Icon name={p.icon} class="size-5" />
              </span>
              <h3 class="mt-6 text-lg font-semibold text-fg">{p.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section border-t border-line bg-ink-2" aria-labelledby="servicios-title">
    <div class="container-page">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">Servicios</p>
          <h2 id="servicios-title" class="heading-lg mt-4">Páginas web para empresas y negocios locales</h2>
          <p class="lead mt-5">Elige el tipo de web según lo que necesitas conseguir. Todas incluyen diseño a medida, SEO y adaptación a móvil.</p>
        </div>
        <Button href="/servicios" variant="ghost" class="self-start px-0 sm:self-auto">
          Ver todos los servicios <Icon name="arrowRight" class="size-4" />
        </Button>
      </div>

      <div class="mt-14 grid gap-5 md:grid-cols-2">
        {
          services.map((s) => (
            <article class="reveal group card card-hover relative flex flex-col p-7 sm:p-8">
              <div class="flex items-start justify-between gap-4">
                <span class="inline-flex size-12 items-center justify-center rounded-xl bg-white/[0.04] text-accent ring-1 ring-line">
                  <Icon name={serviceIcons[s.id]} class="size-6" />
                </span>
                <span class="rounded-full border border-line px-3 py-1 text-sm font-medium text-fg">{formatPrice(s.price)}</span>
              </div>
              <h3 class="mt-7 text-xl font-semibold text-fg">
                <a href={s.path} class="after:absolute after:inset-0 after:content-['']">
                  {s.name}
                </a>
              </h3>
              <p class="mt-3 leading-relaxed text-muted">{s.summary}</p>
              <p class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                Ver detalles
                <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-1" />
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROYECTOS -->
  <section class="section border-t border-line" aria-labelledby="proyectos-title">
    <div class="container-page">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">Proyectos</p>
          <h2 id="proyectos-title" class="heading-lg mt-4">Webs que ya están funcionando</h2>
        </div>
        <Button href="/proyectos" variant="ghost" class="self-start px-0 sm:self-auto">
          Ver todos los proyectos <Icon name="arrowRight" class="size-4" />
        </Button>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- PRECIOS -->
  <section id="precios" class="section border-t border-line bg-ink-2" aria-labelledby="precios-title">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Precios</p>
        <h2 id="precios-title" class="heading-lg mt-4">¿Cuánto cuesta una página web?</h2>
        <p class="lead mt-5">Precios claros desde el principio. Elige el punto de partida y te enviamos un presupuesto cerrado para tu caso.</p>
      </div>
      <div class="mt-16">
        <PricingCards />
      </div>
      <p class="mt-4 text-center text-sm text-muted">
        ¿Ya tienes web? El <a href="/mantenimiento-web" class="text-accent underline underline-offset-4">mantenimiento web</a> empieza en
        25 €/mes.
      </p>
    </div>
  </section>

  <!-- POR QUÉ NOSOTROS -->
  <section class="section border-t border-line" aria-labelledby="porque-title">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Por qué {site.name}</p>
        <h2 id="porque-title" class="heading-lg mt-4">La tranquilidad de trabajar con un estudio de confianza</h2>
      </div>
      <div class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          reasons.map((r) => (
            <div class="reveal">
              <Icon name={r.icon} class="size-6 text-accent" />
              <h3 class="mt-5 text-lg font-semibold text-fg">{r.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{r.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="border-t border-line bg-ink-2">
    <ProcessSteps />
  </div>

  <!-- SEO LOCAL -->
  <section class="section border-t border-line" aria-labelledby="zaragoza-title">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">Diseño web en Zaragoza</p>
        <h2 id="zaragoza-title" class="heading-lg mt-4">Tu estudio de diseño web en Zaragoza y alrededores</h2>
        <p class="lead mt-5">
          Trabajamos con negocios de toda el área metropolitana. Nos reunimos contigo en persona, entendemos cómo te buscan tus
          clientes y optimizamos tu web para que te encuentren en Google y en Google Maps.
        </p>
        <Button href="/diseno-web-zaragoza" variant="secondary" class="mt-8">
          Diseño web en Zaragoza <Icon name="arrowRight" class="size-4" />
        </Button>
      </div>
      <ul class="flex flex-wrap gap-2" aria-label="Zonas en las que trabajamos">
        {
          site.areaServed.map((a) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-line bg-white/[0.02] px-4 py-2 text-sm text-soft">
              <Icon name="mapPin" class="size-3.5 text-accent" />
              {a}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="border-t border-line">
    <FaqSection
      faqs={generalFaqs}
      title="Lo que nos preguntan antes de empezar"
      intro="Respuestas directas sobre precios, plazos y cómo trabajamos."
    />
  </div>

  <CtaSection />
</BaseLayout>
