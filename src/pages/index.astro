              <span class="inline-flex size-10 items-center justify-center rounded-full bg-[#0A66C2]/15 text-[#4d9be6]"><Icon name="linkedin" class="size-5" /></span>
              <span>
                <span class="block text-sm font-medium text-fg">LinkedIn</span>
                <span class="block text-sm text-muted">Gabriel Saiz de la Maza Bajo</span>
