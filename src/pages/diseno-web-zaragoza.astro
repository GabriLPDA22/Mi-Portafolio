---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import PricingCards from '@/components/sections/PricingCards.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import FaqSection from '@/components/sections/FaqSection.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Icon from '@/components/ui/Icon.astro';
import { zaragozaFaqs } from '@/data/faqs';
import { projects } from '@/data/projects';
import { getService } from '@/data/services';
import { site } from '@/config/site';
import { faqSchema, serviceSchema } from '@/lib/schema';

const breadcrumbs = [{ name: 'Diseño web Zaragoza', path: '/diseno-web-zaragoza' }];

const localReasons = [
  {
    icon: 'mapPin',
    title: 'Reuniones en persona',
    text: 'Nos vemos en tu negocio o donde te venga bien. Entender tu local, tu equipo y a tus clientes se nota en el resultado.',
  },
  {
    icon: 'search',
    title: 'SEO local para Zaragoza',
    text: 'Optimizamos la web para búsquedas como “fisioterapeuta en Delicias” o “reformas en Zaragoza”, y la conectamos con tu ficha de Google.',
  },
  {
    icon: 'clock',
    title: 'Respuesta rápida',
    text: 'Mismo huso horario, mismo calendario de festivos y soporte directo por WhatsApp. Sin tickets ni esperas.',
  },
] as const;

const sectors = [
  'Restaurantes y bares',
  'Clínicas y fisioterapia',
  'Centros de estética',
  'Peluquerías y barberías',
  'Gimnasios y entrenadores',
  'Academias',
  'Asesorías y abogados',
  'Reformas e instaladores',
  'Comercio local',
  'Talleres',
];
---

<BaseLayout
  title="Diseño Web en Zaragoza | Páginas Web Profesionales"
  description="Estudio de diseño web en Zaragoza. Creamos páginas web profesionales para empresas y negocios locales, optimizadas para Google y Google Maps. Desde 300 €."
  image="/og/og-diseno-web-zaragoza.png"
  breadcrumbs={breadcrumbs}
  schema={[serviceSchema(getService('diseno-web')), faqSchema(zaragozaFaqs)]}
>
  <PageHero
    eyebrow="Zaragoza y área metropolitana"
    breadcrumbs={breadcrumbs}
    lead="Creamos páginas web profesionales para negocios de Zaragoza que quieren aparecer en Google y convertir esas visitas en llamadas, reservas y presupuestos. Trato directo, precio cerrado y reuniones en persona."
    price="Desde 300 €"
    delivery="1–5 semanas"
    whatsappMessage="Hola, tengo un negocio en Zaragoza y me gustaría pedir presupuesto para una web."
  >
    Diseño web en Zaragoza para negocios que quieren más clientes
  </PageHero>

  <!-- Por qué local -->
  <section class="section" aria-labelledby="local-title">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="eyebrow">Estudio local</p>
        <h2 id="local-title" class="heading-lg mt-4">Desarrollo web para empresas de Zaragoza, con alguien que conoce la zona</h2>
        <p class="lead mt-5">
          Una web para un negocio local no compite con todo internet: compite con los negocios de tu barrio y de tu ciudad. Por
          eso la diseñamos pensando en cómo buscan tus clientes aquí.
        </p>
      </div>
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {
          localReasons.map((r) => (
            <div class="reveal card p-7">
              <span class="inline-flex size-11 items-center justify-center rounded-xl border border-accent/25 bg-accent/10 text-accent">
                <Icon name={r.icon} class="size-5" />
              </span>
              <h3 class="mt-6 text-lg font-semibold text-fg">{r.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{r.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contenido SEO local -->
  <section class="border-t border-line py-20 sm:py-24">
    <div class="container-page grid gap-14 lg:grid-cols-12">
      <div class="prose-page lg:col-span-7">
        <h2>Crear una página web profesional en Zaragoza: qué debe tener</h2>
        <p>
          Una página web profesional no es solo una tarjeta de visita. Debe cargar rápido, aparecer en Google y facilitar que
          tus clientes contacten contigo. Para un negocio de Zaragoza eso se traduce en cuatro cosas concretas:
        </p>
        <ul>
          <li><strong>Que salga cuando buscan tu servicio + “Zaragoza”</strong> o el nombre de tu barrio, y en Google Maps.</li>
          <li><strong>Que se vea perfecta en el móvil</strong>, porque es desde donde te busca quien está cerca.</li>
          <li><strong>Que muestre dónde estás y cuándo abres</strong>, con mapa, horario y cómo llegar.</li>
          <li><strong>Que permita contactar en un toque:</strong> llamada, WhatsApp, formulario o reserva online.</li>
        </ul>

        <h2>SEO local: cómo conseguimos que te encuentren en Zaragoza</h2>
        <p>
          Trabajamos el posicionamiento local en tres capas. En la web: títulos, textos y datos estructurados que indican a
          Google qué haces y en qué zona. En tu <strong>ficha de Google Business Profile</strong>: categorías, servicios, fotos
          y los mismos datos de contacto que en la web. Y en la reputación: te ayudamos a pedir reseñas a tus clientes de forma
          sencilla.
        </p>

        <h2>¿Cuánto cuesta una página web en Zaragoza?</h2>
        <p>
          Una <a href="/servicios/landing-pages">landing page</a> cuesta entre 300 y 600 €, una
          <a href="/servicios/diseno-web">web profesional para empresa</a> entre 700 y 1.200 € y una
          <a href="/servicios/web-con-reservas">web con reservas online</a> entre 900 y 1.500 € (sin IVA). Son precios
          cerrados: sabrás lo que pagas antes de empezar, sin cuotas obligatorias. Después, si quieres despreocuparte, el
          <a href="/mantenimiento-web">mantenimiento web</a> empieza en 25 € al mes.
        </p>

        <h2>Barrios y municipios en los que trabajamos</h2>
        <p>
          Trabajamos con negocios de todos los barrios de Zaragoza —Centro, Delicias, Actur, Universidad, San José, Las Fuentes,
          Torrero, Casablanca, Valdespartera, Arcosur, Parque Goya— y de los municipios del área metropolitana:
          {site.areaServed.filter((a) => a !== 'Zaragoza').join(', ')}.
        </p>
      </div>

      <aside class="lg:col-span-4 lg:col-start-9" aria-labelledby="sectores-title">
        <div class="card sticky top-24 p-7">
          <h2 id="sectores-title" class="text-lg font-semibold text-fg">Sectores con los que trabajamos</h2>
          <ul class="mt-5 grid gap-3 text-sm text-soft">
            {
              sectors.map((s) => (
                <li class="flex items-center gap-3">
                  <Icon name="check" class="size-4 text-accent" />
                  {s}
                </li>
              ))
            }
          </ul>
          <div class="mt-7 border-t border-line pt-6 text-sm text-muted">
            <p class="font-medium text-fg">{site.name}</p>
            <p class="mt-1">Diseño web en {site.address.locality}, {site.address.region}</p>
            <p class="mt-1">{site.openingHours.display}</p>
            <a href={`mailto:${site.contact.email}`} class="mt-1 block text-accent hover:underline">{site.contact.email}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section id="precios" class="section border-t border-line bg-ink-2" aria-labelledby="precios-title">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Precios</p>
        <h2 id="precios-title" class="heading-lg mt-4">Precios de diseño web en Zaragoza</h2>
      </div>
      <div class="mt-16">
        <PricingCards showMaintenance />
      </div>
    </div>
  </section>

  <section class="section border-t border-line" aria-labelledby="proyectos-title">
    <div class="container-page">
      <p class="eyebrow">Proyectos</p>
      <h2 id="proyectos-title" class="heading-lg mt-4">Algunos de nuestros trabajos</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {projects.slice(0, 2).map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <div class="border-t border-line bg-ink-2">
    <ProcessSteps />
  </div>

  <div class="border-t border-line">
    <FaqSection faqs={zaragozaFaqs} title="Preguntas sobre diseño web en Zaragoza" />
  </div>

  <CtaSection title="¿Tienes un negocio en Zaragoza?" text="Te visitamos, entendemos tu negocio y en 24 h tienes un presupuesto cerrado para tu nueva web." />
</BaseLayout>
