Options -Indexes
RewriteEngine On

# /en es a la vez en.html y la carpeta en/: sin esto Apache redirige a /en/ (403).
DirectorySlash Off

# Barra final → URL limpia (/en/ → /en, /privacidad/ → /privacidad)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Markdown para agentes: con "Accept: text/markdown" la portada se sirve en markdown
# (/index.md, /en.md). Los navegadores no lo piden, así que siguen recibiendo HTML.
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^(index\.html)?$ /index.md [L]
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^en(\.html)?$ /en.md [L]

# URLs sin extensión → fichero .html (también si existe una carpeta con el mismo nombre)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)$ $1.html [L]

# 404 fallback
ErrorDocument 404 /404.html

AddType text/markdown .md
AddCharset utf-8 .md .txt

# ----------------------------------------------------------------------
# Compresión (gzip / brotli si está disponible)
# ----------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/markdown text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml application/manifest+json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/markdown text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml application/manifest+json
</IfModule>

# ----------------------------------------------------------------------
# Cache-Control
# Astro hashea /_astro/* → 1 año inmutable (refuerzo en public/_astro/.htaccess)
# HTML → sin cache agresiva
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Primero: CSS/JS con fingerprint (todo el JS de Astro)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fuentes
  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes e iconos
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # PDF (CV)
  <FilesMatch "\.(pdf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # HTML y markdown siempre frescos; varían según Accept (HTML vs markdown para agentes)
  <FilesMatch "\.(html|md)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header merge Vary Accept
  </FilesMatch>

  # Cabeceras Link (RFC 8288) en la portada: versión markdown y llms.txt para agentes
  <FilesMatch "^index\.html$">
    Header set Link "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </sitemap.xml>; rel=\"sitemap\""
  </FilesMatch>
  <FilesMatch "^en\.html$">
    Header set Link "</en.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </sitemap.xml>; rel=\"sitemap\""
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>
