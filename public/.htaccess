# =====================================================================
# gabrielcodes.dev — configuración para Hostinger (LiteSpeed / Apache)
# Se copia a la raíz del build (dist/) desde public/.
# =====================================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Evita que /servicios redirija a /servicios/ (existe la carpeta servicios/ y servicios.html).
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- HTTPS -----------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- www → sin www (URL canónica: https://gabrielcodes.dev) -----------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- Redirecciones 301 (variantes y URLs del portfolio anterior) -----
  RewriteRule ^dise(ñ|%C3%B1)o-web-zaragoza/?$ /diseno-web-zaragoza [L,R=301,NE]
  RewriteRule ^servicios/mantenimiento-web/?$ /mantenimiento-web [L,R=301]
  RewriteRule ^proyecto/ /proyectos [L,R=301]
  RewriteRule ^privacy-policy/?$ /politica-privacidad [L,R=301]
  RewriteRule ^(carta-recomendacion|dashboard)/?$ / [L,R=301]
  RewriteRule ^cv\.pdf$ / [L,R=301]
  # Versión anterior en Next.js (portfolio): URLs que Google aún tiene indexadas.
  RewriteRule ^privacidad/?$ /politica-privacidad [L,R=301]
  RewriteRule ^(cv|auth)(/.*)?$ / [L,R=301]
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L,R=301]

  # --- URLs limpias -----------------------------------------------------
  # /index.html y /index → /
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [L,R=301]

  # /contacto.html → /contacto (solo peticiones directas, no reescrituras internas)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301,NE]

  # /contacto/ → /contacto
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteRule ^ /%1 [L,R=301,NE]

  # /contacto → contacto.html (reescritura interna, la URL no cambia)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# --- Tipos MIME --------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
  AddCharset utf-8 .html .css .js .txt .xml .webmanifest
</IfModule>

# --- Compresión (LiteSpeed comprime con Brotli por su cuenta) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# --- Caché ---------------------------------------------------------------
<IfModule mod_headers.c>
  # HTML: siempre revalidar para que los cambios se vean al momento.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Los assets con hash (/_astro/*) tienen su propia regla en _astro/.htaccess.
  # Iconos e imágenes Open Graph: 1 semana.
  <FilesMatch "\.(png|ico|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # --- Cabeceras de seguridad ---------------------------------------------
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
